[% var j = ids; %]
"""GENERATED by xaikg-mde T6 from the Explainability model '[%=c.name%]'. DO NOT EDIT.

One endpoint per (ExplanationType, Audience) pair declared in the model (R5/R6: audience tailoring
is realised by generation, not by runtime branching), plus /trace for audiences that require full
provenance (R8) and /contract (the explanation contract as data).
"""
from __future__ import annotations

from fastapi import APIRouter, HTTPException

from xaikg.explain.runtime import DecisionInput, ExplanationRuntime

router = APIRouter()
runtime = ExplanationRuntime.from_generated()


@router.get("/contract", summary="The explanation contract (audiences, types, coverage) as generated from the model")
def contract() -> dict:
    return runtime.contract_summary()


@router.get("/health")
def health() -> dict:
    return runtime.health()

[% for (t in c.explanationTypes) { for (a in t.audiences) { %]

@router.post("/explain/[%=j.snake(t.name)%]/[%=a.role%]",
             summary=[%=j.py(t.name + " for " + a.role + " (" + t.category.name + ", " + a.technicalLevel.name + " technical level)")%])
def explain_[%=j.snake(t.name)%]_[%=a.role%](decision: DecisionInput) -> dict:
    """[%=t.description%]"""
    return runtime.explain([%=j.py(t.name)%], [%=j.py(a.role)%], decision)
[% } } %]
[% if (c.audiences.exists(a | a.requiresFullProvenance)) { %]


@router.get("/trace/{explanation_id}",
            summary="Full provenance chain of an explanation (audiences: [%=c.audiences.select(a | a.requiresFullProvenance).collect(a | a.role).concat(", ")%])")
def trace(explanation_id: str) -> dict:
    result = runtime.trace(explanation_id)
    if result is None:
        raise HTTPException(status_code=404, detail="unknown explanation id")
    return result
[% } %]
