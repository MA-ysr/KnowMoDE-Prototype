 ,{s: 'diabetes', t: 'adverse outcomes', fact: 'f_a8358e273c7400a2', doc: 'pubmed/36732827.txt', start: 217, end: 327, evidence: 'Diabetes is an independent risk factor of frailty, which increases adverse outcomes in patients with diabetes.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:50:17+00:00'}
