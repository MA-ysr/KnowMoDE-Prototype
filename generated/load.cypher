 ,{s: 'triglyceride-glucose index', t: 'hospital readmission within 30 days', fact: 'f_72c3c4e636da96da', doc: 'pubmed/37679763.txt', start: 1607, end: 1725, evidence: 'Additionally, the incidence of adverse events (readmission and mortality) in patients with HF was associated with TyG.', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:41:35+00:00'}
