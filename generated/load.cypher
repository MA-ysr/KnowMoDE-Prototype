 ,{s: 'postoperative complications', t: '90-day readmission', fact: 'f_b90d1da2d753ec5d', doc: 'pubmed/42224727.txt', start: 2068, end: 2355, evidence: 'Among 385 patients with follow-up data, a 90-day readmission was independently associated with postoperative complications (OR 5.62, 95% CI 3.12-10.13), preexisting coronary artery disease (OR 4.30, 95% CI 1.46-12.69), and postoperative cognitive dysfunction (OR 3.33, 95% CI 1.76-6.44).', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:49:08+00:00'}
