 ,{s: 'glyburide and metformin', t: 'severe renal impairment', fact: 'f_937a42a1ce5ac53f', doc: 'openfda/glyburide-and-metformin.txt', start: 33437, end: 33744, evidence: 'Glyburide and metformin hydrochloride is contraindicated in severe renal impairment, patients with an estimated glomerular filtration rate (eGFR) below 30 mL/min/1.73 m 2 [see Dosage and Administration ( 2.3 ), Contraindications ( 4 ), Warnings and Precautions ( 5.1 ), and Clinical Pharmacology ( 12.3 ) ].', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:09:57+00:00'}
