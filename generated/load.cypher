 ,{s: 'zituvimet', t: 'cimetidine', fact: 'f_ecaf8b13485d2b31', doc: 'openfda/metformin.txt', start: 31507, end: 31570, evidence: 'Examples: Ranolazine, vandetanib, dolutegravir, and cimetidine.', confidence: 0.9, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:13:04+00:00'}
 ,{s: 'zituvimet', t: 'alcohol', fact: 'f_48a8fc7f445f716e', doc: 'openfda/metformin.txt', start: 31674, end: 31751, evidence: 'Intervention: Warn patients against alcohol intake while receiving ZITUVIMET.', confidence: 0.9, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:13:04+00:00'}
 ,{s: 'miglitol', t: 'glyburide', fact: 'f_76c1ade09550e3d7', doc: 'openfda/miglitol.txt', start: 5561, end: 5646, evidence: 'Several studies investigated the possible interaction between miglitol and glyburide.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:14:33+00:00'}
 ,{s: 'miglitol', t: 'metformin', fact: 'f_cc9b4aebc44e5a90', doc: 'openfda/miglitol.txt', start: 7052, end: 7210, evidence: 'The effect of miglitol (100 mg 3 times daily for 7 days) on the pharmacokinetics of a single 1000 mg dose of metformin was investigated in healthy volunteers.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:14:33+00:00'}
 ,{s: 'miglitol', t: 'digoxin', fact: 'f_08236bcf070e79a3', doc: 'openfda/miglitol.txt', start: 7394, end: 7601, evidence: 'In a study with healthy volunteers, co-administration of either 50 mg or 100 mg miglitol 3 times daily together with digoxin reduced the average plasma concentrations of digoxin by 19% and 28%, respectively.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:14:33+00:00'}
 ,{s: 'miglitol', t: 'ranitidine', fact: 'f_7642ef97c0a12904', doc: 'openfda/miglitol.txt', start: 7776, end: 7944, evidence: 'Other healthy volunteer studies have demonstrated that miglitol may significantly reduce the bioavailability of ranitidine and propranolol by 60% and 40%, respectively.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:14:33+00:00'}
 ,{s: 'miglitol', t: 'propranolol', fact: 'f_6d4d4221ded211bf', doc: 'openfda/miglitol.txt', start: 7776, end: 7944, evidence: 'Other healthy volunteer studies have demonstrated that miglitol may significantly reduce the bioavailability of ranitidine and propranolol by 60% and 40%, respectively.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:14:33+00:00'}
 ,{s: 'miglitol', t: 'warfarin', fact: 'f_1173a7ad8a8d723c', doc: 'openfda/miglitol.txt', start: 7945, end: 8057, evidence: 'No effect of miglitol was observed on the pharmacokinetics or pharmacodynamics of either warfarin or nifedipine.', confidence: 0.9, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:14:33+00:00'}
