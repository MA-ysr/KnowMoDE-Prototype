 ,{s: 'initiation of glucose-lowering medication', t: 'mortality', fact: 'f_e1975dc5bb1aabac', doc: 'pubmed/36807850.txt', start: 1127, end: 1226, evidence: 'The IPW-HRs for mortality were 0.80 [95% CI (0.78-0.83)] for 1 NHA, 0.70 [95% CI (0.66-0.75)] for 2', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:50:35+00:00'}
