 ,{s: 'ethnic minority status', t: 'hospital readmission within 30 days', fact: 'f_10229688b671fea1', doc: 'pubmed/31365631.txt', start: 854, end: 1203, evidence: 'In addition, socioeconomic factors (such as ethnic minority status, use of public health insurance and underinsurance), psychosocial, economic, and behavioral factors (including financial constraint, stretching a limited insulin supply, and homelessness) have been all reported to be associated with readmission among diabetic ketoacidosis patients.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:35:49+00:00'}
