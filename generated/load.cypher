 ,{s: 'myocardial infarction', t: 'heart failure readmission', fact: 'f_82eea1b21a3f3816', doc: 'pubmed/27611905.txt', start: 1444, end: 1673, evidence: 'In a multivariate log binomial regression model, myocardial infarction, chronic kidney disease, diabetes mellitus, male sex, and year of admission were independently associated with higher HF readmission rates (P < 0.01 for all).', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:30:31+00:00'}
