 ,{s: 'frailty', t: 'mortality', fact: 'f_8a7f7c0bf4bf1b42', doc: 'pubmed/42214810.txt', start: 1769, end: 1913, evidence: 'In HF, the Fried scale was predominant; frailty was associated with increased mortality (adjusted RR 2.04), readmissions and functional decline.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:49:01+00:00'}
