UNWIND [
  {s: 'high blood pressure', t: 'hospital readmission within 30 days', fact: 'f_0634a5821f845f0c', doc: 'pubmed/18385990.txt', start: 1302, end: 1753, evidence: 'In the multivariate logistic analysis, the variables predicting readmission were acenocoumarol [odds ratio (OR) 12.2, 95% confidence interval (CI) 3.8-38.3, P < 0.0001], a record of diabetes mellitus (OR 2.6, 95% CI 1.3-5.5, P < 0.01), the number of drugs taken at the moment of ADR (OR 1.2, 95% CI 1.1-1.4, P < 0.001) and high blood pressure (OR 0.3, 95% CI 0.2-0.6, P < 0.001) even though the latter was a negative predictor, preventing readmission.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:13:35+00:00'}
 ,{s: 'insulin continuation after discharge', t: 'hospital readmission within 30 days', fact: 'f_96415426ccc4c1e1', doc: 'pubmed/22440990.txt', start: 1396, end: 1679, evidence: 'Continued insulin therapy was associated with an expected greater reduction in glycated hemoglobin A1c (P<.001); similar hypoglycemia rates; lower risks of all-cause hospital readmission, diabetes-related readmission, and all-cause emergency department visits; and improved survival.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:26:03+00:00'}
 ,{s: 'insulin continuation after discharge', t: 'diabetes-related readmission', fact: 'f_b12955105d32947c', doc: 'pubmed/22440990.txt', start: 1396, end: 1679, evidence: 'Continued insulin therapy was associated with an expected greater reduction in glycated hemoglobin A1c (P<.001); similar hypoglycemia rates; lower risks of all-cause hospital readmission, diabetes-related readmission, and all-cause emergency department visits; and improved survival.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:26:03+00:00'}
 ,{s: 'insulin continuation after discharge', t: 'hospital readmission within 30 days', fact: 'f_1ece46ead5626d6d', doc: 'pubmed/23299035.txt', start: 1507, end: 1797, evidence: 'In patients with a baseline HbA1c of ≥ 9.0%, insulin continuation was significantly associated with lower risks of all-cause (adjusted hazard ratio, 0.58; 95% CI, 0.36-0.93; P = 0.0276) and diabetes-related (adjusted hazard ratio, 0.46; 95% CI, 0.23-0.87; P = 0.0204) hospital readmissions.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:26:19+00:00'}
 ,{s: 'inpatient diabetes specialist care', t: 'hospital admission', fact: 'f_4d84284bd8fb4de9', doc: 'pubmed/25865087.txt', start: 1916, end: 2102, evidence: 'The cost and long-term risks of hospitalization among patients with Type 1 diabetes and recurrent admissions can be reduced by a combined specialist diabetes/mental health team approach.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:28:18+00:00'}
 ,{s: 'outpatient surgery', t: 'hospital readmission within 30 days', fact: 'f_043dd58833c744e6', doc: 'pubmed/29436275.txt', start: 1662, end: 1818, evidence: 'Patients undergoing outpatient surgery were less likely to be readmitted (OR, 0.49; 95% CI, 0.35-0.69) or undergo reoperation (OR, 0.44; 95% CI, 0.27-0.73).', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:32:32+00:00'}
 ,{s: 'outpatient surgery', t: 'reoperation within 30 days', fact: 'f_9df6de3e3d81f362', doc: 'pubmed/29436275.txt', start: 1662, end: 1818, evidence: 'Patients undergoing outpatient surgery were less likely to be readmitted (OR, 0.49; 95% CI, 0.35-0.69) or undergo reoperation (OR, 0.44; 95% CI, 0.27-0.73).', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:32:32+00:00'}
 ,{s: 'diabetes education', t: 'hospital readmission within 30 days', fact: 'f_de44f24894214327', doc: 'pubmed/29931547.txt', start: 609, end: 782, evidence: 'These strategies include inpatient diabetes survival skills education and medication reconciliation prior to discharge to send the patient home with the "right" medications.', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:33:22+00:00'}
 ,{s: 'medication reconciliation', t: 'hospital readmission within 30 days', fact: 'f_1a2dea1bb773a121', doc: 'pubmed/29931547.txt', start: 609, end: 782, evidence: 'These strategies include inpatient diabetes survival skills education and medication reconciliation prior to discharge to send the patient home with the "right" medications.', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:33:22+00:00'}
 ,{s: 'transitional care program', t: 'hospital readmission within 30 days', fact: 'f_58fcaa5fa1473826', doc: 'pubmed/29931547.txt', start: 1251, end: 1424, evidence: 'A standardized transitional care program that focuses on providing interventions while reducing barriers to implementation can contribute to a decreased risk of readmission.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:33:22+00:00'}
 ,{s: 'discharge home', t: 'hospital readmission within 30 days', fact: 'f_fd32ac00e2ab57ce', doc: 'pubmed/29949004.txt', start: 2084, end: 2170, evidence: 'Only discharge home was associated with a lower readmission rate (RR 0.89, 0.85-0.93).', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:33:25+00:00'}
 ,{s: 'transitional care program', t: 'hospital readmission within 30 days', fact: 'f_0145c17e9788dccd', doc: 'pubmed/29992890.txt', start: 1854, end: 2000, evidence: 'A team based, patient-centered approach can help improve patient outcomes by reducing medication errors, delay of care, and hospital readmissions.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:33:43+00:00'}
 ,{s: 'transitional care program', t: 'hospital readmission within 30 days', fact: 'f_cd35b64e85806961', doc: 'pubmed/31145236.txt', start: 1421, end: 1527, evidence: 'Integrated case management services were statistically significant in reducing readmission for the sample.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:35:25+00:00'}
 ,{s: 'inpatient diabetes specialist care', t: 'hospital readmission within 30 days', fact: 'f_8b11daba88722824', doc: 'pubmed/31652103.txt', start: 1484, end: 1587, evidence: 'Endocrine consultation was associated with reduced 30-day readmission (OR, 0.51; 95% CI, 0.28 to 0.92).', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:36:23+00:00'}
 ,{s: 'medication therapy management', t: 'hospital readmission within 30 days', fact: 'f_032d20bbb3c6a686', doc: 'pubmed/32173107.txt', start: 2063, end: 2203, evidence: 'Compared with no MTM, discharges with full MTM had the lowest time-varying risk for readmission within 30 days (HR, 0.26; 95% CI, 0.15-0.45)', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:38:12+00:00'}
 ,{s: 'medication therapy management', t: 'hospital readmission within 30 days', fact: 'f_e997a84d144d7af1', doc: 'pubmed/32173107.txt', start: 2205, end: 2295, evidence: 'discharges with partial MTM also had lower readmission risk (HR, 0.50; 95% CI, 0.37-0.68).', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:38:12+00:00'}
 ,{s: 'increased body mass index', t: 'hospital readmission within 30 days', fact: 'f_8ab875a6249b7974', doc: 'pubmed/32663565.txt', start: 1738, end: 1935, evidence: 'Multiple logistic regression analysis found increased BMI to be associated with lower odds of an unplanned readmission (odds ratio [OR], 0.883; 95% confidence interval [CI], 0.798-0.963; P = .0035)', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:38:58+00:00'}
 ,{s: 'remote patient monitoring', t: 'hospital readmission or death within 30 days', fact: 'f_70218fb4cac9ae68', doc: 'pubmed/33506388.txt', start: 1446, end: 1667, evidence: 'Using a modified intention-to-treat analysis, the risk of readmission or death within 30 days among patients at high readmission risk was 23.7% (137/578) in the control group and 18.2% (87/477) in the telemonitoring group', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:40:21+00:00'}
 ,{s: 'transitional care program', t: 'hospital readmission within 30 days', fact: 'f_71f91b67ce8d9066', doc: 'pubmed/34273282.txt', start: 1175, end: 1354, evidence: 'In patients with low CCI, attendance at BRIDGE was inversely associated with hospital readmission (adjusted hazard ratio = 0.82, 95% confidence interval [CI]: 0.69, 0.97, P = .02)', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:42:07+00:00'}
 ,{s: 'transitional care program', t: 'composite endpoint of readmission, ed visit, or mortality', fact: 'f_934398e621eec1cd', doc: 'pubmed/34273282.txt', start: 1175, end: 1442, evidence: 'In patients with low CCI, attendance at BRIDGE was inversely associated with hospital readmission (adjusted hazard ratio = 0.82, 95% confidence interval [CI]: 0.69, 0.97, P = .02) and the composite endpoint (adjusted hazard ratio = 0.84, 95% CI: 0.72, 0.98, P = .02).', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:42:07+00:00'}
 ,{s: 'diabetes education', t: 'acute care re-utilization', fact: 'f_9c5c4f41308181b0', doc: 'pubmed/34480653.txt', start: 1137, end: 1444, evidence: 'In retrospective studies and mostly small randomized controlled trials (RCTs), interventions such as inpatient diabetes education, inpatient diabetes management services, transition of care support, and outpatient follow-up are generally associated with a reduction in the risk of acute care re-utilization.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:42:33+00:00'}
