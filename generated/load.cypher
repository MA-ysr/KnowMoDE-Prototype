 ,{s: 'pioglitazone', t: 'heart failure', fact: 'f_c05f3b61ec2052ff', doc: 'openfda/pioglitazone.txt', start: 21056, end: 21317, evidence: 'A summary of the incidence of adverse events related to congestive heart failure is provided in Table 6 for the 16- to 24-week add-on to sulfonylurea trials, for the 16- to 24-week add-on to insulin trials, and for the 16- to 24-week add-on to metformin trials.', confidence: 0.9, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:15:54+00:00'}
 ,{s: 'pioglitazone', t: 'weight gain', fact: 'f_2c87b3490fdc0317', doc: 'openfda/pioglitazone.txt', start: 26690, end: 26808, evidence: 'Dose-related weight gain occurs when pioglitazone is used alone or in combination with other antidiabetic medications.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:15:54+00:00'}
 ,{s: 'pioglitazone', t: 'edema', fact: 'f_d42aed502bb04c76', doc: 'openfda/pioglitazone.txt', start: 28283, end: 28370, evidence: 'Edema induced from taking pioglitazone is reversible when pioglitazone is discontinued.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:15:54+00:00'}
 ,{s: 'pioglitazone', t: 'hypoglycemia', fact: 'f_a6284baf35265262', doc: 'openfda/pioglitazone.txt', start: 30661, end: 30857, evidence: 'In the pioglitazone clinical trials, adverse events of hypoglycemia were reported based on clinical judgment of the investigators and did not require confirmation with fingerstick glucose testing.', confidence: 0.9, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:15:54+00:00'}
 ,{s: 'pioglitazone', t: 'hypoglycemia', fact: 'f_3badaffb0615aa6b', doc: 'openfda/pioglitazone.txt', start: 31588, end: 31900, evidence: '14 patients reported severe hypoglycemia (defined as causing considerable interference with patient’s usual activities) that did not require hospitalization. These patients were receiving pioglitazone 45 mg in combination with sulfonylurea (n=2) or pioglitazone 30 mg or 45 mg in combination with insulin (n=12).', confidence: 0.85, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:15:54+00:00'}
 ,{s: 'pioglitazone', t: 'urinary bladder tumors', fact: 'f_18268ddc3d96e23d', doc: 'openfda/pioglitazone.txt', start: 31924, end: 32018, evidence: 'Tumors were observed in the urinary bladder of male rats in the two-year carcinogenicity study', confidence: 0.9, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:15:54+00:00'}
 ,{s: 'pioglitazone', t: 'bladder cancer', fact: 'f_04bd86c34638a1e5', doc: 'openfda/pioglitazone.txt', start: 32058, end: 32248, evidence: 'During the three year PROactive clinical trial, 14 patients out of 2605 (0.54%) randomized to pioglitazone and 5 out of 2633 (0.19%) randomized to placebo were diagnosed with bladder cancer.', confidence: 0.9, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:15:54+00:00'}
