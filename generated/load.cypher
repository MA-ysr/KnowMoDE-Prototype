 ,{s: 'higher cha2ds2vasc score', t: 'hospital readmission within 30 days', fact: 'f_44c8e9c5fe3d2df1', doc: 'pubmed/32148075.txt', start: 1431, end: 1604, evidence: 'Patients with late readmissions were more likely to have diabetes (32.7% vs. 17.7%, p=.022) and higher CHA2DS2VASc scores (3.63 vs. 2.98, p=0.026) than those not readmitted.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:37:58+00:00'}
 ,{s: 'greater than 3 elixhauser comorbidities', t: 'hospital readmission within 30 days', fact: 'f_70798cd45ee8813e', doc: 'pubmed/32521438.txt', start: 852, end: 1379, evidence: 'In the multivariable analysis, intracranial hemorrhage (odds ratio, 1.56; 95% confidence interval, 1.12-2.18), psychosis (1.26 95%, 1.05-1.50), diabetes mellitus (1.12, 95%, 1.00-1.25), chronic kidney disease (1.50, 95%, 1.31-1.72), chronic liver disease (1.51; 95%, 1.24-1.84), >3 Elixhauser comorbidities (1.18; 95%, 1.06-1.31), length of stay >4 days during index hospitalization (1.41; 95%, 1.28-1.56) and discharge to skilled nursing facility (SNF) (1.14; 95%, 1.01-1.28) were independent predictors of 30-day readmission.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:38:46+00:00'}
 ,{s: 'length of hospital stay', t: 'hospital readmission within 30 days', fact: 'f_edf44abad07f7a24', doc: 'pubmed/32521438.txt', start: 852, end: 1379, evidence: 'In the multivariable analysis, intracranial hemorrhage (odds ratio, 1.56; 95% confidence interval, 1.12-2.18), psychosis (1.26 95%, 1.05-1.50), diabetes mellitus (1.12, 95%, 1.00-1.25), chronic kidney disease (1.50, 95%, 1.31-1.72), chronic liver disease (1.51; 95%, 1.24-1.84), >3 Elixhauser comorbidities (1.18; 95%, 1.06-1.31), length of stay >4 days during index hospitalization (1.41; 95%, 1.28-1.56) and discharge to skilled nursing facility (SNF) (1.14; 95%, 1.01-1.28) were independent predictors of 30-day readmission.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:38:46+00:00'}
 ,{s: 'discharge to a skilled nursing facility', t: 'hospital readmission within 30 days', fact: 'f_9894eddf59d98b91', doc: 'pubmed/32521438.txt', start: 852, end: 1379, evidence: 'In the multivariable analysis, intracranial hemorrhage (odds ratio, 1.56; 95% confidence interval, 1.12-2.18), psychosis (1.26 95%, 1.05-1.50), diabetes mellitus (1.12, 95%, 1.00-1.25), chronic kidney disease (1.50, 95%, 1.31-1.72), chronic liver disease (1.51; 95%, 1.24-1.84), >3 Elixhauser comorbidities (1.18; 95%, 1.06-1.31), length of stay >4 days during index hospitalization (1.41; 95%, 1.28-1.56) and discharge to skilled nursing facility (SNF) (1.14; 95%, 1.01-1.28) were independent predictors of 30-day readmission.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:38:46+00:00'}
 ,{s: 'wound classification >= 3', t: 'unplanned reoperation', fact: 'f_5a313c5467a96c19', doc: 'pubmed/32663565.txt', start: 1936, end: 2082, evidence: 'and found wound classification ≥ 3 to be associated with increased odds of an unplanned reoperation (OR, 16.531; 95% CI, 1.300-167.960; P = .0144)', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:38:58+00:00'}
 ,{s: 'increased charlson comorbidity index', t: 'recurrent clostridioides difficile infection', fact: 'f_aa5a9c1b793c16bb', doc: 'pubmed/32675703.txt', start: 1326, end: 1522, evidence: 'Independent risk factors of R-CDI included increased Charlson Comorbidity Index (hazard ratio [HR] 1.30; 95% confidence interval [CI]: 1.09-1.55) and use of lactulose (HR 2.58; 95% CI: 1.09-6.09).', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:39:09+00:00'}
 ,{s: 'increased charlson comorbidity index', t: 'hospital readmission within 30 days', fact: 'f_c65f19fe79fad3de', doc: 'pubmed/32675703.txt', start: 1523, end: 1735, evidence: 'The 30-day readmission rate was 37%, and readmission was associated with increased Charlson Comorbidity Index (HR 1.12; 95% CI: 1.03-1.23) and Model for End-Stage Liver Disease score (HR 1.04; 95% CI: 1.01-1.07).', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:39:09+00:00'}
 ,{s: 'model for end-stage liver disease score', t: 'hospital readmission within 30 days', fact: 'f_0b6461c8ee68fa6b', doc: 'pubmed/32675703.txt', start: 1523, end: 1735, evidence: 'The 30-day readmission rate was 37%, and readmission was associated with increased Charlson Comorbidity Index (HR 1.12; 95% CI: 1.03-1.23) and Model for End-Stage Liver Disease score (HR 1.04; 95% CI: 1.01-1.07).', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:39:09+00:00'}
 ,{s: 'lack of transitional care', t: 'high readmission rates', fact: 'f_3a684e1b512c256e', doc: 'pubmed/32744373.txt', start: 1949, end: 2119, evidence: 'Lack hospital to home transitional care for hospitalized older people with hypertension and diabetes can result in high readmission rates and emergency department visits.', confidence: 0.88, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:39:12+00:00'}
 ,{s: 'lack of hospital-to-home transitional care', t: 'hospital readmission rate', fact: 'f_bb18ea31fc091a66', doc: 'pubmed/32744373.txt', start: 3295, end: 3344, evidence: '对于患有高血压和糖尿病的住院老年人，缺乏医院到家庭的过渡护理可能会导致较高的再入院率和急诊就诊率。', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:39:12+00:00'}
 ,{s: 'diabetic foot infection', t: 'hospital readmission within 30 days', fact: 'f_aa6fe2a73718a469', doc: 'pubmed/33097196.txt', start: 1284, end: 1607, evidence: 'In multivariate analysis diabetic foot infection (OR 3.24; 95%CI 1.38-8.31; p = 0.01), the presence of chronic kidney disease, decubitus ulcer or heart failure (OR 2.65; 95% CI 1.51-4.70; p < 0.001), and narcotics prescribed at discharge (OR 1.93; 95% CI 1.06-3.60; p = 0.049) were independent risk factors for readmission.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:39:28+00:00'}
 ,{s: 'narcotics prescribed at discharge', t: 'hospital readmission within 30 days', fact: 'f_0974ba58b7d0d13e', doc: 'pubmed/33097196.txt', start: 1284, end: 1607, evidence: 'In multivariate analysis diabetic foot infection (OR 3.24; 95%CI 1.38-8.31; p = 0.01), the presence of chronic kidney disease, decubitus ulcer or heart failure (OR 2.65; 95% CI 1.51-4.70; p < 0.001), and narcotics prescribed at discharge (OR 1.93; 95% CI 1.06-3.60; p = 0.049) were independent risk factors for readmission.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:39:28+00:00'}
 ,{s: 'polypharmacy', t: 'heart failure hospitalisation', fact: 'f_7073ace713f1d8fa', doc: 'pubmed/33257457.txt', start: 1472, end: 1693, evidence: 'In multivariable regression models, three experimental groups with a high medication burden were all associated with a reduction in all-cause death, but increased risks of HF hospitalisation and all-cause hospitalisation.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:39:50+00:00'}
 ,{s: 'polypharmacy', t: 'all-cause hospitalisation', fact: 'f_d7f8c5fedd9e58f1', doc: 'pubmed/33257457.txt', start: 1472, end: 1693, evidence: 'In multivariable regression models, three experimental groups with a high medication burden were all associated with a reduction in all-cause death, but increased risks of HF hospitalisation and all-cause hospitalisation.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:39:50+00:00'}
 ,{s: 'polypharmacy', t: 'hospital readmission within 30 days', fact: 'f_80a5203160677a32', doc: 'pubmed/33257457.txt', start: 2196, end: 2294, evidence: 'The high medication burden might increase the risk of hospital readmission, but not the mortality.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:39:50+00:00'}
