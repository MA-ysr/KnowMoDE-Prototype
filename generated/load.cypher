 ,{s: 'hba1c 48-64 mmol/mol', t: 'hospital readmission within 30 days', fact: 'f_b31ca779d2b535dd', doc: 'pubmed/26676831.txt', start: 2060, end: 2320, evidence: 'Re-admission to hospital within 30 days for a complication of surgery occurred in 4.4 % of women with HBA1c <42 mmol/mol, 4.5 % of women with HBA1c measured at 42-47 mmol/mol, 30.8 % of those with HBA1c 48-64 mmol/mol and 25 % of women with HBA1c >64 mmol/mol.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:29:24+00:00'}
 ,{s: 'hba1c >64 mmol/mol', t: 'hospital readmission within 30 days', fact: 'f_9e77a57543dd9c51', doc: 'pubmed/26676831.txt', start: 2060, end: 2320, evidence: 'Re-admission to hospital within 30 days for a complication of surgery occurred in 4.4 % of women with HBA1c <42 mmol/mol, 4.5 % of women with HBA1c measured at 42-47 mmol/mol, 30.8 % of those with HBA1c 48-64 mmol/mol and 25 % of women with HBA1c >64 mmol/mol.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:29:24+00:00'}
 ,{s: 'low discharge serum osmolality', t: 'mortality', fact: 'f_29a64851ac7ea64e', doc: 'pubmed/26851146.txt', start: 1281, end: 1460, evidence: 'Low discharge osmolality was associated with higher ACM (low 29.3%; normal 23.6%; high 25.2%; p = 0.04) and the composite endpoint (low 45.6%; normal 39.3%; high 41.8%; p = 0.04).', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:29:36+00:00'}
 ,{s: 'low discharge serum osmolality', t: 'composite cardiovascular mortality or heart failure hospitalization', fact: 'f_1be887e850e6c8e5', doc: 'pubmed/26851146.txt', start: 1281, end: 1460, evidence: 'Low discharge osmolality was associated with higher ACM (low 29.3%; normal 23.6%; high 25.2%; p = 0.04) and the composite endpoint (low 45.6%; normal 39.3%; high 41.8%; p = 0.04).', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:29:36+00:00'}
 ,{s: 'discharge to a skilled nursing facility', t: 'postdischarge adverse events', fact: 'f_76b8ab2a1bc30439', doc: 'pubmed/26860962.txt', start: 2184, end: 2273, evidence: 'SNF or IRF discharge increases the risk of postdischarge adverse events compared to home.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:29:43+00:00'}
 ,{s: 'dialysis dependence', t: 'hospital readmission within 30 days', fact: 'f_d8c39621431d9d66', doc: 'pubmed/27038838.txt', start: 1135, end: 1313, evidence: 'the top five predictors of readmission were American Society of Anesthesiologists class, preoperative open wound, inpatient operation, dialysis dependence, and diabetes mellitus.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:29:58+00:00'}
