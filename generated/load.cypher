 ,{s: 'diabetes', t: 'readmission with dehydration', fact: 'f_9b082ccb9fb328b4', doc: 'pubmed/33539646.txt', start: 1432, end: 1725, evidence: 'Eight variables were found to be significantly associated with dehydration-related readmission: age ≥65 years, body mass index ≥30 kg/m2 , diabetes mellitus, hypertension, renal comorbidity, regular diuretic use, ileal pouch-anal anastomosis procedure and length of stay after index admission.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:40:34+00:00'}
