 ,{s: 'poor glycemic control', t: 'recurrent diabetic ketoacidosis', fact: 'f_2627d93ca4f39ef6', doc: 'pubmed/31365631.txt', start: 604, end: 853, evidence: 'Younger age at diabetic ketoacidosis onset, poor baseline glycemic control and elevated HbA1C, patient comorbidities, depression, alcohol or substance abuse, particularly active cocaine use, have been associated with recurrent diabetic ketoacidosis.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:35:49+00:00'}
