 ,{s: 'miglitol', t: 'digoxin', fact: 'f_78c3bce758bfa717', doc: 'openfda/miglitol.txt', start: 16489, end: 16696, evidence: 'In a study with healthy volunteers, co-administration of either 50 mg or 100 mg miglitol 3 times daily together with digoxin reduced the average plasma concentrations of digoxin by 19% and 28%, respectively.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:14:33+00:00'}
