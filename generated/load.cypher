] AS e
MERGE (n:RiskFactor {_key: e.key})
  ON CREATE SET n.name = e.idValue, n += e.props
  ON MATCH SET n += e.props
SET n._modifiable = e.modifiable, n._plain_label = e.plainLabel
WITH n, e
MATCH (d:SourceDocument {id: e.doc})
MERGE (n)-[x:EXTRACTED_FROM {_prov_char_start: e.start, _prov_char_end: e.end}]->(d)
  SET x._prov_mention = e.mention, x._prov_confidence = e.confidence, x._prov_prompt_id = e.prompt, x._prov_run_id = e.run, x._prov_extraction_task = e.task, x._prov_normalized_from = e.normalizedFrom
WITH n, e
MATCH (r:ExtractionRun {runId: e.run})
MERGE (n)-[:PRODUCED_BY]->(r);

// ---- Relationships (one per accepted fact, provenance as _prov_* properties) ----
UNWIND [
  {s: 'use early identification of patients in need of education, implementation of a clinical pathway, and clear instructions about medications and follow-up appointments to ensure an effective diabetes discharge', t: 'diabetes', fact: 'f_aa4d4270e93a395c', doc: 'pubmed/19364697.txt', start: 1372, end: 1632, evidence: 'Strategies that can be used to ensure an effective diabetes discharge are early identification of patients in need of education, implementation of a clinical pathway, and clear instructions about medications and follow-up appointments at the time of discharge.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:55:09+00:00'}
 ,{s: 'give insulin as a continuous intravenous infusion in critically ill patients', t: 'critically ill state', fact: 'f_58a2a218e94575b0', doc: 'pubmed/20078323.txt', start: 1516, end: 1851, evidence: 'In critically ill patients insulin is given as a continuous intravenous (IV) infusion and in non-critically ill inpatients hyperglycemia is best managed using scheduled subcutaneous (SC) basal-bolus insulin regimens supplemented with correction doses as needed and adjusted daily with the guidance of frequent blood glucose monitoring.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:55:16+00:00'}
 ,{s: 'manage hyperglycemia in non-critically ill inpatients using scheduled subcutaneous basal-bolus insulin regimens supplemented with correction doses', t: 'hyperglycemia', fact: 'f_2307e0e36f4885ce', doc: 'pubmed/20078323.txt', start: 1516, end: 1851, evidence: 'In critically ill patients insulin is given as a continuous intravenous (IV) infusion and in non-critically ill inpatients hyperglycemia is best managed using scheduled subcutaneous (SC) basal-bolus insulin regimens supplemented with correction doses as needed and adjusted daily with the guidance of frequent blood glucose monitoring.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:55:16+00:00'}
 ,{s: 'use insulin for management of hyperglycemia for the majority of hospitalized patients', t: 'hyperglycemia', fact: 'f_f4bdbcd593b1bc19', doc: 'pubmed/20078323.txt', start: 2847, end: 2959, evidence: 'Insulin is the most appropriate agent for management of hyperglycemia for the majority of hospitalized patients.', confidence: 0.95, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:55:16+00:00'}
 ,{s: 'use s.c. basal insulin analogs with prandial or correction doses after the immediate post-operative period and in non-critically ill patients', t: 'non-critically ill state', fact: 'f_3f733a4a1797643d', doc: 'pubmed/20078323.txt', start: 3050, end: 3224, evidence: 's.c. basal insulin analogs with prandial or correction doses should be used after the immediate post-operative period, and also should be used in non-critically ill patients.', confidence: 0.85, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:55:16+00:00'}
 ,{s: 'implement a standardized subcutaneous insulin order set promoting scheduled basal and nutritional insulin therapy for inpatient management of diabetes', t: 'diabetes', fact: 'f_1a915bc6507c5343', doc: 'pubmed/22223765.txt', start: 1459, end: 1639, evidence: 'Implementing a standardized sc insulin order set promoting the use of scheduled basal and nutritional insulin therapy is a key intervention in the inpatient management of diabetes.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:55:28+00:00'}
 ,{s: 'use custom therapeutic footwear in high-risk diabetic patients', t: 'diabetes', fact: 'f_91d8c83373bc38c1', doc: 'pubmed/26804367.txt', start: 1580, end: 1745, evidence: 'We recommend using custom therapeutic footwear in high-risk diabetic patients, including those with significant neuropathy, foot deformities, or previous amputation.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:55:48+00:00'}
 ,{s: 'off-load plantar diabetic foot ulcers with a total contact cast or irremovable fixed ankle walking boot', t: 'diabetic foot ulcer', fact: 'f_2969f1ccc2430829', doc: 'pubmed/26804367.txt', start: 1746, end: 1889, evidence: 'In patients with plantar diabetic foot ulcer (DFU), we recommend off-loading with a total contact cast or irremovable fixed ankle walking boot.', confidence: 0.95, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:55:48+00:00'}
 ,{s: 'perform revascularization by surgical bypass or endovascular therapy in patients with dfu and peripheral arterial disease', t: 'diabetic foot ulcer', fact: 'f_6a7d626a4d1e7311', doc: 'pubmed/26804367.txt', start: 2314, end: 2454, evidence: 'In patients with DFU who have peripheral arterial disease, we recommend revascularization by either surgical bypass or endovascular therapy.', confidence: 0.92, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:55:48+00:00'}
 ,{s: 'perform revascularization by surgical bypass or endovascular therapy in patients with dfu and peripheral arterial disease', t: 'peripheral arterial disease', fact: 'f_e1248ccd062757eb', doc: 'pubmed/26804367.txt', start: 2314, end: 2454, evidence: 'In patients with DFU who have peripheral arterial disease, we recommend revascularization by either surgical bypass or endovascular therapy.', confidence: 0.95, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:55:48+00:00'}
 ,{s: 'blood glucose values should be less than 180 mg/dl 18 to 24 hours after anesthesia end time after cardiac surgery', t: 'cardiac surgery', fact: 'f_4fa9469845afcb3e', doc: 'pubmed/27164170.txt', start: 203, end: 384, evidence: 'Recent changes in the Surgical Care Improvement Project guideline require blood glucose values be less than 180 mg/dL 18 to 24 hours after anesthesia end time after cardiac surgery.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:56:00+00:00'}
 ,{s: 'initiate or intensify outpatient diabetes regimen in hospitalized patients with newly diagnosed or poorly controlled type 2 diabetes', t: 'diabetes', fact: 'f_89e0d149c1501b27', doc: 'pubmed/28573408.txt', start: 377, end: 525, evidence: 'Hospitalized patients who have newly diagnosed or poorly controlled T2DM require initiation or intensification of their outpatient diabetes regimen.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:56:17+00:00'}
 ,{s: 'initiate or intensify outpatient diabetes regimen in hospitalized patients with newly diagnosed or poorly controlled type 2 diabetes', t: 'poor glycemic control', fact: 'f_cbadc96a0f872d24', doc: 'pubmed/28573408.txt', start: 377, end: 525, evidence: 'Hospitalized patients who have newly diagnosed or poorly controlled T2DM require initiation or intensification of their outpatient diabetes regimen.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:56:17+00:00'}
 ,{s: 'refer patients to a diabetologist preoperatively if previously unknown diabetes or glycaemic imbalance (hba1c <5% or >8%) is detected', t: 'diabetes', fact: 'f_5c66fbca88d6210d', doc: 'pubmed/29317312.txt', start: 188, end: 390, evidence: 'A patient should be referred to a diabetologist perioperatively in several circumstances: preoperative recognition of a previously unknown diabetes or detection of glycaemic imbalance (HbA1c <5% or >8%)', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:56:28+00:00'}
 ,{s: 'refer patients to a diabetologist during hospitalisation for recognition of unknown diabetes, persisting glycaemic imbalance, or difficulty resuming chronic treatment', t: 'diabetes', fact: 'f_853349f7c3f57877', doc: 'pubmed/29317312.txt', start: 392, end: 567, evidence: 'during hospitalisation, recognition of a previously unknown diabetes, persisting glycaemic imbalance despite treatment or difficulty resuming previously used chronic treatment', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:56:28+00:00'}
 ,{s: 'refer diabetic patients to a diabetologist postoperatively and after discharge if hba1c is >8%', t: 'diabetes', fact: 'f_294de5298d7f833d', doc: 'pubmed/29317312.txt', start: 569, end: 666, evidence: 'postoperatively and after discharge from hospital, for all diabetic patients in whom HbA1c is >8%', confidence: 0.92, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:56:28+00:00'}
 ,{s: 'bolus insulin should be stopped after surgery except if severe hyperglycemia', t: 'hyperglycemia', fact: 'f_fa1279af2f016682', doc: 'pubmed/31401070.txt', start: 1272, end: 1422, evidence: 'After surgery, insulin pump should not be stopped, basal insulin should be halved, and bolus insulin should be stopped except if severe hyperglycemia.', confidence: 0.85, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:57:17+00:00'}
 ,{s: 'de-escalate the insulin infusion rate from 0.1 to 0.05 units/kg/h when the glucose concentration drops below 14 mmol/l', t: 'diabetic ketoacidosis', fact: 'f_a335ba9eaf6cb75b', doc: 'pubmed/35224769.txt', start: 688, end: 1023, evidence: 'The guideline takes into account new evidence on the use of the previous version of this document, particularly the high prevalence of hypoglycaemia and hypokalaemia, and recommends that when the glucose concentration drops below 14 mmol/L, that de-escalating the insulin infusion rate from 0.1 to 0.05 units/kg/h should be considered.', confidence: 0.88, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:58:33+00:00'}
 ,{s: 'commence fixed rate intravenous insulin infusion once osmolality stops falling with fluid replacement unless there is ketonaemia', t: 'hyperosmolar hyperglycaemic state', fact: 'f_1bf49f18fe0d665f', doc: 'pubmed/36370077.txt', start: 1575, end: 1785, evidence: '(2) fixed rate intravenous insulin infusion (FRIII) should be commenced once osmolality stops falling with fluid replacement unless there is ketonaemia (FRIII should be commenced at the same time as IV fluids).', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:59:03+00:00'}
 ,{s: 'provide potassium replacement according to potassium levels', t: 'hyperosmolar hyperglycaemic state', fact: 'f_6a82ea077bc7f724', doc: 'pubmed/36370077.txt', start: 1865, end: 1921, evidence: '(4) potassium replacement according to potassium levels.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:59:03+00:00'}
 ,{s: 'those undergoing bariatric surgery should be informed of the possibility of developing postprandial hyperinsulinaemic hypoglycaemia.', t: 'bariatric surgery', fact: 'f_0d854d14499e4059', doc: 'pubmed/36424342.txt', start: 995, end: 1100, evidence: 'Those undergoing bariatric surgery should be informed of the possibility of developing this complication.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:59:14+00:00'}
 ,{s: 'lifestyle intervention is the first step of treatment for obesity', t: 'obesity', fact: 'f_edff2843d5fdd11d', doc: 'pubmed/37291604.txt', start: 651, end: 705, evidence: 'Lifestyle intervention is the first step of treatment.', confidence: 0.95, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:59:48+00:00'}
 ,{s: 'pharmacotherapy is the second step in children older than 12 years', t: 'obesity', fact: 'f_60763633c96c20b8', doc: 'pubmed/37291604.txt', start: 706, end: 833, evidence: 'In children older than 12 years, pharmacotherapy is the second step, and bariatric surgery is the third one, in selected cases.', confidence: 0.93, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:59:48+00:00'}
 ,{s: 'bariatric surgery is the third step in selected cases', t: 'obesity', fact: 'f_72f8739a17808067', doc: 'pubmed/37291604.txt', start: 706, end: 833, evidence: 'In children older than 12 years, pharmacotherapy is the second step, and bariatric surgery is the third one, in selected cases.', confidence: 0.93, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:59:48+00:00'}
 ,{s: 'prefer an insulin infusion for acute management of hyperglycemia with titration guided by an explicit clinical decision support tool and frequent monitoring intervals during glycemic instability to minimize hypoglycemia and avoid targeting intensive glucose levels', t: 'hyperglycemia', fact: 'f_e00ed574edbbca33', doc: 'pubmed/38240484.txt', start: 2907, end: 3271, evidence: 'The guidelines panel achieved consensus for adults and children regarding a preference for an insulin infusion for the acute management of hyperglycemia with titration guided by an explicit clinical decision support tool and frequent (≤ 1 hr) monitoring intervals during glycemic instability to minimize hypoglycemia and against targeting intensive glucose levels.', confidence: 0.92, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T19:00:33+00:00'}
 ,{s: 'administer influenza vaccinations to patients with diabetes mellitus', t: 'diabetes', fact: 'f_2294d54fbddd215e', doc: 'pubmed/38561880.txt', start: 558, end: 748, evidence: 'This consensus is formulated by a multidisciplinary team to serve as practical guidance for the administration of influenza vaccinations to patients with diabetes mellitus in daily practice.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T19:01:02+00:00'}
 ,{s: 'adjust insulin dosage when adding sglt-2 inhibitors or glp-1 receptor agonists to avoid hypoglycaemia', t: 'diabetes', fact: 'f_a421568d226051a9', doc: 'pubmed/39551547.txt', start: 983, end: 1188, evidence: 'For patients already on insulin, it is essential to adjust the dosage when adding SGLT-2 inhibitors (SGLT2i) or GLP-1 receptor agonists (GLP-1RA) to avoid hypoglycaemia, with structured glucose monitoring.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T19:01:17+00:00'}
 ,{s: 'monitor blood glucose for patients with diabetes and admission hyperglycemia', t: 'diabetes', fact: 'f_56c429ac46beeca9', doc: 'pubmed/40117466.txt', start: 1028, end: 1144, evidence: 'All guidelines recommended monitoring blood glucose for patients with diabetes and nine for admission hyperglycemia.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T19:01:44+00:00'}
 ,{s: 'monitor blood glucose for patients with diabetes and admission hyperglycemia', t: 'hyperglycemia', fact: 'f_693dc2bb96599e1c', doc: 'pubmed/40117466.txt', start: 1028, end: 1144, evidence: 'All guidelines recommended monitoring blood glucose for patients with diabetes and nine for admission hyperglycemia.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T19:01:44+00:00'}
 ,{s: 'treat hyperglycemia with basal-bolus insulin alone or with correction', t: 'hyperglycemia', fact: 'f_aa3c6794aa55f98c', doc: 'pubmed/40117466.txt', start: 1420, end: 1597, evidence: 'Hyperglycemia treatment with basal-bolus insulin alone (n = 3) or with correction (n = 5) was most commonly recommended, while sliding scale insulin was advised against (n = 5).', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T19:01:44+00:00'}
 ,{s: 'patients should receive structured education on blood glucose monitoring, nutritional strategies, and recognition and management of hypoglycemia', t: 'diabetes', fact: 'f_4a281bb4a4101648', doc: 'pubmed/42036164.txt', start: 163, end: 415, evidence: 'Effective discharge planning for patients with diabetes requires a comprehensive, individualized approach. Patients should receive structured education on blood glucose monitoring, nutritional strategies, and recognition and management of hypoglycemia.', confidence: 0.88, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T19:02:19+00:00'}
 ,{s: 'people with diabetes usually have an a1c test at least twice a year.', t: 'diabetes', fact: 'f_308fe933c477625e', doc: 'medlineplus/blood-glucose.txt', start: 2518, end: 2586, evidence: 'People with diabetes usually have an A1C test at least twice a year.', confidence: 0.9, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:18:48+00:00'}
 ,{s: 'start getting screenings at age 45', t: 'colorectal cancer', fact: 'f_ead5595ef21e2a1b', doc: 'medlineplus/colonoscopy.txt', start: 1402, end: 1537, evidence: 'If aren\'t at higher risk for colorectal cancer, your health care provider will likely recommend you start getting screenings at age 45.', confidence: 0.9, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:19:24+00:00'}
 ,{s: 'have them maintain a healthy weight', t: 'diabetes', fact: 'f_cea847214a308145', doc: 'medlineplus/diabetes-in-children-and-teens.txt', start: 962, end: 1048, evidence: 'To lower the risk of type 2 diabetes in children:\n\nHave them maintain a healthy weight', confidence: 0.9, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:19:56+00:00'}
 ,{s: 'be sure they are physically active', t: 'diabetes', fact: 'f_6ba21c498884decb', doc: 'medlineplus/diabetes-in-children-and-teens.txt', start: 962, end: 1084, evidence: 'To lower the risk of type 2 diabetes in children:\n\nHave them maintain a healthy weight\n\nBe sure they are physically active', confidence: 0.9, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:19:56+00:00'}
 ,{s: 'take daily doses of insulin, either by injection or through a special pump', t: 'diabetes', fact: 'f_2a53dc0520e1fa49', doc: 'medlineplus/diabetes.txt', start: 4462, end: 4583, evidence: 'If you have type 1 diabetes, you will need to take daily doses of insulin, either by injection or through a special pump.', confidence: 0.95, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:20:26+00:00'}
 ,{s: 'be screened for gestational diabetes between 24 and 28 weeks of pregnancy', t: 'gestational diabetes', fact: 'f_ff26747dfdfdede3', doc: 'medlineplus/diabetes.txt', start: 4070, end: 4176, evidence: 'If you are pregnant, you will usually be screened for this condition between 24 and 28 weeks of pregnancy.', confidence: 0.9, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:20:26+00:00'}
 ,{s: 'take control of your diabetes', t: 'diabetic eye problems', fact: 'f_0443207565438961', doc: 'medlineplus/diabetic-eye-problems.txt', start: 4250, end: 4369, evidence: 'That\'s why your best defense against serious vision loss is to take control of your diabetes and get regular eye exams.', confidence: 0.85, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:20:48+00:00'}
 ,{s: 'get regular eye exams', t: 'diabetic eye problems', fact: 'f_16f03df064c34f79', doc: 'medlineplus/diabetic-eye-problems.txt', start: 4250, end: 4369, evidence: 'That\'s why your best defense against serious vision loss is to take control of your diabetes and get regular eye exams.', confidence: 0.85, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:20:48+00:00'}
 ,{s: 'keep your blood pressure and cholesterol in a healthy range', t: 'diabetic eye problems', fact: 'f_d3edc28a0b71de83', doc: 'medlineplus/diabetic-eye-problems.txt', start: 4370, end: 4453, evidence: 'It\'s also important to keep your blood pressure and cholesterol in a healthy range.', confidence: 0.85, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:20:48+00:00'}
 ,{s: 'people with diabetes should get regular screenings for kidney disease.', t: 'diabetes', fact: 'f_80ac2748a9651601', doc: 'medlineplus/diabetic-kidney-problems.txt', start: 433, end: 503, evidence: 'People with diabetes should get regular screenings for kidney disease.', confidence: 0.95, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:21:18+00:00'}
 ,{s: 'have an exam every year', t: 'diabetes', fact: 'f_286b8b0f1f634926', doc: 'medlineplus/eye-care.txt', start: 5468, end: 5525, evidence: 'If you have diabetes, you should have an exam every year.', confidence: 0.95, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:21:25+00:00'}
 ,{s: 'you may need antibiotics and/or surgery.', t: 'fistula', fact: 'f_a149ee4759e51a21', doc: 'medlineplus/fistulas.txt', start: 609, end: 703, evidence: 'Some fistulas will close on their own. In some cases, you may need antibiotics and/or surgery.', confidence: 0.9, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:21:42+00:00'}
 ,{s: 'take aspirin in the second trimester, if you are at risk of preeclampsia and your provider recommends aspirin.', t: 'preeclampsia', fact: 'f_879f9c19e774535e', doc: 'medlineplus/high-blood-pressure-in-pregnancy.txt', start: 5513, end: 5623, evidence: 'Take aspirin in the second trimester, if you are at risk of preeclampsia and your provider recommends aspirin.', confidence: 0.9, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:22:15+00:00'}
 ,{s: 'take one of a few types of diabetes medicines if you are at high risk', t: 'diabetes', fact: 'f_5b3b00c5c0a789c7', doc: 'medlineplus/how-to-prevent-diabetes.txt', start: 3817, end: 3923, evidence: 'If you are at high risk, your provider may suggest that you take one of a few types of diabetes medicines.', confidence: 0.85, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:22:30+00:00'}
 ,{s: 'make sure to get enough calcium and vitamin d through your diet and supplements if you do not have kidney stones', t: 'paget\'s disease of bone', fact: 'f_45ac5233b4d40510', doc: 'medlineplus/paget-s-disease-of-bone.txt', start: 3841, end: 4055, evidence: 'Diet and exercise do not treat Paget\'s, but they can help to keep your skeleton healthy. If you do not have kidney stones, you should make sure to get enough calcium and vitamin D through your diet and supplements.', confidence: 0.85, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:24:26+00:00'}
 ,{s: 'test the radon levels', t: 'radon', fact: 'f_2e43385c36b44593', doc: 'medlineplus/radiation-exposure.txt', start: 4222, end: 4318, evidence: 'If you live in a house, test the radon levels, and if you need to, get a radon reduction system.', confidence: 0.9, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:25:07+00:00'}
 ,{s: 'get a radon reduction system', t: 'radon', fact: 'f_910ab450452f71ce', doc: 'medlineplus/radiation-exposure.txt', start: 4222, end: 4318, evidence: 'If you live in a house, test the radon levels, and if you need to, get a radon reduction system.', confidence: 0.9, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:25:07+00:00'}
 ,{s: 'give antibiotics to family members of people who have had whooping cough or people who have been exposed to it', t: 'whooping cough', fact: 'f_ed0aa2b24c37c641', doc: 'medlineplus/whooping-cough.txt', start: 3600, end: 3743, evidence: 'Sometimes health care providers give antibiotics to family members of people who have had whooping cough or people who have been exposed to it.', confidence: 0.9, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:25:47+00:00'}
] AS r
MATCH (s:Recommendation {_key: r.s}), (t:Condition {_key: r.t})
MERGE (s)-[x:APPLIES_TO {_prov_fact_id: r.fact}]->(t)
  SET x._prov_source_document = r.doc, x._prov_char_start = r.start, x._prov_char_end = r.end, x._prov_evidence = r.evidence,
      x._prov_confidence = r.confidence, x._prov_prompt_id = r.run, x._prov_run_id = r.runId, x._prov_prompt_hash = r.hash, x._prov_llm_model = r.llm,
      x._prov_policy_version = r.policy, x._prov_extracted_at = r.ts;

UNWIND [
  {s: 'acarbose', t: 'alpha-glucosidase inhibitors', fact: 'f_e8e208d68f58c32c', doc: 'openfda/acarbose.txt', start: 85, end: 139, evidence: 'Pharmacologic class: alpha-Glucosidase Inhibitor [EPC]', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:05:09+00:00'}
 ,{s: 'acarbose', t: 'alpha-glucosidase inhibitors', fact: 'f_760f322c05ee1bb1', doc: 'openfda/acarbose.txt', start: 11777, end: 11942, evidence: 'There have been rare postmarketing reports of pneumatosis cystoides intestinalis associated with the use of alpha-glucosidase inhibitors, including acarbose tablets.', confidence: 0.9, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:05:09+00:00'}
 ,{s: 'glimepiride', t: 'sulfonylureas', fact: 'f_9c00338d8806baa2', doc: 'openfda/glimepiride.txt', start: 94, end: 133, evidence: 'Pharmacologic class: Sulfonylurea [EPC]', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:05:48+00:00'}
 ,{s: 'glimepiride', t: 'sulfonylureas', fact: 'f_523f302dc0f5a5f8', doc: 'openfda/glimepiride.txt', start: 4476, end: 4624, evidence: 'Because glimepiride tablets are a sulfonylurea, use caution in patients with G6PD deficiency and consider the use of a non-sulfonylurea alternative.', confidence: 0.98, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:05:48+00:00'}
 ,{s: 'tolbutamide', t: 'sulfonylureas', fact: 'f_72c8cf50cda9ae08', doc: 'openfda/glimepiride.txt', start: 6160, end: 6460, evidence: 'Although only one drug in the sulfonylurea class (tolbutamide) was included in this study, it is prudent from a safety standpoint to consider that this warning may also apply to other oral hypoglycemic drugs in this class, in view of their close similarities in mode of action and chemical structure.', confidence: 0.9, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:05:48+00:00'}
 ,{s: 'glimepiride', t: 'sulfonylureas', fact: 'f_9a43953ea22c2b51', doc: 'openfda/glimepiride.txt', start: 13014, end: 13140, evidence: 'The following are examples of medications that may increase the glucose-lowering effect of sulfonylureas including glimepiride', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:05:48+00:00'}
