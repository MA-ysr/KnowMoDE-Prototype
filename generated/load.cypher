 ,{s: 'acarbose', t: 'hypoglycemia', fact: 'f_eefb6fa676a29b52', doc: 'openfda/acarbose.txt', start: 4866, end: 5033, evidence: 'Very rarely, individual cases of hypoglycemic shock have been reported in patients receiving acarbose tablets therapy in combination with sulfonylureas and/or insulin.', confidence: 0.9, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:05:09+00:00'}
 ,{s: 'acarbose', t: 'abdominal pain', fact: 'f_53f4bce275f463c0', doc: 'openfda/acarbose.txt', start: 9897, end: 10090, evidence: 'In U.S. placebo-controlled trials, the incidences of abdominal pain, diarrhea, and flatulence were 19%, 31%, and 74% respectively in 1255 patients treated with acarbose tablets 50-300 mg t.i.d.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:05:09+00:00'}
 ,{s: 'acarbose', t: 'diarrhea', fact: 'f_ed8bf38a90701fd0', doc: 'openfda/acarbose.txt', start: 9897, end: 10090, evidence: 'In U.S. placebo-controlled trials, the incidences of abdominal pain, diarrhea, and flatulence were 19%, 31%, and 74% respectively in 1255 patients treated with acarbose tablets 50-300 mg t.i.d.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:05:09+00:00'}
