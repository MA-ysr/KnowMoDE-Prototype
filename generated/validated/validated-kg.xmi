    <validRelations factId="f_5e2ac6a46e9fcde6" type="INCREASES_RISK_OF" sourceType="RiskFactor" sourceId="accumulated-number-of-admissions" targetType="ClinicalOutcome" targetId="hospital-readmission-within-30-days" sourceKey="prior inpatient admissions" targetKey="hospital readmission within 30 days" confidence="0.85">
      <provenance sourceDocument="pubmed/26042761.txt" sourceUri="https://pubmed.ncbi.nlm.nih.gov/26042761/" sourceSha256="d84b4728468684080715d464e3e0fd8877dcab51a239a47f0afb046864d820a9" charStart="497" charEnd="1234" mention="In this retrospective study, we identify factors associated with readmission within 30 days based on claims and administrative data of nine hospitals from 2005 to 2012. We present a data inclusion and exclusion criteria to identify potentially preventable readmissions. Multivariate logistic regression models and a Cox proportional hazards extension are used to estimate the readmission risk for 4 chronic conditions (congestive heart failure [CHF], chronic obstructive pulmonary disease [COPD], acute myocardial infarction, and type 2 diabetes) and pneumonia, known to be related to high readmission rates. Accumulated number of admissions and discharge disposition were identified to be significant factors across most disease groups." extractionTask="literature_extraction" llmModel="gemini/gemini-3.5-flash-lite" promptId="literature_extraction@9b00038fb5d2" promptHash="9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb" extractionTimestamp="2026-10-15T12:28:33+00:00" confidence="0.85" validationPolicyVersion="f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a">
