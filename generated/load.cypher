 ,{s: 'diabetes', t: 'hospital readmission within 30 days', fact: 'f_9a296ae5fefb25e0', doc: 'pubmed/30846065.txt', start: 1253, end: 1664, evidence: 'Significant predictors associated with increased 30-day readmission included diabetes (OR, 1.07; 95% CI, 1.06-1.08; P < .001), chronic kidney disease (1.12;1.10-1.14, P < .001), congestive heart failure (OR, 1.16; 95% CI, 1.14-1.18; P < .001), discharge to short-/long-term facility (OR, 1.13; 95% CI, 1.11-1.14; P < .001), Charlson comorbidity index ≥ 2, and length of stay ≥ 3 days during the index admission.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:34:53+00:00'}
