 ,{s: 'acarbose', t: 'fulminant hepatitis', fact: 'f_e5794264e8e40334', doc: 'openfda/acarbose.txt', start: 11380, end: 11741, evidence: 'Additional adverse events reported from worldwide postmarketing experience include fulminant hepatitis with fatal outcome, hypersensitive skin reactions (for example rash, erythema, exanthema and uticaria), edema, ileus/subileus, jaundice and/or hepatitis and associated liver damage, thrombocytopenia, and pneumatosis cystoides intestinalis (see PRECAUTIONS ).', confidence: 0.9, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:05:09+00:00'}
