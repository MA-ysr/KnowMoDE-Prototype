  <relations type="TREATS" sourceType="Drug" sourceId="glipizide-and-metformin" targetType="Condition" targetId="type-2-diabetes-mellitus" confidence="0.98" evidence="Glipizide and metformin hydrochloride tablets USP are indicated as an adjunct to diet and exercise to improve glycemic control in adults with type 2 diabetes mellitus." sourceSpanStart="318" sourceSpanEnd="485"/>
  <relations type="CONTRAINDICATED_IN" sourceType="Drug" sourceId="glipizide-and-metformin" targetType="Condition" targetId="severe-renal-impairment" confidence="0.96" evidence="Glipizide and metformin hydrochloride tablets are contraindicated in patients with: Severe renal impairment (eGFR below 30 mL/min/1.73 m 2 ) (see WARNINGS and PRECAUTIONS )." sourceSpanStart="527" sourceSpanEnd="700"/>
  <relations type="CONTRAINDICATED_IN" sourceType="Drug" sourceId="glipizide-and-metformin" targetType="Condition" targetId="hypersensitivity" confidence="0.95" evidence="Glipizide and metformin hydrochloride tablets are contraindicated in patients with: ... Known hypersensitivity to glipizide or metformin hydrochloride." sourceSpanStart="321" sourceSpanEnd="475"/>
  <relations type="CONTRAINDICATED_IN" sourceType="Drug" sourceId="glipizide-and-metformin" targetType="Condition" targetId="metabolic-acidosis" confidence="0.96" evidence="Glipizide and metformin hydrochloride tablets are contraindicated in patients with: ... Acute or chronic metabolic acidosis, including diabetic ketoacidosis, with or without coma." sourceSpanStart="321" sourceSpanEnd="558"/>
  <relations type="CONTRAINDICATED_IN" sourceType="Drug" sourceId="glipizide-and-metformin" targetType="Condition" targetId="diabetic-ketoacidosis" confidence="0.96" evidence="Glipizide and metformin hydrochloride tablets are contraindicated in patients with: ... Acute or chronic metabolic acidosis, including diabetic ketoacidosis, with or without coma." sourceSpanStart="321" sourceSpanEnd="558"/>
  <relations type="TREATS" sourceType="Drug" sourceId="insulin" targetType="Condition" targetId="diabetic-ketoacidosis" confidence="0.95" evidence="Diabetic ketoacidosis should be treated with insulin." sourceSpanStart="857" sourceSpanEnd="910"/>
  <relations type="BELONGS_TO_CLASS" sourceType="Drug" sourceId="tolbutamide" targetType="DrugClass" targetId="sulfonylureas" confidence="0.92" evidence="Although only 1 drug in the sulfonylurea class (tolbutamide) was included in this study, it is prudent from a safety standpoint to consider that this warning may also apply to other hypoglycemic drugs in this class" sourceSpanStart="2323" sourceSpanEnd="2537"/>
  <relations type="MAY_CAUSE" sourceType="Drug" sourceId="metformin" targetType="Condition" targetId="lactic-acidosis" confidence="0.98" evidence="There have been postmarketing cases of metformin-associated lactic acidosis, including fatal cases." sourceSpanStart="2717" sourceSpanEnd="2816" chunkIndex="2"/>
  <relations type="CONTRAINDICATED_IN" sourceType="Drug" sourceId="glipizide-and-metformin" targetType="Condition" targetId="severe-renal-impairment" confidence="0.96" evidence="Glipizide and metformin hydrochloride tablets are contraindicated in patients with an eGFR less than 30 mL/min/1.73 m 2 ." sourceSpanStart="5118" sourceSpanEnd="5239" chunkIndex="2"/>
  <relations type="MAY_CAUSE" sourceType="Drug" sourceId="metformin" targetType="Condition" targetId="lactic-acidosis" confidence="0.9" evidence="Administration of intravascular iodinated contrast agents in metformin-treated patients has led to an acute decrease in renal function and the occurrence of lactic acidosis." sourceSpanStart="6473" sourceSpanEnd="6646" chunkIndex="3"/>
  <relations type="MAY_CAUSE" sourceType="Drug" sourceId="glipizide-and-metformin" targetType="Condition" targetId="hypoglycemia" confidence="0.95" evidence="Glipizide and metformin hydrochloride tablets are capable of producing hypoglycemia; therefore, proper patient selection, dosing, and instructions are important to avoid potential hypoglycemic episodes." sourceSpanStart="9294" sourceSpanEnd="9496" chunkIndex="3"/>
  <relations type="BELONGS_TO_CLASS" sourceType="Drug" sourceId="glipizide-and-metformin-hydrochloride" targetType="DrugClass" targetId="sulfonylurea-agents" confidence="0.95" evidence="Because glipizide and metformin hydrochloride tablets belong to the class of sulfonylurea agents, caution should be used in patients with G6PD deficiency and a non-sulfonylurea alternative should be considered." sourceSpanStart="10683" sourceSpanEnd="10893" chunkIndex="4"/>
  <relations type="INTERACTS_WITH" sourceType="Drug" sourceId="glipizide-er" targetType="Drug" targetId="colesevelam" confidence="0.9" evidence="When glipizide ER was administered 4 hours prior to colesevelam, there was no significant change in glipizide AUC 0-∞ or C max , –4% and 0%, respectively." sourceSpanStart="17450" sourceSpanEnd="17604" chunkIndex="6"/>
  <relations type="INTERACTS_WITH" sourceType="Drug" sourceId="metformin" targetType="Drug" targetId="furosemide" confidence="0.95" evidence="A single-dose, metformin-furosemide drug interaction study in healthy subjects demonstrated that pharmacokinetic parameters of both compounds were affected by coadministration." sourceSpanStart="17830" sourceSpanEnd="18006" chunkIndex="6"/>
  <relations type="INTERACTS_WITH" sourceType="Drug" sourceId="metformin" targetType="Drug" targetId="nifedipine" confidence="0.95" evidence="A single-dose, metformin-nifedipine drug interaction study in normal healthy volunteers demonstrated that coadministration of nifedipine increased plasma metformin C max and AUC by 20% and 9%, respectively, and increased the amount excreted in the urine." sourceSpanStart="18524" sourceSpanEnd="18778" chunkIndex="6"/>
  <relations type="INTERACTS_WITH" sourceType="Drug" sourceId="metformin" targetType="Drug" targetId="ranolazine" confidence="0.9" evidence="Concomitant use of drugs that interfere with common renal tubular transport systems involved in the renal elimination of metformin (e.g., organic cationic transporter-2 [OCT2] / multidrug and toxin extrusion [MATE] inhibitors such as ranolazine, vandetanib, dolutegravir, and cimetidine) could increase systemic exposure to metformin and may increase the risk for lactic acidosis." sourceSpanStart="18958" sourceSpanEnd="19338" chunkIndex="6"/>
  <relations type="INTERACTS_WITH" sourceType="Drug" sourceId="metformin" targetType="Drug" targetId="vandetanib" confidence="0.9" evidence="Concomitant use of drugs that interfere with common renal tubular transport systems involved in the renal elimination of metformin (e.g., organic cationic transporter-2 [OCT2] / multidrug and toxin extrusion [MATE] inhibitors such as ranolazine, vandetanib, dolutegravir, and cimetidine) could increase systemic exposure to metformin and may increase the risk for lactic acidosis." sourceSpanStart="18958" sourceSpanEnd="19338" chunkIndex="6"/>
  <relations type="INTERACTS_WITH" sourceType="Drug" sourceId="metformin" targetType="Drug" targetId="dolutegravir" confidence="0.9" evidence="Concomitant use of drugs that interfere with common renal tubular transport systems involved in the renal elimination of metformin (e.g., organic cationic transporter-2 [OCT2] / multidrug and toxin extrusion [MATE] inhibitors such as ranolazine, vandetanib, dolutegravir, and cimetidine) could increase systemic exposure to metformin and may increase the risk for lactic acidosis." sourceSpanStart="18958" sourceSpanEnd="19338" chunkIndex="6"/>
  <relations type="INTERACTS_WITH" sourceType="Drug" sourceId="metformin" targetType="Drug" targetId="cimetidine" confidence="0.9" evidence="Concomitant use of drugs that interfere with common renal tubular transport systems involved in the renal elimination of metformin (e.g., organic cationic transporter-2 [OCT2] / multidrug and toxin extrusion [MATE] inhibitors such as ranolazine, vandetanib, dolutegravir, and cimetidine) could increase systemic exposure to metformin and may increase the risk for lactic acidosis." sourceSpanStart="18958" sourceSpanEnd="19338" chunkIndex="6"/>
  <relations type="MAY_CAUSE" sourceType="Drug" sourceId="metformin" targetType="Condition" targetId="lactic-acidosis" confidence="0.8" evidence="Concomitant use of drugs that interfere with common renal tubular transport systems involved in the renal elimination of metformin (e.g., organic cationic transporter-2 [OCT2] / multidrug and toxin extrusion [MATE] inhibitors such as ranolazine, vandetanib, dolutegravir, and cimetidine) could increase systemic exposure to metformin and may increase the risk for lactic acidosis." sourceSpanStart="18958" sourceSpanEnd="19338" chunkIndex="6"/>
  <relations type="INTERACTS_WITH" sourceType="Drug" sourceId="metformin" targetType="Drug" targetId="propranolol" confidence="0.9" evidence="In healthy volunteers, the pharmacokinetics of metformin and propranolol, and metformin and ibuprofen were not affected when coadministered in single-dose interaction studies." sourceSpanStart="19838" sourceSpanEnd="20013" chunkIndex="6"/>
  <relations type="INTERACTS_WITH" sourceType="Drug" sourceId="metformin" targetType="Drug" targetId="ibuprofen" confidence="0.9" evidence="In healthy volunteers, the pharmacokinetics of metformin and propranolol, and metformin and ibuprofen were not affected when coadministered in single-dose interaction studies." sourceSpanStart="19838" sourceSpanEnd="20013" chunkIndex="6"/>
  <relations type="MAY_CAUSE" sourceType="Drug" sourceId="topiramate" targetType="Condition" targetId="metabolic-acidosis" confidence="0.9" evidence="Topiramate or other carbonic anhydrase inhibitors (e.g., zonisamide, acetazolamide or dichlorphenamide) frequently causes a decrease in serum bicarbonate and induce non-anion gap, hyperchloremic metabolic acidosis." sourceSpanStart="20323" sourceSpanEnd="20537" chunkIndex="6"/>
  <relations type="BELONGS_TO_CLASS" sourceType="Drug" sourceId="tolbutamide" targetType="DrugClass" targetId="sulfonylureas" confidence="0.9" evidence="This fetotoxicity has been similarly noted with other sulfonylureas, such as tolbutamide and tolazamide." sourceSpanStart="23845" sourceSpanEnd="23949" chunkIndex="7"/>
  <relations type="BELONGS_TO_CLASS" sourceType="Drug" sourceId="tolazamide" targetType="DrugClass" targetId="sulfonylureas" confidence="0.9" evidence="This fetotoxicity has been similarly noted with other sulfonylureas, such as tolbutamide and tolazamide." sourceSpanStart="23845" sourceSpanEnd="23949" chunkIndex="7"/>
  <relations type="MAY_CAUSE" sourceType="Drug" sourceId="glipizide" targetType="Condition" targetId="hypoglycemia" confidence="0.8" evidence="Prolonged severe hypoglycemia (4 to 10 days) has been reported in neonates born to mothers who were receiving a sulfonylurea drug at the time of delivery." sourceSpanStart="24586" sourceSpanEnd="24740" chunkIndex="7"/>
  <relations type="MAY_CAUSE" sourceType="Drug" sourceId="glipizide" targetType="Condition" targetId="hypoglycemia" confidence="0.7" evidence="Because the potential for hypoglycemia in nursing infants may exist, a decision should be made whether to discontinue nursing or to discontinue glipizide and metformin hydrochloride tablets, taking into account the importance of the drug to the mother." sourceSpanStart="25444" sourceSpanEnd="25696" chunkIndex="8"/>
