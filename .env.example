# Copy to .env (git-ignored) and fill in. Never commit .env.

# Gemini API key from Google AI Studio (free researcher tier). Used by xaikg-pipeline.
GEMINI_API_KEY=

# Neo4j password used by compose.yaml and by the pipeline/service (choose your own; required).
NEO4J_PASSWORD=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# Optional second LLM provider for the E3 comparison (local Ollama).
# OLLAMA_BASE_URL=http://localhost:11434/v1
