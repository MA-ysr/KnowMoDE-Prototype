  {key: 'use early identification of patients in need of education, implementation of a clinical pathway, and clear instructions about medications and follow-up appointments to ensure an effective diabetes discharge', idValue: 'use early identification of patients in need of education, implementation of a clinical pathway, and clear instructions about medications and follow-up appointments to ensure an effective diabetes discharge', props: {statement: 'use early identification of patients in need of education, implementation of a clinical pathway, and clear instructions about medications and follow-up appointments to ensure an effective diabetes discharge', source: 'Endocrine practice'}, doc: 'pubmed/19364697.txt', run: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', prompt: 'guideline_extraction@9a20634981a4', mention: 'Strategies that can be used to ensure an effective diabetes discharge are early identification of patients in need of education, implementation of a clinical pathway, and clear instructions about medications and follow-up appointments at the time of discharge.', start: 1372, end: 1632, confidence: 0.9, task: 'guideline_extraction', normalizedFrom: null, modifiable: false, plainLabel: null}
 ,{key: 'give insulin as a continuous intravenous infusion in critically ill patients', idValue: 'give insulin as a continuous intravenous infusion in critically ill patients', props: {statement: 'give insulin as a continuous intravenous infusion in critically ill patients', source: 'Current medical research and opinion'}, doc: 'pubmed/20078323.txt', run: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', prompt: 'guideline_extraction@9a20634981a4', mention: 'In critically ill patients insulin is given as a continuous intravenous (IV) infusion', start: 1516, end: 1601, confidence: 0.9, task: 'guideline_extraction', normalizedFrom: null, modifiable: false, plainLabel: null}
 ,{key: 'manage hyperglycemia in non-critically ill inpatients using scheduled subcutaneous basal-bolus insulin regimens supplemented with correction doses', idValue: 'manage hyperglycemia in non-critically ill inpatients using scheduled subcutaneous basal-bolus insulin regimens supplemented with correction doses', props: {statement: 'manage hyperglycemia in non-critically ill inpatients using scheduled subcutaneous basal-bolus insulin regimens supplemented with correction doses', source: 'Current medical research and opinion'}, doc: 'pubmed/20078323.txt', run: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', prompt: 'guideline_extraction@9a20634981a4', mention: 'in non-critically ill inpatients hyperglycemia is best managed using scheduled subcutaneous (SC) basal-bolus insulin regimens supplemented with correction doses as needed and adjusted daily with the guidance of frequent blood glucose monitoring', start: 1606, end: 1850, confidence: 0.92, task: 'guideline_extraction', normalizedFrom: null, modifiable: false, plainLabel: null}
