 ,{s: 'glyburide', t: 'hypoglycemia', fact: 'f_751a4d340903632b', doc: 'openfda/glyburide-and-metformin.txt', start: 26224, end: 26366, evidence: 'However, sulfonylureas (including glyburide) cross the placenta and have been associated with neonatal adverse reactions such as hypoglycemia.', confidence: 0.85, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:09:57+00:00'}
