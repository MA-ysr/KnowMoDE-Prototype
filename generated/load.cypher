 ,{s: '5-mfi score of 2 or more', t: 'hospital readmission within 30 days', fact: 'f_587b9fb96d7b5407', doc: 'pubmed/37632725.txt', start: 1399, end: 1796, evidence: 'Multivariate analysis identified a 5-mFI of 2 or more as an independent risk factor for overall complications [OR: 1.40, 1.03-1.78; P = .032], pulmonary complications [2.97, 1.63-5.39; P < .001], hematological complications [1.60, 1.03-2.47; P = .035], renal complications [2.04, 1.19-3.46; P = .009], readmission [1.54, 1.19-1.99; P < .001], and discharge to facility [2.50, 1.66-3.77; P < .001].', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:41:33+00:00'}
