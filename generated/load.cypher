 ,{s: 'heart failure', t: 'recurrent emergency department visits for epistaxis', fact: 'f_00501c7bd1181e13', doc: 'pubmed/29208334.txt', start: 1061, end: 1242, evidence: 'Recurrent ED visits for epistaxis was higher in patients with congestive heart failure, diabetes mellitus, and obstructive sleep apnea compared to those without these comorbidities.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:32:08+00:00'}
