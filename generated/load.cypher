 ,{key: 'provide diabetes education focused on basic survival skills and tailored to learning needs throughout hospitalization', idValue: 'provide diabetes education focused on basic survival skills and tailored to learning needs throughout hospitalization', props: {statement: 'provide diabetes education focused on basic survival skills and tailored to learning needs throughout hospitalization', source: 'Current diabetes reports'}, doc: 'pubmed/28573408.txt', run: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', prompt: 'guideline_extraction@9a20634981a4', mention: 'Throughout hospitalization, patients should receive diabetes education focused on basic survival skills and tailored to learning needs.', start: 640, end: 775, confidence: 0.95, task: 'guideline_extraction', normalizedFrom: null, modifiable: false, plainLabel: null}
 ,{key: 'provide personalized discharge instructions including a list of all medications and follow-up appointments with outpatient diabetes provider and diabetes educator', idValue: 'provide personalized discharge instructions including a list of all medications and follow-up appointments with outpatient diabetes provider and diabetes educator', props: {statement: 'provide personalized discharge instructions including a list of all medications and follow-up appointments with outpatient diabetes provider and diabetes educator', source: 'Current diabetes reports'}, doc: 'pubmed/28573408.txt', run: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', prompt: 'guideline_extraction@9a20634981a4', mention: 'Patients should leave the hospital with personalized discharge instructions that include a list of all medications and follow-up appointments with both the outpatient diabetes provider and a diabetes educator whenever possible.', start: 776, end: 1003, confidence: 0.94, task: 'guideline_extraction', normalizedFrom: null, modifiable: false, plainLabel: null}
