UNWIND [
  {s: 'target glucose near 140 mg/dl for all hospitalized patients', t: 'glucose near 140 mg/dl', fact: 'f_82f076e24d243c9e', doc: 'pubmed/20078323.txt', start: 3444, end: 3551, evidence: 'Glucose targets near 140 mg/dL are recommended as being the most appropriate for all hospitalized patients.', confidence: 0.95, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:55:16+00:00'}
 ,{s: 'blood glucose values should be less than 180 mg/dl 18 to 24 hours after anesthesia end time after cardiac surgery', t: 'blood glucose < 180 mg/dl', fact: 'f_2304f3f4d377ad2b', doc: 'pubmed/27164170.txt', start: 203, end: 384, evidence: 'Recent changes in the Surgical Care Improvement Project guideline require blood glucose values be less than 180 mg/dL 18 to 24 hours after anesthesia end time after cardiac surgery.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:56:00+00:00'}
 ,{s: 'refer patients to a diabetologist preoperatively if previously unknown diabetes or glycaemic imbalance (hba1c <5% or >8%) is detected', t: 'hba1c <5% or >8%', fact: 'f_92408565f82d6acb', doc: 'pubmed/29317312.txt', start: 188, end: 390, evidence: 'A patient should be referred to a diabetologist perioperatively in several circumstances: preoperative recognition of a previously unknown diabetes or detection of glycaemic imbalance (HbA1c <5% or >8%)', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:56:28+00:00'}
 ,{s: 'refer diabetic patients to a diabetologist postoperatively and after discharge if hba1c is >8%', t: 'hba1c > 8%', fact: 'f_503978254f15cf74', doc: 'pubmed/29317312.txt', start: 569, end: 666, evidence: 'postoperatively and after discharge from hospital, for all diabetic patients in whom HbA1c is >8%', confidence: 0.92, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:56:28+00:00'}
 ,{s: 'de-escalate the insulin infusion rate from 0.1 to 0.05 units/kg/h when the glucose concentration drops below 14 mmol/l', t: 'glucose concentration < 14 mmol/l', fact: 'f_760da3ed7cc77129', doc: 'pubmed/35224769.txt', start: 688, end: 1023, evidence: 'The guideline takes into account new evidence on the use of the previous version of this document, particularly the high prevalence of hypoglycaemia and hypokalaemia, and recommends that when the glucose concentration drops below 14 mmol/L, that de-escalating the insulin infusion rate from 0.1 to 0.05 units/kg/h should be considered.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:58:33+00:00'}
 ,{s: 'target an upper blood glucose of 180 mg/dl', t: 'blood glucose > 180 mg/dl', fact: 'f_5ce12ee837754b64', doc: 'pubmed/40117466.txt', start: 1145, end: 1278, evidence: 'Eight guidelines recommended an upper blood glucose target of 180 mg/dL, five with a lower limit of 100 mg/dL and three of 140 mg/dL.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T19:01:44+00:00'}
 ,{s: 'people with diabetes usually have an a1c test at least twice a year.', t: 'a1c test', fact: 'f_87a90db29cfdd3aa', doc: 'medlineplus/blood-glucose.txt', start: 2518, end: 2586, evidence: 'People with diabetes usually have an A1C test at least twice a year.', confidence: 0.9, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:18:48+00:00'}
] AS r
