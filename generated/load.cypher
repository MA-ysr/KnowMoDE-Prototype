UNWIND [
  {s: 'give insulin as a continuous intravenous infusion in critically ill patients', t: 'insulin', fact: 'f_8f14740014240ab5', doc: 'pubmed/20078323.txt', start: 1516, end: 1851, evidence: 'In critically ill patients insulin is given as a continuous intravenous (IV) infusion and in non-critically ill inpatients hyperglycemia is best managed using scheduled subcutaneous (SC) basal-bolus insulin regimens supplemented with correction doses as needed and adjusted daily with the guidance of frequent blood glucose monitoring.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:55:16+00:00'}
 ,{s: 'manage hyperglycemia in non-critically ill inpatients using scheduled subcutaneous basal-bolus insulin regimens supplemented with correction doses', t: 'insulin', fact: 'f_e5aa49a673d7181f', doc: 'pubmed/20078323.txt', start: 1516, end: 1851, evidence: 'In critically ill patients insulin is given as a continuous intravenous (IV) infusion and in non-critically ill inpatients hyperglycemia is best managed using scheduled subcutaneous (SC) basal-bolus insulin regimens supplemented with correction doses as needed and adjusted daily with the guidance of frequent blood glucose monitoring.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:55:16+00:00'}
 ,{s: 'use long-acting basal insulin analogs glargine or detemir for the basal component of therapy', t: 'insulin', fact: 'f_b5e56e9f10054560', doc: 'pubmed/20078323.txt', start: 2333, end: 2448, evidence: 'Long-acting basal insulin analogs (glargine, detemir) are suitable and preferred for the basal component of therapy', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:55:16+00:00'}
