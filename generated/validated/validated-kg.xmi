    <validRelations factId="f_854e5f0906478cc1" type="INCREASES_RISK_OF" sourceType="Condition" sourceId="diabetes-mellitus" targetType="ClinicalOutcome" targetId="30-day-readmission" sourceKey="diabetes" targetKey="hospital readmission within 30 days" confidence="0.9">
