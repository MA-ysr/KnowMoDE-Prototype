  <relations type="CONTRAINDICATED_IN" sourceType="Drug" sourceId="pioglitazone" targetType="Condition" targetId="nyha-class-iii-or-iv-heart-failure" confidence="0.98" evidence="Initiation of pioglitazone in patients with established New York Heart Association (NYHA) Class III or IV heart failure is contraindicated [see Contraindications (4) and Warnings and Precautions (5.1) ] ." sourceSpanStart="847" sourceSpanEnd="1051"/>
  <relations type="BELONGS_TO_CLASS" sourceType="Drug" sourceId="pioglitazone" targetType="DrugClass" targetId="thiazolidinediones" confidence="0.95" evidence="Thiazolidinediones, including pioglitazone , cause or exacerbate congestive heart failure in some patients [see Warnings and Precautions (5.1) ] ." sourceSpanStart="274" sourceSpanEnd="420"/>
  <relations type="TREATS" sourceType="Drug" sourceId="pioglitazone" targetType="Condition" targetId="type-2-diabetes-mellitus" confidence="0.98" evidence="Pioglitazone tablets are indicated as an adjunct to diet and exercise to improve glycemic control in adults with type 2 diabetes mellitus in multiple clinical settings [see Clinical Studies (14) ] ." sourceSpanStart="1934" sourceSpanEnd="2132"/>
  <relations type="CONTRAINDICATED_IN" sourceType="Drug" sourceId="pioglitazone" targetType="Condition" targetId="hypersensitivity" confidence="0.95" evidence="Use in patients with known hypersensitivity to pioglitazone or any other component of pioglitazone tablets." sourceSpanStart="2987" sourceSpanEnd="3094"/>
  <relations type="MAY_CAUSE" sourceType="Drug" sourceId="pioglitazone" targetType="Condition" targetId="congestive-heart-failure" confidence="0.95" evidence="Fluid retention may occur and can exacerbate or lead to congestive heart failure." sourceSpanStart="3421" sourceSpanEnd="3502" chunkIndex="2"/>
  <relations type="MAY_CAUSE" sourceType="Drug" sourceId="pioglitazone" targetType="Condition" targetId="hepatic-failure" confidence="0.9" evidence="Postmarketing reports of hepatic failure, sometimes fatal." sourceSpanStart="3844" sourceSpanEnd="3902" chunkIndex="2"/>
  <relations type="MAY_CAUSE" sourceType="Drug" sourceId="pioglitazone" targetType="Condition" targetId="bladder-cancer" confidence="0.95" evidence="May increase the risk of bladder cancer." sourceSpanStart="4214" sourceSpanEnd="4254" chunkIndex="2"/>
  <relations type="CONTRAINDICATED_IN" sourceType="Drug" sourceId="pioglitazone" targetType="Condition" targetId="bladder-cancer" confidence="0.95" evidence="Do not use in patients with active bladder cancer." sourceSpanStart="4255" sourceSpanEnd="4305" chunkIndex="2"/>
  <relations type="BELONGS_TO_CLASS" sourceType="Drug" sourceId="pioglitazone" targetType="DrugClass" targetId="thiazolidinediones" confidence="0.98" evidence="Pioglitazone, like other thiazolidinediones, can cause dose-related fluid retention" sourceSpanStart="4933" sourceSpanEnd="5016" chunkIndex="2"/>
  <relations type="CONTRAINDICATED_IN" sourceType="Drug" sourceId="pioglitazone" targetType="Condition" targetId="active-bladder-cancer" confidence="0.95" evidence="Consequently, pioglitazone should not be used in patients with active bladder cancer and the benefits of glycemic control versus unknown risks for cancer recurrence with pioglitazone should be considered in patients with a prior history of bladder cancer." sourceSpanStart="10043" sourceSpanEnd="10298" chunkIndex="3"/>
  <relations type="CONTRAINDICATED_IN" sourceType="Drug" sourceId="pioglitazone" targetType="Condition" targetId="edema" confidence="0.95" evidence="Pioglitazone should be used with caution in patients with edema." sourceSpanStart="10588" sourceSpanEnd="10652" chunkIndex="3"/>
  <relations type="MAY_CAUSE" sourceType="Drug" sourceId="pioglitazone" targetType="Condition" targetId="edema" confidence="0.95" evidence="In controlled clinical trials, edema was reported more frequently in patients treated with pioglitazone than in placebo-treated patients and is dose-related" sourceSpanStart="10309" sourceSpanEnd="10465" chunkIndex="3"/>
  <relations type="BELONGS_TO_CLASS" sourceType="Drug" sourceId="pioglitazone" targetType="DrugClass" targetId="thiazolidinediones" confidence="0.95" evidence="Because thiazolidinediones, including pioglitazone, can cause fluid retention, which can exacerbate or lead to congestive heart failure" sourceSpanStart="10653" sourceSpanEnd="10788" chunkIndex="3"/>
  <relations type="CONTRAINDICATED_IN" sourceType="Drug" sourceId="pioglitazone" targetType="Condition" targetId="congestive-heart-failure" confidence="0.9" evidence="estive heart failure, pioglitazone should be used with caution in patients at risk for congestive heart failure." sourceSpanStart="10768" sourceSpanEnd="10880" chunkIndex="4"/>
  <relations type="MAY_CAUSE" sourceType="Drug" sourceId="pioglitazone" targetType="Condition" targetId="bone-fracture" confidence="0.92" evidence="During a mean follow-up of 34.5 months, the incidence of bone fracture in females was 5.1% (44/870) for pioglitazone versus 2.5% (23/905) for placebo." sourceSpanStart="11383" sourceSpanEnd="11533" chunkIndex="4"/>
  <relations type="MAY_CAUSE" sourceType="Drug" sourceId="pioglitazone" targetType="Condition" targetId="macular-edema" confidence="0.95" evidence="Macular edema has been reported in postmarketing experience in diabetic patients who were taking pioglitazone or another thiazolidinedione." sourceSpanStart="12133" sourceSpanEnd="12272" chunkIndex="4"/>
