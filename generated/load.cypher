 ,{s: 'glyburide and metformin', t: 'bosentan', fact: 'f_ff0521766ec024fc', doc: 'openfda/glyburide-and-metformin.txt', start: 23885, end: 23945, evidence: 'Intervention: Concomitant administration is contraindicated.', confidence: 0.9, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:09:57+00:00'}
 ,{s: 'glyburide and metformin', t: 'colesevelam', fact: 'f_26482a447234e382', doc: 'openfda/glyburide-and-metformin.txt', start: 24089, end: 24202, evidence: 'Intervention: Glyburide and metformin hydrochloride should be administered at least 4 hours prior to colesevelam.', confidence: 0.9, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:09:57+00:00'}
 ,{s: 'glyburide', t: 'bosentan', fact: 'f_1869063ec8695810', doc: 'openfda/glyburide.txt', start: 7520, end: 7638, evidence: 'An increased risk of liver enzyme elevations was observed in patients receiving glyburide concomitantly with bosentan.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:11:18+00:00'}
 ,{s: 'glyburide', t: 'ciprofloxacin', fact: 'f_fb6d0471ac59a997', doc: 'openfda/glyburide.txt', start: 8287, end: 8464, evidence: 'A possible interaction between glyburide and ciprofloxacin, a fluoroquinolone antibiotic, has been reported, resulting in a potentiation of the hypoglycemic action of glyburide.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:11:18+00:00'}
 ,{s: 'glyburide', t: 'miconazole', fact: 'f_3668d35d4e4d4f80', doc: 'openfda/glyburide.txt', start: 8514, end: 8640, evidence: 'A potential interaction between oral miconazole and oral hypoglycemic agents leading to severe hypoglycemia has been reported.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:11:18+00:00'}
 ,{s: 'glyburide', t: 'metformin', fact: 'f_185026bec393224a', doc: 'openfda/glyburide.txt', start: 9090, end: 9221, evidence: 'Coadministration of glyburide and metformin did not result in any changes in either metformin pharmacokinetics or pharmacodynamics.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:11:18+00:00'}
 ,{s: 'glyburide', t: 'colesevelam', fact: 'f_3cfe91f45d6dc612', doc: 'openfda/glyburide.txt', start: 9234, end: 9369, evidence: 'Concomitant administration of colesevelam and glyburide resulted in reductions in glyburide AUC and C max of 32% and 47%, respectively.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:11:18+00:00'}
 ,{s: 'glyburide', t: 'topiramate', fact: 'f_71cad2e71e0b61a4', doc: 'openfda/glyburide.txt', start: 9785, end: 9896, evidence: 'There was a 22% decrease in C max and a 25% reduction in AUC 24 for glyburide during topiramate administration.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:11:18+00:00'}
