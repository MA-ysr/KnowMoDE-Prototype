 ,{s: 'diabetes', t: 'hospital readmission within 60 days', fact: 'f_482290a82a9329ba', doc: 'pubmed/31809421.txt', start: 1283, end: 1498, evidence: 'Compared with women without diabetes (1.5% risk for readmission), risk for readmission was significantly higher for women with type 1 DM (4.4%), unspecified diabetes (4.0%), type 2 DM (3.9%), and GDM (2.0%) (P<.01).', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:37:07+00:00'}
