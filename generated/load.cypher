 ,{s: 'diabetes', t: 'hospital readmission within 30 days', fact: 'f_0ccfa3b2c259ff1e', doc: 'pubmed/32148075.txt', start: 1431, end: 1604, evidence: 'Patients with late readmissions were more likely to have diabetes (32.7% vs. 17.7%, p=.022) and higher CHA2DS2VASc scores (3.63 vs. 2.98, p=0.026) than those not readmitted.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:37:58+00:00'}
