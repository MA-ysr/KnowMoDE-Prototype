 ,{s: 'post-discharge follow-up', t: 'acute care re-utilization', fact: 'f_6afdff3b9df2cb05', doc: 'pubmed/34480653.txt', start: 1137, end: 1444, evidence: 'In retrospective studies and mostly small randomized controlled trials (RCTs), interventions such as inpatient diabetes education, inpatient diabetes management services, transition of care support, and outpatient follow-up are generally associated with a reduction in the risk of acute care re-utilization.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:42:33+00:00'}
 ,{s: 'glycemic control', t: 'hospital readmission within 30 days', fact: 'f_253f7e1861f12e2d', doc: 'pubmed/35257839.txt', start: 2781, end: 3122, evidence: 'Though only moderate associations were seen for the select outcomes of reoperation (6.8), readmission (7.6), and MCID for NRS-Arm pain (6.8), preoperative optimization of HbA1c using these levels as benchmarks should be considered to reduce the risk of complications and maximize PROs for patients undergoing elective cervical spine surgery.', confidence: 0.7, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:45:14+00:00'}
 ,{s: 'diabetes education', t: 'hospital readmission within 30 days', fact: 'f_476d0c409d4565d3', doc: 'pubmed/35690929.txt', start: 1703, end: 1874, evidence: 'Inpatient diabetes education was associated with lower HbA1c at 3 and 6 months after discharge (moderate certainty) and reduced hospital readmissions (very low certainty).', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:46:00+00:00'}
 ,{s: 'diabetes education', t: 'hospital readmission within 30 days', fact: 'f_afeff4bd59dfa146', doc: 'pubmed/35947866.txt', start: 853, end: 997, evidence: 'Patients who received diabetes self-management education or were prescribed both oral and insulin medications were less likely to be readmitted.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:46:51+00:00'}
