 ,{s: 'cognitive impairment', t: 'hospital readmission within 30 days', fact: 'f_419c5c623a038a1d', doc: 'pubmed/42439860.txt', start: 1160, end: 1390, evidence: 'CI exerts a profound impact on clinical outcomes in HF, independently predicting increased all-cause mortality, higher rates of hospitalization and 30-day readmission, impaired self-care capacity, and reduced medication adherence.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:49:41+00:00'}
 ,{s: 'atrial fibrillation', t: 'stroke', fact: 'f_ffa248108ce5043f', doc: 'medlineplus/atrial-fibrillation.txt', start: 774, end: 876, evidence: 'It\'s very important to treat it, since AFib can put you at risk for stroke and other heart conditions.', confidence: 0.95, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:18:24+00:00'}
