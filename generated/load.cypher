 ,{s: 'non-elective pci', t: 'hospital readmission within 30 days', fact: 'f_90483e2d29c40d69', doc: 'pubmed/27839805.txt', start: 1063, end: 1188, evidence: 'Female sex, peripheral vascular disease, diabetes mellitus, renal failure and non-elective PCI are predictive of readmission.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:30:46+00:00'}
 ,{s: 'female gender', t: 'hospital readmission within 30 days', fact: 'f_fdbd2027f512cf0b', doc: 'pubmed/27874940.txt', start: 1613, end: 1783, evidence: 'Multivariate logistic regression analysis showed that non-avoidable readmissions were independently associated with female gender (OR 1.410 [95% CI 1.012-1.964], p=0.042)', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:30:57+00:00'}
 ,{s: 'older age', t: 'hospital readmission within 30 days', fact: 'f_e3b25f8d8c2a98cd', doc: 'pubmed/27874940.txt', start: 1613, end: 1832, evidence: 'Multivariate logistic regression analysis showed that non-avoidable readmissions were independently associated with female gender (OR 1.410 [95% CI 1.012-1.964], p=0.042), and age (OR 1.025 [95% CI 1.006-1.043], p=0.01)', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:30:57+00:00'}
 ,{s: 'older age', t: 'mortality', fact: 'f_dba8d7c629ddbc84', doc: 'pubmed/27874940.txt', start: 1834, end: 2010, evidence: 'while only age (OR 1.034 [95% CI 1.015-1.054], p<0.001) and ERA score (OR 1.047 [95% CI 1.001-1.095], p=0.047) were independently associated with death at the end of follow-up.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:30:57+00:00'}
 ,{s: 'era score', t: 'mortality', fact: 'f_3fea8c9ea4ff283a', doc: 'pubmed/27874940.txt', start: 1834, end: 2010, evidence: 'while only age (OR 1.034 [95% CI 1.015-1.054], p<0.001) and ERA score (OR 1.047 [95% CI 1.001-1.095], p=0.047) were independently associated with death at the end of follow-up.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:30:57+00:00'}
 ,{s: 'failure to acknowledge diabetes transition of care', t: 'hospital readmission within 30 days', fact: 'f_36c81c4b36a60de9', doc: 'pubmed/27881054.txt', start: 402, end: 534, evidence: 'Failure to acknowledge diabetes transition of care is associated with increased emergency department visits and 30-day readmissions.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:31:03+00:00'}
 ,{s: 'older age', t: 'hospital readmission within 30 days', fact: 'f_3423e2cc665c5cd2', doc: 'pubmed/28041771.txt', start: 1397, end: 1518, evidence: 'The only significant finding for the readmission data was an increased rate of readmission for TKA patients of older age.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:31:06+00:00'}
 ,{s: 'predischarge sae', t: 'postdischarge sae and readmission', fact: 'f_1e358f4d3e1db740', doc: 'pubmed/28455179.txt', start: 1536, end: 1787, evidence: 'The most important risk factors for predicting postdischarge SAE and readmission are predischarge SAE, dependent functional status, body mass index >40 kg/m2, smoking, diabetes, chronic steroid use, and American Society of Anesthesiologists class 3/4.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:31:29+00:00'}
