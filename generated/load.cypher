 ,{s: 'inpatient high-dose intravenous and oral glucocorticoid therapy', t: 'postdischarge weight gain', fact: 'f_460532ada6e20bcc', doc: 'pubmed/36367723.txt', start: 2583, end: 2741, evidence: 'Inpatient high-dose intravenous and oral glucocorticoid therapy was associated with postdischarge weight gain (adjusted odds ratio, 6.91; 95% CI, 1.92-24.91).', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:48:53+00:00'}
 ,{s: 'diabetes', t: 'extended inpatient length of stay', fact: 'f_b385ca480a46eb93', doc: 'pubmed/36400342.txt', start: 1929, end: 2361, evidence: 'The predictive model was composed of only preoperative factors, in descending predictive importance as follows: age, marital status, fracture case, ASA (American Society of Anesthesiologists) score, paralysis, electrolyte disorder, body mass index, gender, neurologic disease, coagulation deficiency, diabetes, chronic pulmonary disease, peripheral vascular disease, alcohol dependence, psychoses, smoking status, and revision case.', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:49:20+00:00'}
