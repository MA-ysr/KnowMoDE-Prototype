 ,{s: 'pioglitazone', t: 'nyha class iii or iv heart failure', fact: 'f_61f2719ec6994851', doc: 'openfda/pioglitazone.txt', start: 847, end: 1051, evidence: 'Initiation of pioglitazone in patients with established New York Heart Association (NYHA) Class III or IV heart failure is contraindicated [see Contraindications (4) and Warnings and Precautions (5.1) ] .', confidence: 0.98, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:15:54+00:00'}
 ,{s: 'pioglitazone', t: 'hypersensitivity', fact: 'f_c5cacda6b968b08c', doc: 'openfda/pioglitazone.txt', start: 2987, end: 3094, evidence: 'Use in patients with known hypersensitivity to pioglitazone or any other component of pioglitazone tablets.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:15:54+00:00'}
 ,{s: 'pioglitazone', t: 'bladder cancer', fact: 'f_71826c2d3e93e908', doc: 'openfda/pioglitazone.txt', start: 4255, end: 4305, evidence: 'Do not use in patients with active bladder cancer.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:15:54+00:00'}
 ,{s: 'pioglitazone', t: 'active bladder cancer', fact: 'f_8cfeeae2399d946c', doc: 'openfda/pioglitazone.txt', start: 10043, end: 10298, evidence: 'Consequently, pioglitazone should not be used in patients with active bladder cancer and the benefits of glycemic control versus unknown risks for cancer recurrence with pioglitazone should be considered in patients with a prior history of bladder cancer.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:15:54+00:00'}
 ,{s: 'pioglitazone', t: 'edema', fact: 'f_952522bbbb1996eb', doc: 'openfda/pioglitazone.txt', start: 10588, end: 10652, evidence: 'Pioglitazone should be used with caution in patients with edema.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:15:54+00:00'}
 ,{s: 'pioglitazone', t: 'heart failure', fact: 'f_ba0b10a4bd3c5f9f', doc: 'openfda/pioglitazone.txt', start: 10768, end: 10880, evidence: 'estive heart failure, pioglitazone should be used with caution in patients at risk for congestive heart failure.', confidence: 0.9, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:15:54+00:00'}
 ,{s: 'repaglinide', t: 'diabetes', fact: 'f_c8f6550c55e4545b', doc: 'openfda/repaglinide.txt', start: 408, end: 535, evidence: 'Repaglinide tablets should not be used in patients with type 1 diabetes mellitus or for the treatment of diabetic ketoacidosis.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:17:14+00:00'}
 ,{s: 'repaglinide', t: 'diabetic ketoacidosis', fact: 'f_bf8ffb39dded040b', doc: 'openfda/repaglinide.txt', start: 408, end: 535, evidence: 'Repaglinide tablets should not be used in patients with type 1 diabetes mellitus or for the treatment of diabetic ketoacidosis.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:17:14+00:00'}
 ,{s: 'repaglinide', t: 'impaired liver function', fact: 'f_9f9c91a513b9b617', doc: 'openfda/repaglinide.txt', start: 18830, end: 18920, evidence: 'Therefore, repaglinide should be used cautiously in patients with impaired liver function.', confidence: 0.8, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:17:14+00:00'}
] AS r
MATCH (s:Drug {_key: r.s}), (t:Condition {_key: r.t})
MERGE (s)-[x:CONTRAINDICATED_IN {_prov_fact_id: r.fact}]->(t)
  SET x._prov_source_document = r.doc, x._prov_char_start = r.start, x._prov_char_end = r.end, x._prov_evidence = r.evidence,
      x._prov_confidence = r.confidence, x._prov_prompt_id = r.run, x._prov_run_id = r.runId, x._prov_prompt_hash = r.hash, x._prov_llm_model = r.llm,
      x._prov_policy_version = r.policy, x._prov_extracted_at = r.ts;

UNWIND [
  {s: 'diabetes', t: 'hospital readmission within 30 days', fact: 'f_373a0c3cf57dacec', doc: 'pubmed/18385990.txt', start: 1302, end: 1753, evidence: 'In the multivariate logistic analysis, the variables predicting readmission were acenocoumarol [odds ratio (OR) 12.2, 95% confidence interval (CI) 3.8-38.3, P < 0.0001], a record of diabetes mellitus (OR 2.6, 95% CI 1.3-5.5, P < 0.01), the number of drugs taken at the moment of ADR (OR 1.2, 95% CI 1.1-1.4, P < 0.001) and high blood pressure (OR 0.3, 95% CI 0.2-0.6, P < 0.001) even though the latter was a negative predictor, preventing readmission.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:13:35+00:00'}
 ,{s: 'diabetes', t: 'hospital readmission within 30 days', fact: 'f_15dd11325f616e50', doc: 'pubmed/23063030.txt', start: 280, end: 393, evidence: 'Diabetes, similar to other chronic medical conditions, is associated with increased risk of hospital readmission.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:26:11+00:00'}
 ,{s: 'chronic hyperglycemia', t: 'longer hospital length of stay', fact: 'f_976fee643eea4bda', doc: 'pubmed/24170760.txt', start: 1668, end: 1788, evidence: 'Our study suggests that chronic hyperglycemia (A1C >8%) is associated with poor surgical outcomes (longer hospital LOS).', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:26:39+00:00'}
 ,{s: 'neoplasm', t: 'hospital readmission within 6 months', fact: 'f_0b42ec6dd1feaa32', doc: 'pubmed/24636762.txt', start: 1262, end: 1526, evidence: 'Survival analysis predicting readmission within 6 months after first hospitalization showed that primary factors associated with first readmissions were history of prior hospitalization, malignancy, insulin use, and presence of pre-existing liver or renal disease.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:26:58+00:00'}
 ,{s: 'pre-existing liver or renal disease', t: 'hospital readmission within 6 months', fact: 'f_92f52ac45add3f10', doc: 'pubmed/24636762.txt', start: 1262, end: 1526, evidence: 'Survival analysis predicting readmission within 6 months after first hospitalization showed that primary factors associated with first readmissions were history of prior hospitalization, malignancy, insulin use, and presence of pre-existing liver or renal disease.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:26:58+00:00'}
 ,{s: 'diabetes', t: 'hospital readmission within 90 days', fact: 'f_817622c55971cf57', doc: 'pubmed/25022929.txt', start: 1661, end: 1824, evidence: 'Poor prognostic factors for the cohort of heart failure patients included increased age, diabetes and renal impairment, but not left ventricular ejection fraction.', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:27:13+00:00'}
 ,{s: 'chronic kidney disease', t: 'hospital readmission within 90 days', fact: 'f_583fe6d5758496ed', doc: 'pubmed/25022929.txt', start: 1661, end: 1824, evidence: 'Poor prognostic factors for the cohort of heart failure patients included increased age, diabetes and renal impairment, but not left ventricular ejection fraction.', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:27:13+00:00'}
 ,{s: 'hyperglycemia', t: 'hospital readmission within 28 days', fact: 'f_06f76a9fd9c7c8aa', doc: 'pubmed/25302732.txt', start: 234, end: 430, evidence: 'We previously showed that hyperglycaemia in newly hospitalised medical inpatients is associated with longer length of hospital stay, higher 28-day readmission rates and increased 28-day mortality.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:27:24+00:00'}
 ,{s: 'hyperglycemia', t: 'mortality within 28 days', fact: 'f_51d162d9bd7fa7a5', doc: 'pubmed/25302732.txt', start: 234, end: 430, evidence: 'We previously showed that hyperglycaemia in newly hospitalised medical inpatients is associated with longer length of hospital stay, higher 28-day readmission rates and increased 28-day mortality.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:27:24+00:00'}
 ,{s: 'chronic pulmonary disease', t: 'hospital readmission within 30 days', fact: 'f_22dcc1ebc2b87493', doc: 'pubmed/25437404.txt', start: 1694, end: 2057, evidence: 'This relationship persisted after full adjustment, with the most disadvantaged neighborhoods having a rehospitalization risk (adjusted risk ratio, 1.09 [95% CI, 1.05 to 1.12]) similar to that of chronic pulmonary disease (adjusted risk ratio, 1.06 [CI, 1.04 to 1.08]) and greater than that of uncomplicated diabetes (adjusted risk ratio, 0.95 [CI, 0.94 to 0.97]).', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:27:32+00:00'}
 ,{s: 'cognitive impairment', t: 'hospital readmission within 30 days', fact: 'f_23420cca497fcea7', doc: 'pubmed/25608114.txt', start: 750, end: 1119, evidence: 'Elderly patients with cognitive impairment (adjusted odds ratio [aOR]=1.06, 95% confidence interval [CI]=1.01-1.12), falls and falls risk (aOR=1.15, 95% CI=1.08-1.22), polypharmacy (aOR=1.20, 95% CI=1.14-1.27), and urinary incontinence (aOR=1.08, 95% CI=1.01-1.15) were at higher risk for all-cause 30-day readmission than their counterparts without these complexities.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:27:38+00:00'}
 ,{s: 'urinary incontinence', t: 'hospital readmission within 30 days', fact: 'f_a765b466f07c3902', doc: 'pubmed/25608114.txt', start: 750, end: 1119, evidence: 'Elderly patients with cognitive impairment (adjusted odds ratio [aOR]=1.06, 95% confidence interval [CI]=1.01-1.12), falls and falls risk (aOR=1.15, 95% CI=1.08-1.22), polypharmacy (aOR=1.20, 95% CI=1.14-1.27), and urinary incontinence (aOR=1.08, 95% CI=1.01-1.15) were at higher risk for all-cause 30-day readmission than their counterparts without these complexities.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:27:38+00:00'}
 ,{s: 'peripheral arterial disease', t: 'hospital readmission within 30 days', fact: 'f_6a090785432291bd', doc: 'pubmed/25827965.txt', start: 1897, end: 2081, evidence: 'Multivariable analysis revealed that elective admission (P < .001), peripheral arterial disease (P < .001), and chronic renal insufficiency (P = .001) were associated with readmission.', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:28:07+00:00'}
 ,{s: 'chronic kidney disease', t: 'hospital readmission within 30 days', fact: 'f_258138dc666395ab', doc: 'pubmed/25827965.txt', start: 1897, end: 2081, evidence: 'Multivariable analysis revealed that elective admission (P < .001), peripheral arterial disease (P < .001), and chronic renal insufficiency (P = .001) were associated with readmission.', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:28:07+00:00'}
 ,{s: 'diabetic ketoacidosis', t: 'negative health outcomes', fact: 'f_11987f2fe336922b', doc: 'pubmed/25877049.txt', start: 137, end: 264, evidence: 'Diabetic ketoacidosis (DKA) is associated with negative health outcomes and high costs for patients, families, and communities.', confidence: 0.92, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:28:24+00:00'}
 ,{s: 'diabetes', t: 'hospital readmission within 30 days', fact: 'f_8e1707551f345821', doc: 'pubmed/26093335.txt', start: 1268, end: 1436, evidence: 'Readmission risk was higher in patients who had diabetes, peripheral vascular disease, and longer hospital length of stay, but it did not differ by post-acute care use.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:28:43+00:00'}
