 ,{s: 'insulin', t: 'hypoglycemia', fact: 'f_7327c67cd5cc1f9b', doc: 'openfda/insulin.txt', start: 6945, end: 7050, evidence: 'AFREZZA\'s time action profile impacts the timing of hypoglycemia following inhalation of the drug product', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:11:57+00:00'}
 ,{s: 'insulin', t: 'lung cancer', fact: 'f_8c880fbe2b9b65ac', doc: 'openfda/insulin.txt', start: 10127, end: 10319, evidence: 'In clinical trials, two cases of lung cancer, one in controlled trials and one in uncontrolled trials (2 cases in 2,750 patient-years of exposure), were observed in patients exposed to AFREZZA', confidence: 0.9, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:11:57+00:00'}
