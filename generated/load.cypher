UNWIND [
  {s: 'acarbose', t: 'insulin', fact: 'f_3b83282a859cbb91', doc: 'openfda/acarbose.txt', start: 1514, end: 1678, evidence: 'Because acarbose given in combination with a sulfonylurea or insulin will cause a further lowering of blood glucose, it may increase the potential for hypoglycemia.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:05:09+00:00'}
 ,{s: 'acarbose', t: 'charcoal', fact: 'f_0f651613fdf7eabd', doc: 'openfda/acarbose.txt', start: 5034, end: 5271, evidence: 'Intestinal adsorbents (for example, charcoal) and digestive enzyme preparations containing carbohydrate-splitting enzymes (for example, amylase, pancreatin) may reduce the effect of acarbose tablets and should not be taken concomitantly.', confidence: 0.9, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:05:09+00:00'}
 ,{s: 'acarbose', t: 'digoxin', fact: 'f_a5b53ae2e0eb9134', doc: 'openfda/acarbose.txt', start: 5272, end: 5418, evidence: 'Acarbose tablets has been shown to change the bioavailability of digoxin when they are co administered, which may require digoxin dose adjustment.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:05:09+00:00'}
 ,{s: 'acarbose', t: 'thiazides', fact: 'f_28953df6b54df027', doc: 'openfda/acarbose.txt', start: 12622, end: 12999, evidence: 'These drugs include the thiazides and other diuretics, corticosteroids, phenothiazines, thyroid products, estrogens, oral contraceptives, phenytoin, nicotinic acid, sympathomimetics, calcium channel-blocking drugs, and isoniazid. When such drugs are administered to a patient receiving acarbose tablets, the patient should be closely observed for loss of blood glucose control.', confidence: 0.85, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:05:09+00:00'}
 ,{s: 'acarbose', t: 'phenytoin', fact: 'f_3ff4c25110302cf2', doc: 'openfda/acarbose.txt', start: 12622, end: 12999, evidence: 'These drugs include the thiazides and other diuretics, corticosteroids, phenothiazines, thyroid products, estrogens, oral contraceptives, phenytoin, nicotinic acid, sympathomimetics, calcium channel-blocking drugs, and isoniazid. When such drugs are administered to a patient receiving acarbose tablets, the patient should be closely observed for loss of blood glucose control.', confidence: 0.85, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:05:09+00:00'}
 ,{s: 'acarbose', t: 'nicotinic acid', fact: 'f_30296f0ca1592c4a', doc: 'openfda/acarbose.txt', start: 12622, end: 12999, evidence: 'These drugs include the thiazides and other diuretics, corticosteroids, phenothiazines, thyroid products, estrogens, oral contraceptives, phenytoin, nicotinic acid, sympathomimetics, calcium channel-blocking drugs, and isoniazid. When such drugs are administered to a patient receiving acarbose tablets, the patient should be closely observed for loss of blood glucose control.', confidence: 0.85, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:05:09+00:00'}
 ,{s: 'acarbose', t: 'isoniazid', fact: 'f_7ba9ae5cc77bae31', doc: 'openfda/acarbose.txt', start: 12622, end: 12999, evidence: 'These drugs include the thiazides and other diuretics, corticosteroids, phenothiazines, thyroid products, estrogens, oral contraceptives, phenytoin, nicotinic acid, sympathomimetics, calcium channel-blocking drugs, and isoniazid. When such drugs are administered to a patient receiving acarbose tablets, the patient should be closely observed for loss of blood glucose control.', confidence: 0.85, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:05:09+00:00'}
 ,{s: 'acarbose', t: 'digoxin', fact: 'f_8ed947b2e474ff35', doc: 'openfda/acarbose.txt', start: 13951, end: 14097, evidence: 'Acarbose tablets has been shown to change the bioavailability of digoxin when they are co administered, which may require digoxin dose adjustment.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:05:09+00:00'}
 ,{s: 'glimepiride', t: 'miconazole', fact: 'f_37e602cd6ce173ef', doc: 'openfda/glimepiride.txt', start: 12374, end: 12464, evidence: 'Severe hypoglycemia can occur when glimepiride and oral miconazole are used concomitantly.', confidence: 0.98, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:05:48+00:00'}
 ,{s: 'glimepiride', t: 'colesevelam', fact: 'f_1f92cef8cb4fb2e7', doc: 'openfda/glimepiride.txt', start: 12651, end: 12702, evidence: 'Coadministration may reduce glimepiride absorption.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:05:48+00:00'}
 ,{s: 'glimepiride', t: 'fluconazole', fact: 'f_ae2bdb3bee1f23be', doc: 'openfda/glimepiride.txt', start: 15650, end: 15791, evidence: 'Fluconazole may inhibit the metabolism of glimepiride, causing increased plasma concentrations of glimepiride which may lead to hypoglycemia.', confidence: 0.98, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:05:48+00:00'}
 ,{s: 'glimepiride', t: 'rifampin', fact: 'f_bcac237a173526c4', doc: 'openfda/glimepiride.txt', start: 15792, end: 15943, evidence: 'Rifampin may induce the metabolism of glimepiride, causing decreased plasma concentrations of glimepiride which may lead to worsening glycemic control.', confidence: 0.98, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:05:48+00:00'}
 ,{s: 'glimepiride', t: 'colesevelam', fact: 'f_14b3f7e0fe6d5284', doc: 'openfda/glimepiride.txt', start: 15990, end: 16112, evidence: 'Colesevelam can reduce the maximum plasma concentration and total exposure of glimepiride when the two are coadministered.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:05:48+00:00'}
 ,{s: 'glipizide', t: 'colesevelam', fact: 'f_5763f5f71fa55e80', doc: 'openfda/glipizide-and-metformin.txt', start: 17450, end: 17604, evidence: 'When glipizide ER was administered 4 hours prior to colesevelam, there was no significant change in glipizide AUC 0-∞ or C max , –4% and 0%, respectively.', confidence: 0.9, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:07:00+00:00'}
 ,{s: 'metformin', t: 'furosemide', fact: 'f_ce52eeaf25cb1a7a', doc: 'openfda/glipizide-and-metformin.txt', start: 17830, end: 18006, evidence: 'A single-dose, metformin-furosemide drug interaction study in healthy subjects demonstrated that pharmacokinetic parameters of both compounds were affected by coadministration.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:07:00+00:00'}
 ,{s: 'metformin', t: 'nifedipine', fact: 'f_1484e843abfdccf5', doc: 'openfda/glipizide-and-metformin.txt', start: 18524, end: 18778, evidence: 'A single-dose, metformin-nifedipine drug interaction study in normal healthy volunteers demonstrated that coadministration of nifedipine increased plasma metformin C max and AUC by 20% and 9%, respectively, and increased the amount excreted in the urine.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:07:00+00:00'}
 ,{s: 'metformin', t: 'ranolazine', fact: 'f_c8fa2c6fc4a7e9f8', doc: 'openfda/glipizide-and-metformin.txt', start: 18958, end: 19338, evidence: 'Concomitant use of drugs that interfere with common renal tubular transport systems involved in the renal elimination of metformin (e.g., organic cationic transporter-2 [OCT2] / multidrug and toxin extrusion [MATE] inhibitors such as ranolazine, vandetanib, dolutegravir, and cimetidine) could increase systemic exposure to metformin and may increase the risk for lactic acidosis.', confidence: 0.9, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:07:00+00:00'}
 ,{s: 'metformin', t: 'vandetanib', fact: 'f_0d4abd21f1e26413', doc: 'openfda/glipizide-and-metformin.txt', start: 18958, end: 19338, evidence: 'Concomitant use of drugs that interfere with common renal tubular transport systems involved in the renal elimination of metformin (e.g., organic cationic transporter-2 [OCT2] / multidrug and toxin extrusion [MATE] inhibitors such as ranolazine, vandetanib, dolutegravir, and cimetidine) could increase systemic exposure to metformin and may increase the risk for lactic acidosis.', confidence: 0.9, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:07:00+00:00'}
 ,{s: 'metformin', t: 'dolutegravir', fact: 'f_a7bb6cdd8a754722', doc: 'openfda/glipizide-and-metformin.txt', start: 18958, end: 19338, evidence: 'Concomitant use of drugs that interfere with common renal tubular transport systems involved in the renal elimination of metformin (e.g., organic cationic transporter-2 [OCT2] / multidrug and toxin extrusion [MATE] inhibitors such as ranolazine, vandetanib, dolutegravir, and cimetidine) could increase systemic exposure to metformin and may increase the risk for lactic acidosis.', confidence: 0.9, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:07:00+00:00'}
 ,{s: 'metformin', t: 'cimetidine', fact: 'f_4ccc6f4bac3ab0ca', doc: 'openfda/glipizide-and-metformin.txt', start: 18958, end: 19338, evidence: 'Concomitant use of drugs that interfere with common renal tubular transport systems involved in the renal elimination of metformin (e.g., organic cationic transporter-2 [OCT2] / multidrug and toxin extrusion [MATE] inhibitors such as ranolazine, vandetanib, dolutegravir, and cimetidine) could increase systemic exposure to metformin and may increase the risk for lactic acidosis.', confidence: 0.9, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:07:00+00:00'}
 ,{s: 'metformin', t: 'propranolol', fact: 'f_54a52228d9c3afb9', doc: 'openfda/glipizide-and-metformin.txt', start: 19838, end: 20013, evidence: 'In healthy volunteers, the pharmacokinetics of metformin and propranolol, and metformin and ibuprofen were not affected when coadministered in single-dose interaction studies.', confidence: 0.9, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:07:00+00:00'}
 ,{s: 'metformin', t: 'ibuprofen', fact: 'f_5c891ff9c525c3da', doc: 'openfda/glipizide-and-metformin.txt', start: 19838, end: 20013, evidence: 'In healthy volunteers, the pharmacokinetics of metformin and propranolol, and metformin and ibuprofen were not affected when coadministered in single-dose interaction studies.', confidence: 0.9, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:07:00+00:00'}
 ,{s: 'glipizide and metformin', t: 'thiazides', fact: 'f_97fbfae44cf9532c', doc: 'openfda/glipizide-and-metformin.txt', start: 32149, end: 32551, evidence: 'These drugs include thiazides and other diuretics, corticosteroids, phenothiazines, thyroid products, estrogens, oral contraceptives, phenytoin, nicotinic acid, sympathomimetics, calcium channel blocking drugs, and isoniazid. When such drugs are administered to a patient receiving glipizide and metformin hydrochloride tablets, the patient should be closely observed for loss of blood glucose control.', confidence: 0.85, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:07:00+00:00'}
 ,{s: 'glipizide and metformin', t: 'miconazole', fact: 'f_bd8ec67bc4b9ce6a', doc: 'openfda/glipizide-and-metformin.txt', start: 33984, end: 34110, evidence: 'A potential interaction between oral miconazole and oral hypoglycemic agents leading to severe hypoglycemia has been reported.', confidence: 0.85, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:07:00+00:00'}
 ,{s: 'glipizide', t: 'fluconazole', fact: 'f_11e815419aef6982', doc: 'openfda/glipizide-and-metformin.txt', start: 34231, end: 34384, evidence: 'The effect of concomitant administration of fluconazole and glipizide has been demonstrated in a placebo-controlled crossover study in normal volunteers.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:07:00+00:00'}
 ,{s: 'colesevelam', t: 'glipizide', fact: 'f_84861dffc3787796', doc: 'openfda/glipizide-and-metformin.txt', start: 34625, end: 34875, evidence: 'In studies assessing the effect of colesevelam on the pharmacokinetics of glipizide ER in healthy volunteers, reductions in glipizide AUC 0-∞ and C max of 12% and 13%, respectively, were observed when colesevelam was coadministered with glipizide ER.', confidence: 0.9, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:07:00+00:00'}
 ,{s: 'metformin', t: 'furosemide', fact: 'f_51c1c35581b80e62', doc: 'openfda/glipizide-and-metformin.txt', start: 35256, end: 35432, evidence: 'A single-dose, metformin-furosemide drug interaction study in healthy subjects demonstrated that pharmacokinetic parameters of both compounds were affected by coadministration.', confidence: 0.95, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:07:00+00:00'}
 ,{s: 'metformin', t: 'furosemide', fact: 'f_698a8b27afa46d40', doc: 'openfda/glipizide-and-metformin.txt', start: 35828, end: 35938, evidence: 'No information is available about the interaction of metformin and furosemide when coadministered chronically.', confidence: 0.9, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:07:00+00:00'}
