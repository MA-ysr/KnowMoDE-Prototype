 ,{s: 'diabetes', t: 'first heart failure hospitalization or all-cause death', fact: 'f_615527b296a62fe5', doc: 'pubmed/34666509.txt', start: 1614, end: 1872, evidence: 'The same variables were predictive of outcomes in HF with reduced EF except atrial fibrillation, and also included Northeast Asian location, older age, elevated heart rate, decreased systolic blood pressure, diabetes, smoking, and non-usage of beta blockers.', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:43:20+00:00'}
 ,{s: 'clostridioides difficile infection', t: 'hospital readmission within 30 days', fact: 'f_e728bb2f6eff64e4', doc: 'pubmed/34695277.txt', start: 1204, end: 1467, evidence: 'CDI infection in liver transplant patients was associated with higher 30-day re-admission (14.3% vs. 11.21%, hazard ratio [HR]: 1.14, 95% confidence interval [CI]: 1.01-1.28, p = .02) and in-hospital mortality (odds ratio [OR]: 1.36, 95% CI: 1.14-1.61, p < .001).', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:43:28+00:00'}
 ,{s: 'gastroesophageal reflux disease', t: 'hospital readmission within 30 days', fact: 'f_3ffd740a7bf06598', doc: 'pubmed/34789421.txt', start: 1743, end: 2014, evidence: 'Independent predictors of readmissions included Roux-en-Y gastric bypass (RYGB) (odds ratio [OR] = 1.97, p < .001), Black (OR = 1.46, P < .001) and Hispanic race (OR = 1.14, P < .001), GERD (OR = 1.27, P < .001), HTN (OR = 1.08, P = .003), and IDDM (OR = 1.39, P < .001).', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:43:50+00:00'}
