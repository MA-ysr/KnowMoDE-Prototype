 ,{s: 'pioglitazone', t: 'hypoglycemia', fact: 'f_44bf68d2caafc448', doc: 'openfda/pioglitazone.txt', start: 20656, end: 20929, evidence: 'Table 5. PROactive Trial: Incidence and Types of Adverse Events Reported in > 5% of Patients Treated with Pioglitazone and More Commonly than Placebo Mean duration of patient follow-up was 34.5 months. % of Patients Placebo N=2633 Pioglitazone N=2605 Hypoglycemia 18.8 27.3', confidence: 0.9, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:15:54+00:00'}
