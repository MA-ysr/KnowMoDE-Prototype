 ,{s: 'use insulin for management of hyperglycemia for the majority of hospitalized patients', t: 'insulin', fact: 'f_e96e5e9f03b723d5', doc: 'pubmed/20078323.txt', start: 2847, end: 2959, evidence: 'Insulin is the most appropriate agent for management of hyperglycemia for the majority of hospitalized patients.', confidence: 0.95, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:55:16+00:00'}
 ,{s: 'use intravenous insulin infusion during and immediately after surgery', t: 'insulin', fact: 'f_6ad8e9904a121bb7', doc: 'pubmed/20078323.txt', start: 2960, end: 3044, evidence: 'Intravenous insulin infusion is still preferred during and immediately after surgery', confidence: 0.95, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:55:16+00:00'}
 ,{s: 'use s.c. basal insulin analogs with prandial or correction doses after the immediate post-operative period and in non-critically ill patients', t: 'insulin', fact: 'f_12bcbbc404903255', doc: 'pubmed/20078323.txt', start: 3050, end: 3224, evidence: 's.c. basal insulin analogs with prandial or correction doses should be used after the immediate post-operative period, and also should be used in non-critically ill patients.', confidence: 0.95, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:55:16+00:00'}
 ,{s: 'implement a standardized subcutaneous insulin order set promoting scheduled basal and nutritional insulin therapy for inpatient management of diabetes', t: 'insulin', fact: 'f_786f4a0b3a196ca6', doc: 'pubmed/22223765.txt', start: 1459, end: 1639, evidence: 'Implementing a standardized sc insulin order set promoting the use of scheduled basal and nutritional insulin therapy is a key intervention in the inpatient management of diabetes.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:55:28+00:00'}
 ,{s: 'insulin pump should not be stopped after surgery', t: 'insulin', fact: 'f_df248f76984aa8e6', doc: 'pubmed/31401070.txt', start: 1272, end: 1422, evidence: 'After surgery, insulin pump should not be stopped, basal insulin should be halved, and bolus insulin should be stopped except if severe hyperglycemia.', confidence: 0.85, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:57:17+00:00'}
 ,{s: 'basal insulin should be halved after surgery', t: 'insulin', fact: 'f_4921d0029f920a44', doc: 'pubmed/31401070.txt', start: 1272, end: 1422, evidence: 'After surgery, insulin pump should not be stopped, basal insulin should be halved, and bolus insulin should be stopped except if severe hyperglycemia.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:57:17+00:00'}
 ,{s: 'bolus insulin should be stopped after surgery except if severe hyperglycemia', t: 'insulin', fact: 'f_d61b5c2c4c6e9bcf', doc: 'pubmed/31401070.txt', start: 1272, end: 1422, evidence: 'After surgery, insulin pump should not be stopped, basal insulin should be halved, and bolus insulin should be stopped except if severe hyperglycemia.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:57:17+00:00'}
 ,{s: 'dpp-iv inhibitors and metformin are preferred after surgery', t: 'dpp-iv inhibitor', fact: 'f_2061dbb3264df185', doc: 'pubmed/31401070.txt', start: 1423, end: 1483, evidence: 'DPP-IV inhibitors and metformin are preferred after surgery.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:57:17+00:00'}
 ,{s: 'dpp-iv inhibitors and metformin are preferred after surgery', t: 'metformin', fact: 'f_9da16c557e831b4c', doc: 'pubmed/31401070.txt', start: 1423, end: 1483, evidence: 'DPP-IV inhibitors and metformin are preferred after surgery.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:57:17+00:00'}
 ,{s: 'de-escalate the insulin infusion rate from 0.1 to 0.05 units/kg/h when the glucose concentration drops below 14 mmol/l', t: 'insulin', fact: 'f_82b2174394761040', doc: 'pubmed/35224769.txt', start: 688, end: 1023, evidence: 'The guideline takes into account new evidence on the use of the previous version of this document, particularly the high prevalence of hypoglycaemia and hypokalaemia, and recommends that when the glucose concentration drops below 14 mmol/L, that de-escalating the insulin infusion rate from 0.1 to 0.05 units/kg/h should be considered.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:58:33+00:00'}
 ,{s: 'commence fixed rate intravenous insulin infusion once osmolality stops falling with fluid replacement unless there is ketonaemia', t: 'insulin', fact: 'f_2e445c29f7049496', doc: 'pubmed/36370077.txt', start: 1575, end: 1785, evidence: '(2) fixed rate intravenous insulin infusion (FRIII) should be commenced once osmolality stops falling with fluid replacement unless there is ketonaemia (FRIII should be commenced at the same time as IV fluids).', confidence: 0.95, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:59:03+00:00'}
 ,{s: 'provide potassium replacement according to potassium levels', t: 'potassium', fact: 'f_4de3fde25fb71c26', doc: 'pubmed/36370077.txt', start: 1865, end: 1921, evidence: '(4) potassium replacement according to potassium levels.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:59:03+00:00'}
 ,{s: 'prefer an insulin infusion for acute management of hyperglycemia with titration guided by an explicit clinical decision support tool and frequent monitoring intervals during glycemic instability to minimize hypoglycemia and avoid targeting intensive glucose levels', t: 'insulin', fact: 'f_a0a89828375c27fd', doc: 'pubmed/38240484.txt', start: 2907, end: 3271, evidence: 'The guidelines panel achieved consensus for adults and children regarding a preference for an insulin infusion for the acute management of hyperglycemia with titration guided by an explicit clinical decision support tool and frequent (≤ 1 hr) monitoring intervals during glycemic instability to minimize hypoglycemia and against targeting intensive glucose levels.', confidence: 0.92, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T19:00:33+00:00'}
 ,{s: 'recommend potent statins combined with ezetimibe and, if necessary, other lipid-lowering drugs for patients at hospital discharge after an ischaemic cardiovascular event', t: 'statins', fact: 'f_74adfda0e8e21261', doc: 'pubmed/39551547.txt', start: 706, end: 904, evidence: 'Strategies include rigorous control of lipid levels, recommending potent statins combined with ezetimibe and, if necessary, other drugs such as inclisiran, evolocumab, alirocumab, or bempedoic acid.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T19:01:17+00:00'}
 ,{s: 'recommend potent statins combined with ezetimibe and, if necessary, other lipid-lowering drugs for patients at hospital discharge after an ischaemic cardiovascular event', t: 'ezetimibe', fact: 'f_0e02e7148735a067', doc: 'pubmed/39551547.txt', start: 706, end: 904, evidence: 'Strategies include rigorous control of lipid levels, recommending potent statins combined with ezetimibe and, if necessary, other drugs such as inclisiran, evolocumab, alirocumab, or bempedoic acid.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T19:01:17+00:00'}
 ,{s: 'recommend potent statins combined with ezetimibe and, if necessary, other lipid-lowering drugs for patients at hospital discharge after an ischaemic cardiovascular event', t: 'inclisiran', fact: 'f_e2eff666418fcfaf', doc: 'pubmed/39551547.txt', start: 706, end: 904, evidence: 'Strategies include rigorous control of lipid levels, recommending potent statins combined with ezetimibe and, if necessary, other drugs such as inclisiran, evolocumab, alirocumab, or bempedoic acid.', confidence: 0.85, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T19:01:17+00:00'}
 ,{s: 'recommend potent statins combined with ezetimibe and, if necessary, other lipid-lowering drugs for patients at hospital discharge after an ischaemic cardiovascular event', t: 'evolocumab', fact: 'f_55f066d880ab34d9', doc: 'pubmed/39551547.txt', start: 706, end: 904, evidence: 'Strategies include rigorous control of lipid levels, recommending potent statins combined with ezetimibe and, if necessary, other drugs such as inclisiran, evolocumab, alirocumab, or bempedoic acid.', confidence: 0.85, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T19:01:17+00:00'}
