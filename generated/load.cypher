 ,{s: 'prior inpatient admissions', t: 'hospital readmission within 30 days', fact: 'f_dec9af1248886e13', doc: 'pubmed/25712258.txt', start: 639, end: 861, evidence: 'Risk factors for readmission in this population include lower socioeconomic status, racial/ethnic minority, comorbidity burden, public insurance, emergent or urgent admission, and a history of recent prior hospitalization.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:27:53+00:00'}
 ,{s: 'elective admission', t: 'hospital readmission within 30 days', fact: 'f_e18ba8f5b418b717', doc: 'pubmed/25827965.txt', start: 1897, end: 2081, evidence: 'Multivariable analysis revealed that elective admission (P < .001), peripheral arterial disease (P < .001), and chronic renal insufficiency (P = .001) were associated with readmission.', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:28:07+00:00'}
 ,{s: 'prior inpatient admissions', t: 'hospital readmission within 30 days', fact: 'f_5e2ac6a46e9fcde6', doc: 'pubmed/26042761.txt', start: 497, end: 1234, evidence: 'In this retrospective study, we identify factors associated with readmission within 30 days based on claims and administrative data of nine hospitals from 2005 to 2012. We present a data inclusion and exclusion criteria to identify potentially preventable readmissions. Multivariate logistic regression models and a Cox proportional hazards extension are used to estimate the readmission risk for 4 chronic conditions (congestive heart failure [CHF], chronic obstructive pulmonary disease [COPD], acute myocardial infarction, and type 2 diabetes) and pneumonia, known to be related to high readmission rates. Accumulated number of admissions and discharge disposition were identified to be significant factors across most disease groups.', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:28:33+00:00'}
 ,{s: 'discharge disposition', t: 'hospital readmission within 30 days', fact: 'f_a36ee3695ba9ffaf', doc: 'pubmed/26042761.txt', start: 497, end: 1234, evidence: 'In this retrospective study, we identify factors associated with readmission within 30 days based on claims and administrative data of nine hospitals from 2005 to 2012. We present a data inclusion and exclusion criteria to identify potentially preventable readmissions. Multivariate logistic regression models and a Cox proportional hazards extension are used to estimate the readmission risk for 4 chronic conditions (congestive heart failure [CHF], chronic obstructive pulmonary disease [COPD], acute myocardial infarction, and type 2 diabetes) and pneumonia, known to be related to high readmission rates. Accumulated number of admissions and discharge disposition were identified to be significant factors across most disease groups.', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:28:33+00:00'}
 ,{s: 'higher severity index', t: 'hospital readmission within 30 days', fact: 'f_dc7ca5b6ce148183', doc: 'pubmed/26042761.txt', start: 1235, end: 1331, evidence: 'Larger odds of readmission were associated with higher severity index for CHF and COPD patients.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:28:33+00:00'}
 ,{s: 'length of hospital stay', t: 'hospital readmission within 30 days', fact: 'f_74d947b667d90e11', doc: 'pubmed/26093335.txt', start: 1268, end: 1436, evidence: 'Readmission risk was higher in patients who had diabetes, peripheral vascular disease, and longer hospital length of stay, but it did not differ by post-acute care use.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:28:43+00:00'}
 ,{s: 'admission a1c >= 6.5% or < 5.7%', t: 'hospital readmission within 1 year', fact: 'f_5f49a0fa5c1186eb', doc: 'pubmed/26246595.txt', start: 1367, end: 1549, evidence: 'Patients with A1C ≥6.5% or <5.7% were more likely to be readmitted for any reason within 1 year (33.3% and 31.6%, respectively) than patients with A1C levels of 5.7% to 6.4% (16.5%).', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:28:49+00:00'}
 ,{s: 'discharge to a skilled nursing facility', t: 'hospital readmission within 30 days', fact: 'f_f19542c3b754a95c', doc: 'pubmed/26483156.txt', start: 1344, end: 1423, evidence: 'Nursing home discharge was the only independent predictor of early readmission.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:29:04+00:00'}
 ,{s: 'length of hospital stay', t: 'late readmission', fact: 'f_165395f11401074b', doc: 'pubmed/26483156.txt', start: 1424, end: 1534, evidence: 'Diabetes mellitus and increased length of the index admission were independent predictors of late readmission.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:29:04+00:00'}
 ,{s: 'medicaid funding', t: 'hospital readmission within 30 days', fact: 'f_aed97efc7dbb07ae', doc: 'pubmed/26496096.txt', start: 2076, end: 2142, evidence: 'Having Medicaid funding increased the odds of readmission by 274%.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:29:11+00:00'}
 ,{s: 'higher body mass index', t: 'hospital readmission within 30 days', fact: 'f_9a6e87b822101462', doc: 'pubmed/26539950.txt', start: 1422, end: 1661, evidence: 'The risk factors for 30-day readmission were higher body mass index (BMI), lower body temperature, higher blood urea nitrogen, higher creatinine, more cirrhosis-related complications, and more readmissions per year per univariate analysis.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:29:16+00:00'}
