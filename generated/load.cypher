 ,{s: 'hba1c < 6.0%', t: 'diabetes', fact: 'f_917824033ad5f481', doc: 'pubmed/41191374.txt', start: 1808, end: 2048, evidence: 'In those patients with diabetes, risk of any complication increased progressively from near normal (HbA1c level <6.0%; odds ratio [OR], 1.06; 95% CI, 1.00-1.11) to very poor glycemic control (HbA1c level >9.0%; OR, 1.32; 95% CI, 1.25-1.39).', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:48:05+00:00'}
 ,{s: 'hba1c > 9.0%', t: 'diabetes', fact: 'f_a67d195b04865575', doc: 'pubmed/41191374.txt', start: 1808, end: 2048, evidence: 'In those patients with diabetes, risk of any complication increased progressively from near normal (HbA1c level <6.0%; odds ratio [OR], 1.06; 95% CI, 1.00-1.11) to very poor glycemic control (HbA1c level >9.0%; OR, 1.32; 95% CI, 1.25-1.39).', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:48:05+00:00'}
 ,{s: 'glucose < 70 mg/dl', t: 'hypoglycemia', fact: 'f_2122b0a4ece168a5', doc: 'pubmed/42036160.txt', start: 785, end: 900, evidence: 'Hypoglycemia, defined as glucose less than 70 mg/dL, continues to pose a major barrier to optimal glycemic control.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:48:46+00:00'}
 ,{s: 'blood glucose < 70 mg/dl', t: 'hypoglycemia', fact: 'f_9a462ea175e5bb0c', doc: 'medlineplus/hypoglycemia.txt', start: 817, end: 901, evidence: 'For many people with diabetes, this means a blood glucose level lower than 70 mg/dL.', confidence: 0.9, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:23:11+00:00'}
 ,{s: 'blood glucose < 55 mg/dl', t: 'hypoglycemia', fact: 'f_542c73b6714a0a67', doc: 'medlineplus/hypoglycemia.txt', start: 1028, end: 1132, evidence: 'For people who don\'t have diabetes, hypoglycemia is typically a blood glucose level lower than 55 mg/dL.', confidence: 0.9, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:23:11+00:00'}
