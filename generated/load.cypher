 ,{s: 'american society of anesthesiologists class 3/4', t: 'postdischarge sae and readmission', fact: 'f_c8c4b1c9360966d4', doc: 'pubmed/28455179.txt', start: 1536, end: 1787, evidence: 'The most important risk factors for predicting postdischarge SAE and readmission are predischarge SAE, dependent functional status, body mass index >40 kg/m2, smoking, diabetes, chronic steroid use, and American Society of Anesthesiologists class 3/4.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:31:29+00:00'}
 ,{s: 'cannabis use', t: 'hospital readmission within 30 days', fact: 'f_7529754c923b4ff0', doc: 'pubmed/29107164.txt', start: 1257, end: 1432, evidence: 'In multivariable analysis, cannabis use and diabetes were predictors of both 30-day and 90-day readmission and older patients were uniquely susceptible to 30-day readmissions.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:31:56+00:00'}
 ,{s: 'cannabis use', t: 'hospital readmission within 90 days', fact: 'f_ca530d493d60fb65', doc: 'pubmed/29107164.txt', start: 1257, end: 1432, evidence: 'In multivariable analysis, cannabis use and diabetes were predictors of both 30-day and 90-day readmission and older patients were uniquely susceptible to 30-day readmissions.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:31:56+00:00'}
 ,{s: 'medicare insurance', t: 'hospital readmission within 90 days', fact: 'f_e6e05c4ae9a13c53', doc: 'pubmed/29107164.txt', start: 1433, end: 1673, evidence: 'Risk factors for 90-day readmission included Medicare insurance, hypothyroidism, initial discharge to skilled nursing facility, and several index complications including bowel obstruction, gastrostomy, acute lung injury, and cerebral edema.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:31:56+00:00'}
 ,{s: 'discharge to a skilled nursing facility', t: 'hospital readmission within 90 days', fact: 'f_47237f6237cf6dd6', doc: 'pubmed/29107164.txt', start: 1433, end: 1673, evidence: 'Risk factors for 90-day readmission included Medicare insurance, hypothyroidism, initial discharge to skilled nursing facility, and several index complications including bowel obstruction, gastrostomy, acute lung injury, and cerebral edema.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:31:56+00:00'}
 ,{s: 'low frequency of glucose monitoring', t: 'inpatient hyperglycemia', fact: 'f_97f444c6d3e7b1b7', doc: 'pubmed/29357807.txt', start: 1320, end: 1520, evidence: 'The identified significant positive correlates for inpatient hyperglycemia, were the use of insulin sliding scale alone (OR=16.438 ± 6.765-39.941, p=0.001) and the low frequency of glucose monitoring.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:32:22+00:00'}
 ,{s: 'measuring glucose every 8 hours', t: 'inpatient hyperglycemia', fact: 'f_d50edef29411bfc2', doc: 'pubmed/29357807.txt', start: 1521, end: 1680, evidence: 'Measuring glucose every 8 hours (OR= 3.583 ± 1.506-8.524, p=0.004) and/or every 12 hours (OR=7.647 ± 0.704-79.231, p=0.0095) was associated with hyperglycemia.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:32:22+00:00'}
 ,{s: 'measuring glucose every 12 hours', t: 'inpatient hyperglycemia', fact: 'f_c798c4100aa382f0', doc: 'pubmed/29357807.txt', start: 1521, end: 1680, evidence: 'Measuring glucose every 8 hours (OR= 3.583 ± 1.506-8.524, p=0.004) and/or every 12 hours (OR=7.647 ± 0.704-79.231, p=0.0095) was associated with hyperglycemia.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:32:22+00:00'}
