] AS e
MERGE (n:Condition {_key: e.key})
  ON CREATE SET n.name = e.idValue, n += e.props
  ON MATCH SET n += e.props
SET n._modifiable = e.modifiable, n._plain_label = e.plainLabel
WITH n, e
MATCH (d:SourceDocument {id: e.doc})
MERGE (n)-[x:EXTRACTED_FROM {_prov_char_start: e.start, _prov_char_end: e.end}]->(d)
  SET x._prov_mention = e.mention, x._prov_confidence = e.confidence, x._prov_prompt_id = e.prompt, x._prov_run_id = e.run, x._prov_extraction_task = e.task, x._prov_normalized_from = e.normalizedFrom
WITH n, e
MATCH (r:ExtractionRun {runId: e.run})
MERGE (n)-[:PRODUCED_BY]->(r);

