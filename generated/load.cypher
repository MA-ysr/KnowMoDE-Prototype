 ,{s: 'diabetes', t: 'hospital readmission within 30 days', fact: 'f_854e5f0906478cc1', doc: 'pubmed/34936910.txt', start: 2172, end: 2546, evidence: 'Within the AMI with SLE cohort, the independent predictors of readmission were diabetes mellitus (aOR = 1.38 CI 0.99-1.91, P = 0.054), peripheral vascular disease (aOR = 2.10 CI 1.22-3.62, P = 0.007), anemia (aOR = 1.50 CI 1.07-2.11, P = 0.019), end-stage renal disease (aOR = 1.91 CI 1.10-3.31, P = 0.021), and congestive heart failure (aOR = 1.55 CI 1.12-2.16, P = 0.009).', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:44:16+00:00'}
