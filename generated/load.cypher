 ,{s: 'diabetic eye problems', t: 'blindness', fact: 'f_a7d6a72929ab185f', doc: 'medlineplus/diabetic-eye-problems.txt', start: 674, end: 778, evidence: 'This can lead to serious diabetic eye problems which can harm your vision and sometimes cause blindness.', confidence: 0.9, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:20:48+00:00'}
 ,{s: 'diabetic retinopathy', t: 'vision loss', fact: 'f_d98bb543502699a6', doc: 'medlineplus/diabetic-eye-problems.txt', start: 1065, end: 1241, evidence: 'If it\'s not treated, it can cause serious problems such as vision loss and retinal detachment, where the retina is pulled away from its normal position at the back of your eye.', confidence: 0.9, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:20:48+00:00'}
 ,{s: 'diabetes', t: 'heart disease', fact: 'f_11c09918cbb3c6b4', doc: 'medlineplus/diabetic-heart-disease.txt', start: 628, end: 753, evidence: 'If you have diabetes, you are much more likely to develop heart disease or have a stroke than people who don\'t have diabetes.', confidence: 0.95, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:21:13+00:00'}
