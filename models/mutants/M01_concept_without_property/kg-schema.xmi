<?xml version="1.0" encoding="UTF-8"?>
<!--
  M1 model 1/5: KG Schema of the diabetes 30-day readmission use case (conforms to xaikg::kgschema).
  Single source of schema truth (R1): prompts (T4), graph DDL (T1/T3), validator (T2), loader (T5)
  and the explanation service (T6) are all derived from this file.
-->
<kgschema:KGSchemaDefinition
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:kgschema="http://www.xaikg.org/1.0/kgschema"
    name="DiabetesReadmissionKG"
    nsURI="http://www.xaikg.org/usecases/diabetes-readmission"
    description="Clinical knowledge grounding a 30-day hospital readmission risk model for inpatients with diabetes. Built from FDA drug labels, MedlinePlus health topics and the biomedical literature (public sources only).">

  <!-- ============================ Concepts ============================ -->
  <concepts name="Drug" uri="http://www.xaikg.org/usecases/diabetes-readmission#Drug"
      description="A medication, identified by its generic (INN) name, e.g. metformin, insulin glargine, glipizide.">
    <properties name="name" dataType="STRING" isRequired="true" isExplainable="true" description="Generic name in lowercase, e.g. 'metformin'"/>
    <properties name="drugClass" dataType="STRING" isRequired="false" isExplainable="true" description="Pharmacological class, e.g. 'biguanide', 'sulfonylurea', 'insulin'"/>
    <properties name="rxnormCui" dataType="STRING" isRequired="false" isExplainable="false" description="RxNorm concept identifier if stated"/>
    <canonicalEntities name="insulin" isModifiable="true" plainLabel="insulin" pattern="^(human |regular |basal |bolus |premixed |exogenous |subcutaneous |intravenous )?insulin( human| glargine| lispro| aspart| detemir| degludec| glulisine| isophane| therapy| analog(ue)?s?| sliding scale| regimen)?$|^nph[- ]insulin$|^basal-bolus insulin$">
      <aliases>insulin human</aliases>
      <aliases>human insulin</aliases>
      <aliases>regular human insulin</aliases>
      <aliases>regular insulin</aliases>
      <aliases>nph-insulin</aliases>
      <aliases>nph insulin</aliases>
      <aliases>neutral protamine hagedorn insulin</aliases>
      <aliases>insulin glargine</aliases>
      <aliases>insulin lispro</aliases>
      <aliases>insulin aspart</aliases>
      <aliases>insulin detemir</aliases>
      <aliases>basal insulin</aliases>
      <aliases>basal-bolus insulin</aliases>
      <aliases>sliding scale insulin</aliases>
      <aliases>insulin sliding scale</aliases>
      <aliases>insulin therapy</aliases>
      <aliases>insulin analogs</aliases>
      <aliases>insulin analogues</aliases>
      <aliases>exogenous insulin</aliases>
      <aliases>insulin isophane</aliases>
      <aliases>premixed insulin</aliases>
    </canonicalEntities>
    <canonicalEntities name="metformin" isModifiable="true" plainLabel="metformin, a diabetes medicine">
      <aliases>metformin hydrochloride</aliases>
      <aliases>metformin hcl</aliases>
      <aliases>glucophage</aliases>
      <aliases>biguanide metformin</aliases>
    </canonicalEntities>
    <canonicalEntities name="glyburide and metformin" isModifiable="true" plainLabel="glyburide with metformin, a combined diabetes medicine">
      <aliases>glyburide and metformin hydrochloride</aliases>
      <aliases>glyburide-metformin</aliases>
      <aliases>glyburide/metformin</aliases>
      <aliases>glucovance</aliases>
    </canonicalEntities>
    <canonicalEntities name="glipizide and metformin" isModifiable="true" plainLabel="glipizide with metformin, a combined diabetes medicine">
      <aliases>glipizide and metformin hydrochloride</aliases>
      <aliases>glipizide-metformin</aliases>
      <aliases>glipizide/metformin</aliases>
      <aliases>metaglip</aliases>
    </canonicalEntities>
    <canonicalEntities name="glipizide" isModifiable="true" plainLabel="glipizide, a diabetes medicine">
      <aliases>glucotrol</aliases>
      <aliases>glipizide tablets</aliases>
    </canonicalEntities>
    <canonicalEntities name="glyburide" isModifiable="true" plainLabel="glyburide, a diabetes medicine">
      <aliases>glibenclamide</aliases>
      <aliases>micronase</aliases>
      <aliases>diabeta</aliases>
      <aliases>glynase</aliases>
    </canonicalEntities>
    <canonicalEntities name="glimepiride" isModifiable="true" plainLabel="glimepiride, a diabetes medicine">
      <aliases>amaryl</aliases>
    </canonicalEntities>
    <canonicalEntities name="pioglitazone" isModifiable="true" plainLabel="pioglitazone, a diabetes medicine">
      <aliases>actos</aliases>
      <aliases>pioglitazone hydrochloride</aliases>
    </canonicalEntities>
    <canonicalEntities name="rosiglitazone" isModifiable="true" plainLabel="rosiglitazone, a diabetes medicine">
      <aliases>avandia</aliases>
      <aliases>rosiglitazone maleate</aliases>
    </canonicalEntities>
    <canonicalEntities name="repaglinide" isModifiable="true" plainLabel="repaglinide, a diabetes medicine">
      <aliases>prandin</aliases>
    </canonicalEntities>
    <canonicalEntities name="nateglinide" isModifiable="true" plainLabel="nateglinide, a diabetes medicine">
      <aliases>starlix</aliases>
    </canonicalEntities>
    <canonicalEntities name="acarbose" isModifiable="true" plainLabel="acarbose, a diabetes medicine">
      <aliases>precose</aliases>
    </canonicalEntities>
    <canonicalEntities name="miglitol" isModifiable="true" plainLabel="miglitol, a diabetes medicine">
      <aliases>glyset</aliases>
    </canonicalEntities>
    <canonicalEntities name="chlorpropamide" isModifiable="true" plainLabel="chlorpropamide, an older diabetes medicine">
      <aliases>diabinese</aliases>
    </canonicalEntities>
    <canonicalEntities name="sglt2 inhibitors" isModifiable="true" plainLabel="SGLT2 inhibitor medicines, a newer class of diabetes medicines">
      <aliases>sglt2i</aliases>
      <aliases>sglt-2i</aliases>
      <aliases>sglt2 inhibitor</aliases>
      <aliases>sglt-2 inhibitor</aliases>
      <aliases>sglt-2 inhibitors</aliases>
      <aliases>sglt2-inhibitors</aliases>
      <aliases>sodium-glucose cotransporter-2 inhibitor</aliases>
      <aliases>sodium-glucose cotransporter-2 inhibitors</aliases>
      <aliases>sodium-glucose cotransporter 2 inhibitor</aliases>
      <aliases>sodium-glucose cotransporter 2 inhibitors</aliases>
      <aliases>sodium glucose cotransporter 2 inhibitors</aliases>
      <aliases>sodium-glucose co-transporter 2 inhibitors</aliases>
    </canonicalEntities>
    <canonicalEntities name="glp-1 receptor agonists" isModifiable="true" plainLabel="GLP-1 receptor agonist medicines, a newer class of diabetes medicines">
      <aliases>glucagon-like peptide-1 receptor agonists</aliases>
      <aliases>glucagon-like peptide-1 receptor agonist</aliases>
      <aliases>glp-1 receptor agonist</aliases>
      <aliases>glp-1 ra</aliases>
      <aliases>glp-1 ras</aliases>
      <aliases>glp-1ra</aliases>
      <aliases>glp1 receptor agonists</aliases>
      <aliases>glp-1 agonists</aliases>
    </canonicalEntities>
  </concepts>

  <concepts name="DrugClass" uri="http://www.xaikg.org/usecases/diabetes-readmission#DrugClass"
      description="A pharmacological class of medications, e.g. sulfonylureas, thiazolidinediones, insulins.">
    
  </concepts>

  <concepts name="Condition" uri="http://www.xaikg.org/usecases/diabetes-readmission#Condition"
      description="A disease, disorder, symptom or clinical state, e.g. hypoglycemia, heart failure, chronic kidney disease, poor glycemic control.">
    <properties name="name" dataType="STRING" isRequired="true" isExplainable="true" description="Condition name in lowercase, e.g. 'hypoglycemia'"/>
    <properties name="icd9Range" dataType="STRING" isRequired="false" isExplainable="false" description="ICD-9-CM code or range if stated, e.g. '428' or '390-459'"/>
    <properties name="category" dataType="STRING" isRequired="false" isExplainable="true" description="Body system or category, e.g. 'circulatory', 'metabolic', 'renal'"/>
    <canonicalEntities name="heart failure" plainLabel="heart failure, when the heart does not pump as well as it should">
      <aliases>congestive heart failure</aliases>
      <aliases>chf</aliases>
      <aliases>chronic heart failure</aliases>
      <aliases>acute heart failure</aliases>
      <aliases>acute congestive heart failure</aliases>
      <aliases>acute decompensated heart failure</aliases>
      <aliases>cardiac failure</aliases>
      <aliases>heart failure (hf)</aliases>
      <aliases>decompensated heart failure</aliases>
      <aliases>hf</aliases>
    </canonicalEntities>
    <canonicalEntities name="chronic kidney disease" plainLabel="long-term kidney disease">
      <aliases>ckd</aliases>
      <aliases>kidney disease</aliases>
      <aliases>chronic renal disease</aliases>
      <aliases>chronic renal insufficiency</aliases>
      <aliases>chronic renal failure</aliases>
      <aliases>renal insufficiency</aliases>
      <aliases>renal impairment</aliases>
      <aliases>kidney failure</aliases>
      <aliases>renal failure</aliases>
      <aliases>end-stage renal disease</aliases>
      <aliases>esrd</aliases>
      <aliases>diabetic kidney disease</aliases>
      <aliases>diabetic nephropathy</aliases>
      <aliases>renal disease</aliases>
      <aliases>impaired renal function</aliases>
      <aliases>reduced kidney function</aliases>
    </canonicalEntities>
    <canonicalEntities name="diabetes" plainLabel="diabetes">
      <aliases>diabetes mellitus</aliases>
      <aliases>type 2 diabetes</aliases>
      <aliases>type 2 diabetes mellitus</aliases>
      <aliases>t2dm</aliases>
      <aliases>type ii diabetes</aliases>
      <aliases>type 2 dm</aliases>
      <aliases>dm</aliases>
      <aliases>diabetes mellitus type 2</aliases>
      <aliases>type-2 diabetes</aliases>
      <aliases>type 1 diabetes</aliases>
      <aliases>type 1 diabetes mellitus</aliases>
      <aliases>t1dm</aliases>
      <aliases>diabetic patients</aliases>
      <aliases>diabetes mellitus (dm)</aliases>
    </canonicalEntities>
    <canonicalEntities name="hypoglycemia" plainLabel="low blood sugar">
      <aliases>hypoglycaemia</aliases>
      <aliases>low blood sugar</aliases>
      <aliases>low blood glucose</aliases>
      <aliases>severe hypoglycemia</aliases>
      <aliases>severe hypoglycaemia</aliases>
      <aliases>hypoglycemic events</aliases>
      <aliases>hypoglycemic episodes</aliases>
      <aliases>hypoglycemic reactions</aliases>
      <aliases>hypoglycemic shock</aliases>
      <aliases>symptomatic hypoglycemia</aliases>
      <aliases>hypoglycemic event</aliases>
      <aliases>hypoglycaemic events</aliases>
      <aliases>prolonged severe hypoglycemia</aliases>
      <aliases>recurrent hypoglycemia</aliases>
      <aliases>hypoglycemic episode</aliases>
    </canonicalEntities>
    <canonicalEntities name="poor glycemic control" plainLabel="blood sugar that is not well controlled">
      <aliases>poorly controlled type 2 diabetes</aliases>
      <aliases>uncontrolled type 2 diabetes</aliases>
      <aliases>poorly controlled type 1 diabetes</aliases>
      <aliases>poorly controlled diabetes</aliases>
      <aliases>uncontrolled diabetes</aliases>
      <aliases>poor glycaemic control</aliases>
      <aliases>inadequate glycemic control</aliases>
      <aliases>suboptimal glycemic control</aliases>
      <aliases>poor baseline glycemic control</aliases>
      <aliases>worsening glycemic control</aliases>
      <aliases>poorly controlled blood sugar</aliases>
      <aliases>uncontrolled hyperglycemia</aliases>
      <aliases>poor diabetes control</aliases>
      <aliases>not well controlled diabetes</aliases>
    </canonicalEntities>
    <canonicalEntities name="hyperglycemia" plainLabel="high blood sugar">
      <aliases>persistent hyperglycemia</aliases>
      <aliases>stress hyperglycemia</aliases>
      <aliases>hospital hyperglycemia</aliases>
      <aliases>hyperglycaemia</aliases>
      <aliases>high blood sugar</aliases>
      <aliases>high blood glucose</aliases>
      <aliases>elevated blood glucose</aliases>
      <aliases>severe hyperglycemia</aliases>
      <aliases>inpatient hyperglycemia</aliases>
      <aliases>admission hyperglycemia</aliases>
    </canonicalEntities>
    <canonicalEntities name="circulatory disease" plainLabel="heart or blood vessel disease">
      <aliases>cardiovascular disease</aliases>
      <aliases>circulatory system disease</aliases>
      <aliases>diseases of the circulatory system</aliases>
      <aliases>cardiovascular diseases</aliases>
      <aliases>cardiovascular disorder</aliases>
      <aliases>heart disease</aliases>
      <aliases>coronary heart disease</aliases>
      <aliases>coronary artery disease</aliases>
      <aliases>ischemic heart disease</aliases>
      <aliases>atherosclerotic cardiovascular disease</aliases>
      <aliases>cardiac disease</aliases>
      <aliases>hypertension</aliases>
      <aliases>high blood pressure</aliases>
      <aliases>stroke</aliases>
    </canonicalEntities>
    <canonicalEntities name="respiratory disease" plainLabel="lung or breathing problems">
      <aliases>pulmonary disease</aliases>
      <aliases>respiratory disorder</aliases>
      <aliases>diseases of the respiratory system</aliases>
      <aliases>chronic obstructive pulmonary disease</aliases>
      <aliases>copd</aliases>
      <aliases>pneumonia</aliases>
      <aliases>respiratory infection</aliases>
      <aliases>lung disease</aliases>
    </canonicalEntities>
    <canonicalEntities name="digestive disease" plainLabel="stomach, bowel or liver problems">
      <aliases>gastrointestinal disease</aliases>
      <aliases>diseases of the digestive system</aliases>
      <aliases>gastrointestinal disorder</aliases>
      <aliases>digestive system disease</aliases>
      <aliases>liver disease</aliases>
      <aliases>hepatic impairment</aliases>
      <aliases>gastroparesis</aliases>
    </canonicalEntities>
    <canonicalEntities name="injury and poisoning" plainLabel="an injury or a poisoning">
      <aliases>injury</aliases>
      <aliases>poisoning</aliases>
      <aliases>trauma</aliases>
      <aliases>injuries</aliases>
      <aliases>fracture</aliases>
      <aliases>fractures</aliases>
      <aliases>falls</aliases>
      <aliases>fall</aliases>
    </canonicalEntities>
    <canonicalEntities name="musculoskeletal disease" plainLabel="bone, joint or muscle problems">
      <aliases>musculoskeletal disorder</aliases>
      <aliases>diseases of the musculoskeletal system</aliases>
      <aliases>arthritis</aliases>
      <aliases>osteoarthritis</aliases>
      <aliases>osteoporosis</aliases>
    </canonicalEntities>
    <canonicalEntities name="genitourinary disease" plainLabel="kidney, bladder or urinary problems">
      <aliases>genitourinary disorder</aliases>
      <aliases>diseases of the genitourinary system</aliases>
      <aliases>urinary tract infection</aliases>
      <aliases>uti</aliases>
      <aliases>urinary tract infections</aliases>
    </canonicalEntities>
    <canonicalEntities name="neoplasm" plainLabel="a tumour or cancer">
      <aliases>cancer</aliases>
      <aliases>malignancy</aliases>
      <aliases>neoplasms</aliases>
      <aliases>tumor</aliases>
      <aliases>tumour</aliases>
      <aliases>malignant neoplasm</aliases>
      <aliases>carcinoma</aliases>
    </canonicalEntities>
    <canonicalEntities name="diabetic foot ulcer" plainLabel="a sore or wound on the foot caused by diabetes">
      <aliases>diabetic foot ulcers</aliases>
      <aliases>plantar diabetic foot ulcer</aliases>
      <aliases>diabetic foot</aliases>
      <aliases>diabetic foot infection</aliases>
      <aliases>diabetes-related foot ulcer</aliases>
    </canonicalEntities>
  </concepts>

  <concepts name="LabTest" uri="http://www.xaikg.org/usecases/diabetes-readmission#LabTest"
      description="A laboratory measurement with a clinically meaningful level, e.g. 'HbA1c > 8%', 'serum glucose > 300 mg/dL'.">
    <properties name="name" dataType="STRING" isRequired="true" isExplainable="true" description="Test and level, e.g. 'HbA1c > 8%'"/>
    <properties name="abnormalThreshold" dataType="STRING" isRequired="false" isExplainable="true" description="Threshold that makes the result abnormal, e.g. '> 7%'"/>
    <canonicalEntities name="HbA1c &gt; 8%" plainLabel="a high average blood sugar level (HbA1c above 8%)" pattern="^(hb)?a1c ?(&gt;|&gt;=|≥|above|over|greater than) ?8(\.0)?%?$|^(elevated|high|higher|raised) (hb)?a1c( levels?)?$|^(elevated|high|higher) glycated (hemoglobin|haemoglobin)( levels?)?$">
      <aliases>a1c &gt; 8</aliases>
      <aliases>a1c &gt;8%</aliases>
      <aliases>hba1c &gt;8%</aliases>
      <aliases>hba1c above 8%</aliases>
      <aliases>a1c above 8%</aliases>
      <aliases>glycated hemoglobin &gt; 8%</aliases>
      <aliases>hba1c &gt; 8</aliases>
      <aliases>a1c greater than 8%</aliases>
      <aliases>elevated hba1c</aliases>
      <aliases>high hba1c</aliases>
      <aliases>elevated a1c</aliases>
      <aliases>high a1c</aliases>
      <aliases>poorly controlled hba1c</aliases>
      <aliases>hemoglobin a1c &gt; 8%</aliases>
      <aliases>hba1c &gt;= 8%</aliases>
      <aliases>a1c &gt;= 8%</aliases>
    </canonicalEntities>
    <canonicalEntities name="HbA1c &gt; 7%" plainLabel="an above-target average blood sugar level (HbA1c above 7%)" pattern="^(hb)?a1c ?(&gt;|&gt;=|≥|above|over|greater than) ?7(\.0)?%?$">
      <aliases>a1c &gt; 7</aliases>
      <aliases>a1c &gt;7%</aliases>
      <aliases>hba1c &gt;7%</aliases>
      <aliases>hba1c above 7%</aliases>
      <aliases>a1c above 7%</aliases>
      <aliases>hba1c &gt; 7</aliases>
      <aliases>hba1c &gt;= 7%</aliases>
      <aliases>a1c &gt;= 7%</aliases>
      <aliases>hemoglobin a1c &gt; 7%</aliases>
    </canonicalEntities>
    <canonicalEntities name="HbA1c normal" plainLabel="a normal average blood sugar level (HbA1c)">
      <aliases>normal a1c</aliases>
      <aliases>normal hba1c</aliases>
      <aliases>a1c in normal range</aliases>
      <aliases>hba1c within target</aliases>
      <aliases>a1c &lt; 7%</aliases>
      <aliases>hba1c &lt; 7%</aliases>
      <aliases>a1c at goal</aliases>
    </canonicalEntities>
    <canonicalEntities name="serum glucose &gt; 300 mg/dL" plainLabel="a very high blood sugar reading" pattern="^(serum |blood |plasma )?glucose ?(&gt;|&gt;=|≥|above|over) ?300( mg/dl)?$">
      <aliases>glucose &gt; 300 mg/dl</aliases>
      <aliases>serum glucose &gt;= 300 mg/dl</aliases>
      <aliases>blood glucose &gt; 300 mg/dl</aliases>
      <aliases>glucose above 300 mg/dl</aliases>
      <aliases>glucose &gt;300</aliases>
    </canonicalEntities>
    <canonicalEntities name="serum glucose &gt; 200 mg/dL" plainLabel="a high blood sugar reading" pattern="^(serum |blood |plasma |random )?glucose ?(&gt;|&gt;=|≥|above|over) ?200( mg/dl)?$">
      <aliases>glucose &gt; 200 mg/dl</aliases>
      <aliases>blood glucose &gt; 200 mg/dl</aliases>
      <aliases>glucose above 200 mg/dl</aliases>
      <aliases>random glucose &gt;200 mg/dl</aliases>
      <aliases>hyperglycemia &gt; 200 mg/dl</aliases>
    </canonicalEntities>
    <canonicalEntities name="serum glucose normal" plainLabel="a normal blood sugar reading">
      <aliases>normal glucose</aliases>
      <aliases>normal blood glucose</aliases>
      <aliases>normal serum glucose</aliases>
      <aliases>normoglycemia</aliases>
    </canonicalEntities>
  </concepts>

  <concepts name="RiskFactor" uri="http://www.xaikg.org/usecases/diabetes-readmission#RiskFactor"
      description="A patient-level or utilisation factor that changes the probability of a clinical outcome, e.g. prior inpatient admissions, number of emergency visits, insulin dose change, discharge to a nursing facility.">
    <properties name="name" dataType="STRING" isRequired="true" isExplainable="true" description="Short factor name in lowercase, e.g. 'prior inpatient admissions'"/>
    <properties name="description" dataType="STRING" isRequired="false" isExplainable="true" description="One sentence, as stated in the source"/>
    <canonicalEntities name="prior inpatient admissions" plainLabel="several hospital stays in the past year" pattern="^(a )?(higher |greater |increased )?(number of )?(prior|previous|recent|past) (inpatient |hospital )?(admissions?|visits?|hospitali[sz]ations?)( in the (past|preceding|previous) year)?$">
      <aliases>prior inpatient visits</aliases>
      <aliases>number of prior inpatient visits</aliases>
      <aliases>previous hospitalization</aliases>
      <aliases>previous hospitalizations</aliases>
      <aliases>history of recent prior hospitalization</aliases>
      <aliases>history of readmissions</aliases>
      <aliases>prior hospitalization</aliases>
      <aliases>prior hospitalizations</aliases>
      <aliases>recent hospitalization</aliases>
      <aliases>accumulated number of admissions</aliases>
      <aliases>more readmissions per year</aliases>
      <aliases>previous admissions</aliases>
      <aliases>prior admissions</aliases>
      <aliases>number of inpatient visits</aliases>
      <aliases>higher number of prior inpatient visits</aliases>
      <aliases>frequent hospitalizations</aliases>
    </canonicalEntities>
    <canonicalEntities name="prior emergency visits" plainLabel="earlier emergency department visits" pattern="^(a )?(higher |greater |increased )?(number of )?(prior |previous |recent |frequent )?(emergency|ed|er)( department| room)? visits?( in the (past|preceding|previous) year)?$">
      <aliases>emergency department visits</aliases>
      <aliases>prior emergency department visits</aliases>
      <aliases>number of emergency visits</aliases>
      <aliases>previous emergency visits</aliases>
      <aliases>frequent emergency department visits</aliases>
      <aliases>emergency room visits</aliases>
      <aliases>prior ed visits</aliases>
    </canonicalEntities>
    <canonicalEntities name="prior outpatient visits" plainLabel="earlier outpatient clinic visits">
      <aliases>outpatient visits</aliases>
      <aliases>number of outpatient visits</aliases>
      <aliases>previous outpatient visits</aliases>
    </canonicalEntities>
    <canonicalEntities name="length of hospital stay" plainLabel="a long hospital stay" pattern="^(a )?(longer |increased |prolonged |extended |greater )?(hospital )?length of (hospital )?stay.*$">
      <aliases>longer hospital length of stay</aliases>
      <aliases>hospital length of stay</aliases>
      <aliases>increased length of index admission</aliases>
      <aliases>length of stay</aliases>
      <aliases>longer length of stay</aliases>
      <aliases>prolonged hospital stay</aliases>
      <aliases>prolonged length of stay</aliases>
      <aliases>long hospital stay</aliases>
      <aliases>length of stay after index admission</aliases>
      <aliases>initial hospitalization of 8 days or longer</aliases>
      <aliases>length of stay greater than 4 days</aliases>
      <aliases>longer hospitalization</aliases>
    </canonicalEntities>
    <canonicalEntities name="polypharmacy" isModifiable="true" plainLabel="taking many different medicines">
      <aliases>high medication burden</aliases>
      <aliases>number of medications</aliases>
      <aliases>multiple medications</aliases>
      <aliases>many medications</aliases>
      <aliases>high number of medications</aliases>
      <aliases>medication regimen complexity</aliases>
      <aliases>medication count</aliases>
      <aliases>increased number of medications</aliases>
    </canonicalEntities>
    <canonicalEntities name="multiple comorbidities" plainLabel="having several health conditions at the same time">
      <aliases>comorbidity burden</aliases>
      <aliases>number of comorbidities</aliases>
      <aliases>comorbidities</aliases>
      <aliases>multimorbidity</aliases>
      <aliases>high comorbidity burden</aliases>
      <aliases>number of diagnoses</aliases>
      <aliases>higher number of diagnoses</aliases>
      <aliases>multiple chronic conditions</aliases>
    </canonicalEntities>
    <canonicalEntities name="high number of laboratory procedures" plainLabel="many laboratory tests during the hospital stay">
      <aliases>number of laboratory procedures</aliases>
      <aliases>number of lab tests</aliases>
      <aliases>many laboratory tests</aliases>
    </canonicalEntities>
    <canonicalEntities name="inpatient procedures" plainLabel="procedures during the hospital stay">
      <aliases>number of procedures</aliases>
      <aliases>inpatient operation</aliases>
      <aliases>surgical procedures</aliases>
      <aliases>procedures during hospitalization</aliases>
    </canonicalEntities>
    <canonicalEntities name="older age" plainLabel="older age" pattern="^(older|increased|increasing|advanced|advancing|old|higher) age$|^age( ?(&gt;|&gt;=|≥|over|above) ?\d+( years)?)?$|^(elderly|older adults?|older patients?)$">
      <aliases>age</aliases>
      <aliases>increased age</aliases>
      <aliases>increasing age</aliases>
      <aliases>advanced age</aliases>
      <aliases>old age</aliases>
      <aliases>elderly</aliases>
      <aliases>age &gt;70</aliases>
