 ,{s: 'repaglinide', t: 'hyperglycemia', fact: 'f_582e60a3e35ce3f8', doc: 'openfda/repaglinide.txt', start: 5385, end: 5496, evidence: 'The most common adverse reactions leading to withdrawal were hyperglycemia, hypoglycemia, and related symptoms.', confidence: 0.9, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:17:14+00:00'}
 ,{s: 'repaglinide', t: 'myocardial ischemia', fact: 'f_c8bbd9b747dc335c', doc: 'openfda/repaglinide.txt', start: 7842, end: 7973, evidence: 'There were six serious adverse events of myocardial ischemia in patients treated with repaglinide plus NPH-insulin from two studies', confidence: 0.85, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:17:14+00:00'}
 ,{s: 'repaglinide', t: 'hypoglycemia', fact: 'f_9530aae6f7a6dce4', doc: 'openfda/repaglinide.txt', start: 8150, end: 8450, evidence: 'During 24-week treatment clinical trials of repaglinide-rosiglitazone or repaglinide-pioglitazone combination therapy (a total of 250 patients in combination therapy), hypoglycemia (blood glucose < 50 mg/dL) occurred in 7% of patients in combination therapy compared to 7% for repaglinide monotherapy', confidence: 0.85, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:17:14+00:00'}
 ,{s: 'repaglinide', t: 'peripheral edema', fact: 'f_f96fedd83db9fac3', doc: 'openfda/repaglinide.txt', start: 8529, end: 8641, evidence: 'Peripheral edema was reported in 12 out of 250 (4.8%) repaglinide-thiazolidinedione combination therapy patients', confidence: 0.85, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:17:14+00:00'}
 ,{s: 'repaglinide', t: 'heart failure', fact: 'f_b50189bcc3130aea', doc: 'openfda/repaglinide.txt', start: 8774, end: 8923, evidence: 'There were reports in 2 of 250 patients (0.8%) treated with repaglinide-thiazolidinedione therapy of episodes of edema with congestive heart failure.', confidence: 0.85, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:17:14+00:00'}
 ,{s: 'repaglinide', t: 'thrombocytopenia', fact: 'f_c1e71da4fc7b4ba0', doc: 'openfda/repaglinide.txt', start: 9431, end: 9600, evidence: 'Less common adverse clinical or laboratory events observed in clinical trials included elevated liver enzymes, thrombocytopenia, leukopenia, and anaphylactoid reactions.', confidence: 0.85, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:17:14+00:00'}
 ,{s: 'repaglinide', t: 'leukopenia', fact: 'f_00a770aa9906a0f4', doc: 'openfda/repaglinide.txt', start: 9431, end: 9600, evidence: 'Less common adverse clinical or laboratory events observed in clinical trials included elevated liver enzymes, thrombocytopenia, leukopenia, and anaphylactoid reactions.', confidence: 0.85, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:17:14+00:00'}
 ,{s: 'repaglinide', t: 'anaphylactoid reactions', fact: 'f_871416aa652a1d30', doc: 'openfda/repaglinide.txt', start: 9431, end: 9600, evidence: 'Less common adverse clinical or laboratory events observed in clinical trials included elevated liver enzymes, thrombocytopenia, leukopenia, and anaphylactoid reactions.', confidence: 0.85, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:17:14+00:00'}
 ,{s: 'repaglinide', t: 'hypoglycemia', fact: 'f_00f9ad0b61108848', doc: 'openfda/repaglinide.txt', start: 16884, end: 17006, evidence: 'Because of the potential for hypoglycemia in breastfed infants, repaglinide is not recommended for use when breastfeeding.', confidence: 0.85, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:17:14+00:00'}
 ,{s: 'antihyperglycemic agents', t: 'hypoglycemia', fact: 'f_99486aefa00805cc', doc: 'pubmed/33880952.txt', start: 235, end: 339, evidence: 'Hospitalized patients who are receiving antihyperglycemic agents are at increased risk for hypoglycemia.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:41:19+00:00'}
 ,{s: 'sulfonylurea', t: 'circulatory disease', fact: 'f_cd161965ca177bdf', doc: 'pubmed/34232594.txt', start: 602, end: 767, evidence: 'In fact, two groups of diabetic medications, dual peroxisome-proliferator-activated receptor - agonists and sulfonylurea, are known to worsen cardiovascular disease.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:41:55+00:00'}
 ,{s: 'insulin', t: 'hypoglycemia', fact: 'f_7973ad45a934da64', doc: 'pubmed/37689412.txt', start: 1531, end: 1669, evidence: 'The IV protocols had significantly more hypoglycemic events compared with the SQ protocol (IVB vs. SQ, p < 0.001; IVNB vs. SQ, p = 0.001).', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:41:47+00:00'}
 ,{s: 'sglt2 inhibitors', t: 'diabetic ketoacidosis', fact: 'f_c2ee5ddad5b31701', doc: 'pubmed/38428527.txt', start: 1554, end: 1729, evidence: 'It is important to choose patients appropriately and hold these drugs when patients are without nutrition or on low-carbohydrate diets which can lead to diabetic ketoacidosis.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:43:51+00:00'}
 ,{s: 'sglt2 inhibitors', t: 'chronic kidney disease', fact: 'f_09f1ab009e2c34ed', doc: 'pubmed/40449290.txt', start: 1802, end: 1986, evidence: 'Importantly, adverse effects such as renal impairment, electrolyte disturbances, acid-base imbalances, urinary tract infections, and dysglycemia appear infrequently in this population.', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:46:23+00:00'}
