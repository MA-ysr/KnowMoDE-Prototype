 ,{s: 'inpatient diabetes specialist care', t: 'hospital readmission within 30 days', fact: 'f_bb7c2981fb6de255', doc: 'pubmed/35947866.txt', start: 711, end: 852, evidence: 'Patients with more comorbidities, who were Hispanics, and those who received an endocrinology consultation were more likely to be readmitted.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:46:51+00:00'}
 ,{s: 'potentially inappropriate medications', t: 'hospital readmission within 30 days', fact: 'f_7893f456a5c7428a', doc: 'pubmed/36203703.txt', start: 246, end: 408, evidence: 'Potentially inappropriate medications had been found associated with adverse drug events such as falls, emergency department admissions and hospital readmissions.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:47:43+00:00'}
 ,{s: 'young age', t: 'hyperglycemia readmission', fact: 'f_9a989c58666f31b0', doc: 'pubmed/36220515.txt', start: 1089, end: 1309, evidence: 'The significant predictors of hyperglycemia readmissions included young age, smoking, hypoglycemia, higher effective osmolality, and hyperthyroidism in the DKA group and higher glycated hemoglobin level in the HHS group.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:48:23+00:00'}
 ,{s: 'smoking', t: 'hyperglycemia readmission', fact: 'f_3972a018f4bfdf80', doc: 'pubmed/36220515.txt', start: 1089, end: 1309, evidence: 'The significant predictors of hyperglycemia readmissions included young age, smoking, hypoglycemia, higher effective osmolality, and hyperthyroidism in the DKA group and higher glycated hemoglobin level in the HHS group.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:48:23+00:00'}
