 ,{s: 'heart failure', t: 'mortality', fact: 'f_ebe962744c25a90a', doc: 'pubmed/39874177.txt', start: 1473, end: 1580, evidence: 'Patients who developed HF had higher risk of death and hospitalizations (all P < .001), irrespective of EF.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:45:47+00:00'}
