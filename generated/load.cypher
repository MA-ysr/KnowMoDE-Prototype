 ,{s: 'discharge to a skilled nursing facility', t: 'hospital readmission within 30 days', fact: 'f_4626f0e35ae55462', doc: 'pubmed/25611424.txt', start: 1234, end: 1537, evidence: 'Pre-existing pulmonary disease (odds ratio [OR], 1.885; 95% confidence interval [CI], 1.305-2.724), initial hospitalization of 8 days or longer (OR, 1.853; 95% CI, 1.223-2.807), and discharge to a skilled nursing facility (OR, 1.586; 95% CI, 1.043-2.413) were determined to be predictors of readmission.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:27:45+00:00'}
