UNWIND [
  {s: 'use early identification of patients in need of education, implementation of a clinical pathway, and clear instructions about medications and follow-up appointments to ensure an effective diabetes discharge', t: 'diabetes education', fact: 'f_1971bddf79251e1f', doc: 'pubmed/19364697.txt', start: 1372, end: 1632, evidence: 'Strategies that can be used to ensure an effective diabetes discharge are early identification of patients in need of education, implementation of a clinical pathway, and clear instructions about medications and follow-up appointments at the time of discharge.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:55:09+00:00'}
 ,{s: 'use early identification of patients in need of education, implementation of a clinical pathway, and clear instructions about medications and follow-up appointments to ensure an effective diabetes discharge', t: 'implementation of a clinical pathway', fact: 'f_6ea3f3238439e6dc', doc: 'pubmed/19364697.txt', start: 1372, end: 1632, evidence: 'Strategies that can be used to ensure an effective diabetes discharge are early identification of patients in need of education, implementation of a clinical pathway, and clear instructions about medications and follow-up appointments at the time of discharge.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:55:09+00:00'}
 ,{s: 'use early identification of patients in need of education, implementation of a clinical pathway, and clear instructions about medications and follow-up appointments to ensure an effective diabetes discharge', t: 'post-discharge follow-up', fact: 'f_5acff96970e18c3b', doc: 'pubmed/19364697.txt', start: 1372, end: 1632, evidence: 'Strategies that can be used to ensure an effective diabetes discharge are early identification of patients in need of education, implementation of a clinical pathway, and clear instructions about medications and follow-up appointments at the time of discharge.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:55:09+00:00'}
 ,{s: 'implement a standardized subcutaneous insulin order set promoting scheduled basal and nutritional insulin therapy for inpatient management of diabetes', t: 'scheduled basal and nutritional insulin therapy', fact: 'f_b7c77ac09c618caf', doc: 'pubmed/22223765.txt', start: 1459, end: 1639, evidence: 'Implementing a standardized sc insulin order set promoting the use of scheduled basal and nutritional insulin therapy is a key intervention in the inpatient management of diabetes.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:55:28+00:00'}
 ,{s: 'use custom therapeutic footwear in high-risk diabetic patients', t: 'custom therapeutic footwear', fact: 'f_fead7a4fc0e47124', doc: 'pubmed/26804367.txt', start: 1580, end: 1745, evidence: 'We recommend using custom therapeutic footwear in high-risk diabetic patients, including those with significant neuropathy, foot deformities, or previous amputation.', confidence: 0.92, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:55:48+00:00'}
 ,{s: 'off-load plantar diabetic foot ulcers with a total contact cast or irremovable fixed ankle walking boot', t: 'off-loading', fact: 'f_2e53b7144deb6be2', doc: 'pubmed/26804367.txt', start: 1746, end: 1889, evidence: 'In patients with plantar diabetic foot ulcer (DFU), we recommend off-loading with a total contact cast or irremovable fixed ankle walking boot.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:55:48+00:00'}
 ,{s: 'perform revascularization by surgical bypass or endovascular therapy in patients with dfu and peripheral arterial disease', t: 'revascularization', fact: 'f_adbbacca8793393a', doc: 'pubmed/26804367.txt', start: 2314, end: 2454, evidence: 'In patients with DFU who have peripheral arterial disease, we recommend revascularization by either surgical bypass or endovascular therapy.', confidence: 0.93, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:55:48+00:00'}
 ,{s: 'identify potential barriers to medication access and continuity of care early in the hospitalization', t: 'barriers to medication access', fact: 'f_2a43230a4c33278d', doc: 'pubmed/28573408.txt', start: 526, end: 639, evidence: 'Potential barriers to medication access and continuity of care should be identified early in the hospitalization.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:56:17+00:00'}
 ,{s: 'provide diabetes education focused on basic survival skills and tailored to learning needs throughout hospitalization', t: 'diabetes education', fact: 'f_94774d8a3488c21f', doc: 'pubmed/28573408.txt', start: 640, end: 775, evidence: 'Throughout hospitalization, patients should receive diabetes education focused on basic survival skills and tailored to learning needs.', confidence: 0.92, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:56:17+00:00'}
 ,{s: 'provide personalized discharge instructions including a list of all medications and follow-up appointments with outpatient diabetes provider and diabetes educator', t: 'post-discharge follow-up', fact: 'f_bfa971effd11ee09', doc: 'pubmed/28573408.txt', start: 776, end: 1003, evidence: 'Patients should leave the hospital with personalized discharge instructions that include a list of all medications and follow-up appointments with both the outpatient diabetes provider and a diabetes educator whenever possible.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:56:17+00:00'}
 ,{s: 'patients should be seen by a diabetologist within one month if on oral antidiabetic agents', t: 'post-discharge follow-up', fact: 'f_e9e1dcd0233bd138', doc: 'pubmed/31401070.txt', start: 1484, end: 1719, evidence: 'Patients should be seen by a diabetologist within one month if on oral antidiabetic agents (71.8% of experts), 2 weeks if on injectable treatments (77.1% of experts), and immediately after surgery if on insulin pump (93.5% of experts).', confidence: 0.85, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:57:17+00:00'}
 ,{s: 'patients should be seen by a diabetologist within 2 weeks if on injectable treatments', t: 'post-discharge follow-up', fact: 'f_949758ec810ec470', doc: 'pubmed/31401070.txt', start: 1484, end: 1719, evidence: 'Patients should be seen by a diabetologist within one month if on oral antidiabetic agents (71.8% of experts), 2 weeks if on injectable treatments (77.1% of experts), and immediately after surgery if on insulin pump (93.5% of experts).', confidence: 0.85, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:57:17+00:00'}
 ,{s: 'patients should be seen by a diabetologist immediately after surgery if on an insulin pump', t: 'post-discharge follow-up', fact: 'f_69f8e04756e42216', doc: 'pubmed/31401070.txt', start: 1484, end: 1719, evidence: 'Patients should be seen by a diabetologist within one month if on oral antidiabetic agents (71.8% of experts), 2 weeks if on injectable treatments (77.1% of experts), and immediately after surgery if on insulin pump (93.5% of experts).', confidence: 0.85, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:57:17+00:00'}
 ,{s: 'those undergoing bariatric surgery should be informed of the possibility of developing postprandial hyperinsulinaemic hypoglycaemia.', t: 'diabetes education', fact: 'f_6013ab48be099df9', doc: 'pubmed/36424342.txt', start: 995, end: 1100, evidence: 'Those undergoing bariatric surgery should be informed of the possibility of developing this complication.', confidence: 0.85, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:59:14+00:00'}
 ,{s: 'lifestyle intervention is the first step of treatment for obesity', t: 'lifestyle intervention', fact: 'f_572b98760c6042a2', doc: 'pubmed/37291604.txt', start: 651, end: 705, evidence: 'Lifestyle intervention is the first step of treatment.', confidence: 0.95, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:59:48+00:00'}
 ,{s: 'pharmacotherapy is the second step in children older than 12 years', t: 'pharmacotherapy', fact: 'f_fbf57ab1544b1e83', doc: 'pubmed/37291604.txt', start: 706, end: 833, evidence: 'In children older than 12 years, pharmacotherapy is the second step, and bariatric surgery is the third one, in selected cases.', confidence: 0.92, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:59:48+00:00'}
 ,{s: 'bariatric surgery is the third step in selected cases', t: 'bariatric surgery', fact: 'f_205b956f436b265a', doc: 'pubmed/37291604.txt', start: 706, end: 833, evidence: 'In children older than 12 years, pharmacotherapy is the second step, and bariatric surgery is the third one, in selected cases.', confidence: 0.94, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T18:59:48+00:00'}
 ,{s: 'prefer an insulin infusion for acute management of hyperglycemia with titration guided by an explicit clinical decision support tool and frequent monitoring intervals during glycemic instability to minimize hypoglycemia and avoid targeting intensive glucose levels', t: 'frequent monitoring intervals', fact: 'f_d4e26819623180ac', doc: 'pubmed/38240484.txt', start: 2907, end: 3271, evidence: 'The guidelines panel achieved consensus for adults and children regarding a preference for an insulin infusion for the acute management of hyperglycemia with titration guided by an explicit clinical decision support tool and frequent (≤ 1 hr) monitoring intervals during glycemic instability to minimize hypoglycemia and against targeting intensive glucose levels.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T19:00:33+00:00'}
 ,{s: 'patients should receive structured education on blood glucose monitoring, nutritional strategies, and recognition and management of hypoglycemia', t: 'diabetes education', fact: 'f_20f0f0fed577841e', doc: 'pubmed/42036164.txt', start: 270, end: 415, evidence: 'Patients should receive structured education on blood glucose monitoring, nutritional strategies, and recognition and management of hypoglycemia.', confidence: 0.9, run: 'guideline_extraction@9a20634981a4', runId: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', hash: '9a20634981a4d5610008f111dfa602adaad743c48baa8bd5b7384c8b98fb8af1', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-11-01T19:02:19+00:00'}
] AS r
