UNWIND [
  {s: 'acenocoumarol', t: 'hospital readmission within 30 days', fact: 'f_278d6524c7d34707', doc: 'pubmed/18385990.txt', start: 1302, end: 1753, evidence: 'In the multivariate logistic analysis, the variables predicting readmission were acenocoumarol [odds ratio (OR) 12.2, 95% confidence interval (CI) 3.8-38.3, P < 0.0001], a record of diabetes mellitus (OR 2.6, 95% CI 1.3-5.5, P < 0.01), the number of drugs taken at the moment of ADR (OR 1.2, 95% CI 1.1-1.4, P < 0.001) and high blood pressure (OR 0.3, 95% CI 0.2-0.6, P < 0.001) even though the latter was a negative predictor, preventing readmission.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:13:35+00:00'}
 ,{s: 'insulin', t: 'hospital readmission within 6 months', fact: 'f_1c96495f699f5308', doc: 'pubmed/24636762.txt', start: 1262, end: 1526, evidence: 'Survival analysis predicting readmission within 6 months after first hospitalization showed that primary factors associated with first readmissions were history of prior hospitalization, malignancy, insulin use, and presence of pre-existing liver or renal disease.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:26:58+00:00'}
 ,{s: 'warfarin', t: 'adverse health outcomes after discharge', fact: 'f_b7373e6a28dc1638', doc: 'pubmed/28452063.txt', start: 1378, end: 1612, evidence: 'Additionally, single studies also found associations of adverse health outcomes with different drug classes {e.g. warfarin [hazard ratio 1.50; odds ratio (OR) 3.52], furosemide [OR 2.25] or high beta-blocker starting doses [OR 3.10]}.', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:31:22+00:00'}
 ,{s: 'furosemide', t: 'adverse health outcomes after discharge', fact: 'f_f487d9a7357f1ecd', doc: 'pubmed/28452063.txt', start: 1378, end: 1612, evidence: 'Additionally, single studies also found associations of adverse health outcomes with different drug classes {e.g. warfarin [hazard ratio 1.50; odds ratio (OR) 3.52], furosemide [OR 2.25] or high beta-blocker starting doses [OR 3.10]}.', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:31:22+00:00'}
 ,{s: 'anticoagulant', t: 'hospital readmission within 90 days', fact: 'f_abd140a8d0e72e74', doc: 'pubmed/28578845.txt', start: 1445, end: 1545, evidence: 'Patients taking anticoagulants, narcotics, insulin, and antiplatelets had greater readmission rates.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:31:38+00:00'}
 ,{s: 'narcotic', t: 'hospital readmission within 90 days', fact: 'f_d3253a2a69767c0b', doc: 'pubmed/28578845.txt', start: 1445, end: 1545, evidence: 'Patients taking anticoagulants, narcotics, insulin, and antiplatelets had greater readmission rates.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:31:38+00:00'}
 ,{s: 'insulin', t: 'hospital readmission within 90 days', fact: 'f_1b538f7cedd4247f', doc: 'pubmed/28578845.txt', start: 1445, end: 1545, evidence: 'Patients taking anticoagulants, narcotics, insulin, and antiplatelets had greater readmission rates.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:31:38+00:00'}
 ,{s: 'antiplatelet', t: 'hospital readmission within 90 days', fact: 'f_d8df887712bb9f41', doc: 'pubmed/28578845.txt', start: 1445, end: 1545, evidence: 'Patients taking anticoagulants, narcotics, insulin, and antiplatelets had greater readmission rates.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:31:38+00:00'}
 ,{s: 'insulin', t: 'inpatient hyperglycemia', fact: 'f_10ff1ef2882df4b6', doc: 'pubmed/29357807.txt', start: 1320, end: 1520, evidence: 'The identified significant positive correlates for inpatient hyperglycemia, were the use of insulin sliding scale alone (OR=16.438 ± 6.765-39.941, p=0.001) and the low frequency of glucose monitoring.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:32:22+00:00'}
 ,{s: 'lactulose', t: 'recurrent clostridioides difficile infection', fact: 'f_d7e64439ce6b0c43', doc: 'pubmed/32675703.txt', start: 1326, end: 1522, evidence: 'Independent risk factors of R-CDI included increased Charlson Comorbidity Index (hazard ratio [HR] 1.30; 95% confidence interval [CI]: 1.09-1.55) and use of lactulose (HR 2.58; 95% CI: 1.09-6.09).', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:39:09+00:00'}
 ,{s: 'sulfonylurea', t: 'heart failure readmission rates', fact: 'f_e65d7df5b254515f', doc: 'pubmed/34232594.txt', start: 768, end: 906, evidence: 'Patients using this group of medications have shown increased heart failure readmission rates and increased risk for cardiovascular death.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:41:55+00:00'}
 ,{s: 'statin', t: 'hospital readmission within 30 days', fact: 'f_8c373b5664299b42', doc: 'pubmed/38937276.txt', start: 2083, end: 2389, evidence: 'Understanding predictors of readmission after initial hospitalization for COVID-19, including older age, lower eGFR, comorbidities, ICU admission, mechanical ventilation, statin use and DKA but not HbA1c, glycemic gap or BMI, can help guide treatment approaches and future research in adults with diabetes.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:44:27+00:00'}
] AS r
MATCH (s:Drug {_key: r.s}), (t:ClinicalOutcome {_key: r.t})
MERGE (s)-[x:INCREASES_RISK_OF {_prov_fact_id: r.fact}]->(t)
  SET x._prov_source_document = r.doc, x._prov_char_start = r.start, x._prov_char_end = r.end, x._prov_evidence = r.evidence,
      x._prov_confidence = r.confidence, x._prov_prompt_id = r.run, x._prov_run_id = r.runId, x._prov_prompt_hash = r.hash, x._prov_llm_model = r.llm,
      x._prov_policy_version = r.policy, x._prov_extracted_at = r.ts;

UNWIND [
  {s: 'polypharmacy', t: 'hospital readmission within 30 days', fact: 'f_384afcdaef8e6822', doc: 'pubmed/18385990.txt', start: 1302, end: 1753, evidence: 'In the multivariate logistic analysis, the variables predicting readmission were acenocoumarol [odds ratio (OR) 12.2, 95% confidence interval (CI) 3.8-38.3, P < 0.0001], a record of diabetes mellitus (OR 2.6, 95% CI 1.3-5.5, P < 0.01), the number of drugs taken at the moment of ADR (OR 1.2, 95% CI 1.1-1.4, P < 0.001) and high blood pressure (OR 0.3, 95% CI 0.2-0.6, P < 0.001) even though the latter was a negative predictor, preventing readmission.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:13:35+00:00'}
 ,{s: 'recreational drug use', t: 'hospital readmission within 30 days', fact: 'f_cebf86e80a44262a', doc: 'pubmed/21136122.txt', start: 1440, end: 1558, evidence: 'Adverse profile, most significantly in readmission to hospital, was found in the patients with positive drug findings.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:25:57+00:00'}
 ,{s: 'diabetes', t: 'hospital readmission within 30 days', fact: 'f_69e37217475663bb', doc: 'pubmed/24447543.txt', start: 965, end: 1327, evidence: 'A point-based scoring system was developed with the use of factors predictive for readmission, including procedure type; discharge destination; race; non-elective presentation; pulmonary, renal, and cardiac comorbidities; diabetes; steroid use; hypoalbuminemia; anemia; venothromboembolism before discharge; graft failure before discharge; and bleeding disorder.', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:26:48+00:00'}
 ,{s: 'polypharmacy', t: 'hospital readmission within 1 year', fact: 'f_39a8a7f04801311e', doc: 'pubmed/24467719.txt', start: 1148, end: 1360, evidence: 'After adjusting for potential confounders, participants in the polypharmacy group had an increased risk of 1-year rehospitalization as compared with those in the no polypharmacy group (RR=1.81, 95% CI=1.18-2.75).', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:26:53+00:00'}
 ,{s: 'prior inpatient admissions', t: 'hospital readmission within 6 months', fact: 'f_c5f51c7b1d80191e', doc: 'pubmed/24636762.txt', start: 1262, end: 1526, evidence: 'Survival analysis predicting readmission within 6 months after first hospitalization showed that primary factors associated with first readmissions were history of prior hospitalization, malignancy, insulin use, and presence of pre-existing liver or renal disease.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:26:58+00:00'}
 ,{s: 'older age', t: 'hospital readmission within 90 days', fact: 'f_02687d7c69aa652f', doc: 'pubmed/25022929.txt', start: 1661, end: 1824, evidence: 'Poor prognostic factors for the cohort of heart failure patients included increased age, diabetes and renal impairment, but not left ventricular ejection fraction.', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:27:13+00:00'}
 ,{s: 'neighborhood socioeconomic disadvantage', t: 'hospital readmission within 30 days', fact: 'f_6aeea1a347c4dbe6', doc: 'pubmed/25437404.txt', start: 2129, end: 2263, evidence: 'Residence within a disadvantaged U.S. neighborhood is a rehospitalization predictor of magnitude similar to chronic pulmonary disease.', confidence: 0.92, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:27:32+00:00'}
 ,{s: 'falls and falls risk', t: 'hospital readmission within 30 days', fact: 'f_30290acc9f6986b0', doc: 'pubmed/25608114.txt', start: 750, end: 1119, evidence: 'Elderly patients with cognitive impairment (adjusted odds ratio [aOR]=1.06, 95% confidence interval [CI]=1.01-1.12), falls and falls risk (aOR=1.15, 95% CI=1.08-1.22), polypharmacy (aOR=1.20, 95% CI=1.14-1.27), and urinary incontinence (aOR=1.08, 95% CI=1.01-1.15) were at higher risk for all-cause 30-day readmission than their counterparts without these complexities.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:27:38+00:00'}
 ,{s: 'polypharmacy', t: 'hospital readmission within 30 days', fact: 'f_16a69cb933d701ac', doc: 'pubmed/25608114.txt', start: 750, end: 1119, evidence: 'Elderly patients with cognitive impairment (adjusted odds ratio [aOR]=1.06, 95% confidence interval [CI]=1.01-1.12), falls and falls risk (aOR=1.15, 95% CI=1.08-1.22), polypharmacy (aOR=1.20, 95% CI=1.14-1.27), and urinary incontinence (aOR=1.08, 95% CI=1.01-1.15) were at higher risk for all-cause 30-day readmission than their counterparts without these complexities.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:27:38+00:00'}
 ,{s: 'pre-existing pulmonary disease', t: 'hospital readmission within 30 days', fact: 'f_625633005b8ecca6', doc: 'pubmed/25611424.txt', start: 1234, end: 1537, evidence: 'Pre-existing pulmonary disease (odds ratio [OR], 1.885; 95% confidence interval [CI], 1.305-2.724), initial hospitalization of 8 days or longer (OR, 1.853; 95% CI, 1.223-2.807), and discharge to a skilled nursing facility (OR, 1.586; 95% CI, 1.043-2.413) were determined to be predictors of readmission.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:27:45+00:00'}
