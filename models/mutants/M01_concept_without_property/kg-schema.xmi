  <concepts name="ClinicalOutcome" uri="http://www.xaikg.org/usecases/diabetes-readmission#ClinicalOutcome"
      description="An outcome that risk factors, conditions and drugs may influence, e.g. hospital readmission within 30 days, mortality, hypoglycemic emergency.">
    <properties name="name" dataType="STRING" isRequired="true" isExplainable="true" description="Outcome name in lowercase, e.g. 'hospital readmission within 30 days'"/>
    <properties name="timeWindow" dataType="STRING" isRequired="false" isExplainable="true" description="Time window if stated, e.g. '30 days'"/>
    <canonicalEntities name="hospital readmission within 30 days" plainLabel="coming back to the hospital within 30 days" pattern="^(all-cause |unplanned |early |potentially preventable )?(hospital )?re-?(admission|admissions|hospitali[sz]ation)( within (30|thirty) days)?( of discharge| after discharge)?$|^(30|thirty)-day( all-cause| unplanned)?( hospital)? re-?(admission|hospitali[sz]ation)$">
      <aliases>30-day readmission</aliases>
      <aliases>30-day hospital readmission</aliases>
      <aliases>readmission within 30 days</aliases>
      <aliases>readmission within 30 days of discharge</aliases>
      <aliases>all-cause hospital readmission within 30 days</aliases>
      <aliases>30-day all-cause readmission</aliases>
      <aliases>all-cause 30-day readmission</aliases>
      <aliases>early readmission</aliases>
      <aliases>hospital readmission</aliases>
      <aliases>readmission</aliases>
      <aliases>rehospitalization</aliases>
      <aliases>rehospitalisation</aliases>
      <aliases>unplanned readmission</aliases>
      <aliases>30-day unplanned readmission</aliases>
      <aliases>hospital readmission within 1 month</aliases>
      <aliases>being hospitalized again</aliases>
      <aliases>readmitted after discharge</aliases>
      <aliases>hospital readmissions</aliases>
      <aliases>readmissions</aliases>
      <aliases>unplanned hospital readmission</aliases>
    </canonicalEntities>
    <canonicalEntities name="hospital admission" plainLabel="a hospital admission">
      <aliases>hospitalization</aliases>
      <aliases>hospitalisation</aliases>
      <aliases>hospital admissions</aliases>
      <aliases>inpatient admission</aliases>
    </canonicalEntities>
    <canonicalEntities name="mortality" plainLabel="death">
      <aliases>death</aliases>
      <aliases>all-cause mortality</aliases>
      <aliases>all-cause death</aliases>
    </canonicalEntities>
  </concepts>

  <concepts name="Recommendation" uri="http://www.xaikg.org/usecases/diabetes-readmission#Recommendation"
      description="A clinical guideline statement or care recommendation, e.g. 'measure HbA1c in hospitalized patients without a result in the previous 3 months'.">
    <properties name="statement" dataType="STRING" isRequired="true" isExplainable="true" description="The recommendation, one sentence, close to the source wording"/>
    <properties name="source" dataType="STRING" isRequired="true" isExplainable="true" description="Issuing body or publication, e.g. 'American Diabetes Association'"/>
    <properties name="strength" dataType="STRING" isRequired="false" isExplainable="true" description="Strength or evidence grade if stated, e.g. 'grade A'"/>
  </concepts>

  <!-- ============================ Relations ============================ -->
  <relations id="TREATS" name="TREATS" source="Drug" target="Condition"
      minCardinality="0" maxCardinality="-1"
      semantics="the drug is indicated for (treats, controls or prevents) the condition"/>
  <relations id="MAY_CAUSE" name="MAY_CAUSE" source="Drug" target="Condition"
      minCardinality="0" maxCardinality="-1"
      semantics="the drug can cause the condition as an adverse effect"/>
  <relations id="CONTRAINDICATED_IN" name="CONTRAINDICATED_IN" source="Drug" target="Condition"
      minCardinality="0" maxCardinality="-1"
      semantics="the drug must not be used, or used with caution, in patients with the condition"/>
  <relations id="INTERACTS_WITH" name="INTERACTS_WITH" source="Drug" target="Drug"
      minCardinality="0" maxCardinality="-1"
      semantics="co-administration of the two drugs changes the effect or risk of one of them"/>
  <relations id="BELONGS_TO_CLASS" name="BELONGS_TO_CLASS" source="Drug" target="DrugClass"
      minCardinality="0" maxCardinality="1"
      semantics="the drug is a member of the pharmacological class"/>
  <relations id="INCREASES_RISK_OF_Condition" name="INCREASES_RISK_OF" source="Condition" target="ClinicalOutcome"
      minCardinality="0" maxCardinality="-1"
      semantics="having the condition raises the probability of the outcome"/>
  <relations id="INCREASES_RISK_OF_RiskFactor" name="INCREASES_RISK_OF" source="RiskFactor" target="ClinicalOutcome"
      minCardinality="0" maxCardinality="-1"
      semantics="the factor raises the probability of the outcome"/>
  <relations id="INCREASES_RISK_OF_Drug" name="INCREASES_RISK_OF" source="Drug" target="ClinicalOutcome"
      minCardinality="0" maxCardinality="-1"
      semantics="use of the drug is associated with a higher probability of the outcome"/>
  <relations id="REDUCES_RISK_OF_RiskFactor" name="REDUCES_RISK_OF" source="RiskFactor" target="ClinicalOutcome"
      minCardinality="0" maxCardinality="-1"
      semantics="the factor (often a care-process factor such as a test being performed) lowers the probability of the outcome"/>
  <relations id="REDUCES_RISK_OF_Drug" name="REDUCES_RISK_OF" source="Drug" target="ClinicalOutcome"
      minCardinality="0" maxCardinality="-1"
      semantics="use of the drug is associated with a lower probability of the outcome"/>
  <relations id="INDICATES" name="INDICATES" source="LabTest" target="Condition"
      minCardinality="0" maxCardinality="-1"
      semantics="the test level is a marker of the condition, e.g. HbA1c > 8% indicates poor glycemic control"/>
  <relations id="APPLIES_TO" name="APPLIES_TO" source="Recommendation" target="Condition"
      minCardinality="1" maxCardinality="-1"
      semantics="the recommendation concerns patients with the condition"/>
  <relations id="RECOMMENDS_LabTest" name="RECOMMENDS" source="Recommendation" target="LabTest"
      minCardinality="0" maxCardinality="-1"
      semantics="the recommendation advises performing or targeting the test level"/>
  <relations id="RECOMMENDS_Drug" name="RECOMMENDS" source="Recommendation" target="Drug"
      minCardinality="0" maxCardinality="-1"
      semantics="the recommendation advises using the drug"/>
  <relations id="RECOMMENDS_RiskFactor" name="RECOMMENDS" source="Recommendation" target="RiskFactor"
      minCardinality="0" maxCardinality="-1"
      semantics="the recommendation advises a care process or a change of a modifiable factor, e.g. diabetes education, follow-up after discharge, medication reconciliation"/>

  <!-- ============================ Query patterns ============================ -->
  <!-- Parameters bound by the explanation service (a pattern receives only those it declares):
         $factors  : KG keys of the entities resolved from the attributed features (top positive attributions)
         $active   : KG keys of every binding active for the encounter, attributed or not
         $outcome  : key of the ClinicalOutcome the decision class predicts
         $limit    : the retrieval limit of the explainability configuration: candidate facts per attributed
                     factor (patterns returning factorKey) or per pattern / per condition (the others);
                     the audience's presentation budget selects among the candidates afterwards
         $contrastFactors : factors of the contrast case (contrastive explanations)
         $factIds  : fact ids to trace (audit)
       Column conventions read by the service: factId* (fact identifiers, scalar or list), factorKey (the
       attributed factor a row is evidence for), actionKeys (the modifiable entities an actionable row
       advises on); factorLabel / protectiveLabel / conditionLabel carry the plain-language wording. -->
  <queryPatterns name="causal_context" parameters="factors outcome limit"
      description="Direct evidence paths from the decision's factors to the predicted outcome (causal explanations), up to $limit facts per factor.">
    <cypherTemplate>MATCH (f)-[r:INCREASES_RISK_OF]->(o:ClinicalOutcome {_key: $outcome})
WHERE f._key IN $factors
WITH f, o, r ORDER BY r._prov_confidence DESC, r._prov_fact_id
WITH f, o, collect(r)[..$limit] AS rs
UNWIND rs AS r
RETURN labels(f)[0] AS factorType, f.name AS factor, f._key AS factorKey, f._plain_label AS factorLabel,
       type(r) AS relation, o.name AS outcome,
       r._prov_fact_id AS factId, r._prov_source_document AS sourceDocument, r._prov_char_start AS charStart,
       r._prov_char_end AS charEnd, r._prov_confidence AS confidence, r._prov_prompt_id AS promptId
ORDER BY confidence DESC, factId</cypherTemplate>
  </queryPatterns>

  <queryPatterns name="drug_adverse_chain" parameters="factors outcome limit"
      description="Two-hop evidence: a drug the patient takes may cause a condition that increases the risk of the outcome (up to $limit chains per drug).">
    <cypherTemplate>MATCH (d:Drug)-[r1:MAY_CAUSE]->(c:Condition)-[r2:INCREASES_RISK_OF]->(o:ClinicalOutcome {_key: $outcome})
WHERE d._key IN $factors
WITH d, c, o, r1, r2 ORDER BY r1._prov_confidence * r2._prov_confidence DESC, r1._prov_fact_id, r2._prov_fact_id
WITH d, collect({condition: c.name, outcome: o.name,
                 factId1: r1._prov_fact_id, source1: r1._prov_source_document, confidence1: r1._prov_confidence,
                 factId2: r2._prov_fact_id, source2: r2._prov_source_document, confidence2: r2._prov_confidence})[..$limit] AS chains
UNWIND chains AS x
RETURN d.name AS drug, d._key AS factorKey, x.condition AS condition, x.outcome AS outcome,
       x.factId1 AS factId1, x.source1 AS source1, x.confidence1 AS confidence1,
       x.factId2 AS factId2, x.source2 AS source2, x.confidence2 AS confidence2
ORDER BY confidence1 * confidence2 DESC, factId1, factId2</cypherTemplate>
  </queryPatterns>

  <queryPatterns name="lab_indication_chain" parameters="factors outcome limit"
      description="Two-hop evidence: an abnormal lab level indicates a condition that increases the risk of the outcome (up to $limit chains per lab level).">
    <cypherTemplate>MATCH (l:LabTest)-[r1:INDICATES]->(c:Condition)-[r2:INCREASES_RISK_OF]->(o:ClinicalOutcome {_key: $outcome})
WHERE l._key IN $factors
WITH l, c, o, r1, r2 ORDER BY r1._prov_confidence * r2._prov_confidence DESC, r1._prov_fact_id, r2._prov_fact_id
WITH l, collect({condition: c.name, outcome: o.name,
                 factId1: r1._prov_fact_id, source1: r1._prov_source_document, confidence1: r1._prov_confidence,
                 factId2: r2._prov_fact_id, source2: r2._prov_source_document, confidence2: r2._prov_confidence})[..$limit] AS chains
UNWIND chains AS x
RETURN l.name AS labTest, l._key AS factorKey, x.condition AS condition, x.outcome AS outcome,
       x.factId1 AS factId1, x.source1 AS source1, x.confidence1 AS confidence1,
       x.factId2 AS factId2, x.source2 AS source2, x.confidence2 AS confidence2
ORDER BY confidence1 * confidence2 DESC, factId1, factId2</cypherTemplate>
  </queryPatterns>

  <queryPatterns name="contrastive_difference" parameters="factors contrastFactors outcome limit"
      description="Evidence for the factors present in this decision but absent in the contrast case (why this patient and not a similar one), up to $limit facts per factor.">
    <cypherTemplate>UNWIND [x IN $factors WHERE NOT x IN $contrastFactors] AS differing
MATCH (f {_key: differing})-[r:INCREASES_RISK_OF]->(o:ClinicalOutcome {_key: $outcome})
WITH f, o, r ORDER BY r._prov_confidence DESC, r._prov_fact_id
WITH f, o, collect(r)[..$limit] AS rs
UNWIND rs AS r
RETURN labels(f)[0] AS factorType, f.name AS factor, f._key AS factorKey, f._plain_label AS factorLabel, o.name AS outcome,
       r._prov_fact_id AS factId, r._prov_source_document AS sourceDocument, r._prov_confidence AS confidence
ORDER BY confidence DESC, factId</cypherTemplate>
  </queryPatterns>

  <queryPatterns name="counterfactual_recommendations" parameters="active outcome limit" actionableOnly="true"
      description="Guideline recommendations of a modifiable medicine or care process for a condition of the encounter on the path to the outcome: the condition is active itself or indicated by an active lab level, and it or the active entity increases the risk of the outcome (what could change the outcome). Recommendations of the different conditions are interleaved, up to $limit per condition.">
    <cypherTemplate>MATCH (f)
WHERE f._key IN $active
MATCH (rec:Recommendation)-[ra:APPLIES_TO]->(c:Condition)
WHERE (c = f OR (f)-[:INDICATES]->(c))
  AND (EXISTS { MATCH (f)-[:INCREASES_RISK_OF]->(:ClinicalOutcome {_key: $outcome}) }
       OR EXISTS { MATCH (c)-[:INCREASES_RISK_OF]->(:ClinicalOutcome {_key: $outcome}) })
MATCH (rec)-[rr:RECOMMENDS]->(t)
WHERE t._modifiable = true
WITH rec, ra, c, collect(DISTINCT f.name) AS via, collect(DISTINCT t.name) AS recommends,
     collect(DISTINCT coalesce(t._plain_label, t.name)) AS recommendsLabel, collect(DISTINCT t._key) AS actionKeys,
     collect(DISTINCT rr._prov_fact_id) AS factIdsRecommends
ORDER BY ra._prov_confidence DESC, ra._prov_fact_id
WITH c, collect({recommendation: rec.statement, guidelineSource: rec.source, strength: rec.strength, via: via,
                 recommends: recommends, recommendsLabel: recommendsLabel, actionKeys: actionKeys,
                 factId: ra._prov_fact_id, factIdsRecommends: factIdsRecommends,
                 sourceDocument: ra._prov_source_document, confidence: ra._prov_confidence})[..$limit] AS advice
UNWIND range(0, size(advice) - 1) AS conditionRank
WITH c, advice[conditionRank] AS x, conditionRank
RETURN x.recommendation AS recommendation, x.guidelineSource AS guidelineSource, x.strength AS strength,
       c.name AS condition, c._plain_label AS conditionLabel, x.via AS via, x.recommends AS recommends,
       x.recommendsLabel AS recommendsLabel, x.actionKeys AS actionKeys, x.factId AS factId,
       x.factIdsRecommends AS factIdsRecommends, x.sourceDocument AS sourceDocument, x.confidence AS confidence,
       conditionRank
ORDER BY conditionRank, confidence DESC, condition, factId</cypherTemplate>
  </queryPatterns>

  <queryPatterns name="protective_factors" parameters="active outcome limit" actionableOnly="true"
      description="Modifiable factors and drugs the literature associates with a lower probability of the outcome, excluding drugs contraindicated in a condition of the encounter, ranked first by their relation to the encounter's active entities (the entity itself is active, it treats or interacts with an active entity, or its evidence studies the active entities) (counterfactual explanations: what lowers the risk).">
    <cypherTemplate>MATCH (f)-[r:REDUCES_RISK_OF]->(o:ClinicalOutcome {_key: $outcome})
WHERE f._modifiable = true
  AND NOT EXISTS { MATCH (f)-[:CONTRAINDICATED_IN]->(x) WHERE x._key IN $active }
WITH f, o, collect(r) AS rs
OPTIONAL MATCH (f)-[:TREATS|INTERACTS_WITH]-(a)
WHERE a._key IN $active
WITH f, o, rs, collect(DISTINCT a.name) AS linked
OPTIONAL MATCH (m)-[:EXTRACTED_FROM]->(d:SourceDocument)
WHERE m._key IN $active AND NOT m = f AND d.id IN [x IN rs | x._prov_source_document]
WITH f, o, rs, linked, collect(DISTINCT m.name) AS studied
WITH f, o, rs, reduce(acc = CASE WHEN f._key IN $active THEN [f.name] ELSE [] END, x IN linked + studied |
       CASE WHEN x IN acc THEN acc ELSE acc + x END) AS relatedTo
WITH f, o, rs, relatedTo,
     reduce(b = head(rs), x IN rs | CASE WHEN x._prov_confidence > b._prov_confidence THEN x ELSE b END) AS best
RETURN labels(f)[0] AS factorType, f.name AS protectiveFactor, f._plain_label AS protectiveLabel, [f._key] AS actionKeys,
       o.name AS outcome, relatedTo, size(relatedTo) AS relevance, size(rs) AS sources,
       best._prov_fact_id AS factId, [x IN rs | x._prov_fact_id] AS factIds,
       best._prov_source_document AS sourceDocument, best._prov_confidence AS confidence
ORDER BY relevance DESC, sources DESC, confidence DESC, protectiveFactor
LIMIT $limit</cypherTemplate>
  </queryPatterns>

  <queryPatterns name="guideline_rules" parameters="active limit"
      description="All guideline statements applying to the conditions active for the encounter (rule-based explanations, compliance view). Statements of the different conditions are interleaved, up to $limit per condition.">
    <cypherTemplate>MATCH (rec:Recommendation)-[ra:APPLIES_TO]->(c:Condition)
WHERE c._key IN $active
OPTIONAL MATCH (rec)-[:RECOMMENDS]->(target)
WITH rec, ra, c, collect(DISTINCT target.name) AS recommends
ORDER BY ra._prov_confidence DESC, ra._prov_fact_id
WITH c, collect({recommendation: rec.statement, guidelineSource: rec.source, strength: rec.strength,
                 recommends: recommends, factId: ra._prov_fact_id, sourceDocument: ra._prov_source_document,
                 confidence: ra._prov_confidence})[..$limit] AS statements
UNWIND range(0, size(statements) - 1) AS conditionRank
WITH c, statements[conditionRank] AS x, conditionRank
RETURN x.recommendation AS recommendation, x.guidelineSource AS guidelineSource, x.strength AS strength,
       c.name AS condition, x.recommends AS recommends,
       x.factId AS factId, x.sourceDocument AS sourceDocument, x.confidence AS confidence, conditionRank
ORDER BY conditionRank, confidence DESC, condition, factId</cypherTemplate>
  </queryPatterns>

  <queryPatterns name="provenance_trace" parameters="factIds"
      description="Full provenance of given facts: source document, character span, extraction run (prompt version, LLM), validation policy version.">
    <cypherTemplate>MATCH (s)-[r]->(t)
WHERE r._prov_fact_id IN $factIds
OPTIONAL MATCH (doc:SourceDocument {id: r._prov_source_document})
OPTIONAL MATCH (run:ExtractionRun {runId: r._prov_run_id})
RETURN r._prov_fact_id AS factId, labels(s)[0] AS sourceType, coalesce(s.name, s.statement) AS source, type(r) AS relation,
       labels(t)[0] AS targetType, coalesce(t.name, t.statement) AS target,
       properties(r) AS provenance, properties(doc) AS document, properties(run) AS extractionRun</cypherTemplate>
  </queryPatterns>

</kgschema:KGSchemaDefinition>
