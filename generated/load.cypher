 ,{s: 'hyperglycemia', t: 'hospital readmission within 30 days', fact: 'f_1cbdb856673e8ca4', doc: 'pubmed/37922214.txt', start: 1550, end: 1826, evidence: 'The XGBoost model identified the index admission length of stay, presence of hyper- and hypoglycemia, the recipient and donor body mass index (BMI) values, presence of delayed graft function, and African American race as the most predictive risk factors of 30-day readmission.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:42:41+00:00'}
 ,{s: 'inpatient hypoglycemia', t: 'hospital readmission within 30 days', fact: 'f_f1f434d7a9b96cae', doc: 'pubmed/37922214.txt', start: 1550, end: 1826, evidence: 'The XGBoost model identified the index admission length of stay, presence of hyper- and hypoglycemia, the recipient and donor body mass index (BMI) values, presence of delayed graft function, and African American race as the most predictive risk factors of 30-day readmission.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:42:41+00:00'}
 ,{s: 'diabetic ketoacidosis', t: 'hospital readmission within 30 days', fact: 'f_422ee3ee630e3ba9', doc: 'pubmed/38937276.txt', start: 1332, end: 1599, evidence: 'Older age, lower estimated glomerular filtration rate (eGFR), comorbidities, intensive care unit (ICU) admission, mechanical ventilation, diabetic ketoacidosis (DKA), and longer length of stay (LOS) during the initial hospitalization were associated with readmission.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:44:27+00:00'}
 ,{s: 'diabetes', t: 'cardiac death or readmission for heart failure', fact: 'f_9a1a62e83f7efbe1', doc: 'pubmed/39152477.txt', start: 1626, end: 1759, evidence: 'In patients with NSTEMI, the combination of DM and CMD is an independent predictor of cardiac death or readmission for heart failure.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:44:51+00:00'}
