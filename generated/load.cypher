 ,{s: 'non-st-elevation myocardial infarction', t: 'hospital readmission within 30 days', fact: 'f_8508010d0107bca8', doc: 'pubmed/39251079.txt', start: 828, end: 1154, evidence: 'the number of patients with first all-cause readmissions within 30 days, 3 months, and 12 months of discharge were 844 (13%), 1,372 (21%), and 2,306 (35%), respectively, with a higher readmission rate in patients with non-ST-elevation MI, previous heart failure (HF), new-onset HF, and left ventricular ejection fraction ≤40%.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:45:11+00:00'}
