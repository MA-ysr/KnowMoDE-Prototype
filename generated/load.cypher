  {s: 'dapagliflozin', t: 'cardiovascular death', fact: 'f_97aa054a9f5df288', doc: 'pubmed/33144086.txt', start: 202, end: 387, evidence: 'Dapagliflozin, a sodium-glucose cotransporter-2 inhibitor, reduces cardiovascular death and worsening heart failure in patients with chronic heart failure and reduced ejection fraction.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:39:34+00:00'}
 ,{s: 'steroid', t: 'acute-care hospital reencounter', fact: 'f_176fd24972240b63', doc: 'pubmed/34019232.txt', start: 1393, end: 1522, evidence: 'Steroid treatment during COVID-19 hospitalization demonstrated reduced odds of 30-day reencounter (OR 0.31 [95% CI 0.091, 0.79]).', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:41:27+00:00'}
 ,{s: 'sglt2 inhibitors', t: 'heart failure readmission or cardiovascular death', fact: 'f_17b58bf78b19550b', doc: 'pubmed/34107289.txt', start: 1152, end: 1256, evidence: 'Effects of SGLT2Is on heart failure readmission or CV death varied significantly by region (P = 0.0094).', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:41:38+00:00'}
 ,{s: 'insulin', t: 'worsening cardiac outcomes', fact: 'f_e4b05fb5448dbf98', doc: 'pubmed/34232594.txt', start: 907, end: 1101, evidence: 'Insulin and Metformin have been the gold standard treatment for diabetes management to prevent worsening cardiac outcomes, and now a newer class of medications have demonstrated similar results.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:41:55+00:00'}
 ,{s: 'metformin', t: 'worsening cardiac outcomes', fact: 'f_b6ce593ec4ab77af', doc: 'pubmed/34232594.txt', start: 907, end: 1101, evidence: 'Insulin and Metformin have been the gold standard treatment for diabetes management to prevent worsening cardiac outcomes, and now a newer class of medications have demonstrated similar results.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:41:55+00:00'}
 ,{s: 'dapagliflozin', t: 'hospitalization for heart failure', fact: 'f_888d48a1d49f3449', doc: 'pubmed/34585897.txt', start: 134, end: 599, evidence: 'Dapagliflozin is the first in a novel class of glucose-lowering agents known as sodium-glucose co-transporter-2 (SGLT2) inhibitors which was approved by USFDA in management of type 2 diabetes mellitus (T2DM) as an adjunct to diet and exercise to improve glycemic control in adults initially, followed by to reduce the risk of hospitalization for heart failure (HHF) in adults with T2DM and established cardiovascular disease or multiple cardiovascular risk factors.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:43:04+00:00'}
 ,{s: 'dapagliflozin', t: 'cardiovascular death', fact: 'f_87b7ccb881d44224', doc: 'pubmed/34585897.txt', start: 600, end: 761, evidence: 'Most recently, it is approved to reduce the risk of cardiovascular death and in adults with heart failure (HF) with reduced ejection fraction (NYHA class II-IV).', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:43:04+00:00'}
 ,{s: 'dapagliflozin', t: 'major adverse cardiovascular events', fact: 'f_7aac980a82ae2eb0', doc: 'pubmed/34585897.txt', start: 1227, end: 1422, evidence: 'DECLARE TIMI 58 study clearly demonstrated that Dapagliflozin was non inferior in reducing major adverse cardiovascular events (MACE) in patients with T2DM and high CV risk compared with placebo.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:43:04+00:00'}
 ,{s: 'dapagliflozin', t: 'heart failure hospitalisation', fact: 'f_fdd497eb7deedfed', doc: 'pubmed/34585897.txt', start: 1423, end: 1528, evidence: '27% risk reduction in heart failure hospitalisation was noted along without increased risk of amputation.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:43:04+00:00'}
 ,{s: 'oral and insulin medications', t: 'hospital readmission within 30 days', fact: 'f_42960e633367ae5e', doc: 'pubmed/35947866.txt', start: 853, end: 997, evidence: 'Patients who received diabetes self-management education or were prescribed both oral and insulin medications were less likely to be readmitted.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:46:51+00:00'}
 ,{s: 'metformin', t: 'combined primary outcomes', fact: 'f_e7f3bcf89ab03453', doc: 'pubmed/36732827.txt', start: 1752, end: 2005, evidence: 'Further longitudinal analysis showed that metformin was also independently associated with a low risk of combined primary outcomes after adjusting for multiple covariables, while frailty was related to an increased risk of the combined primary outcomes.', confidence: 0.92, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:50:17+00:00'}
 ,{s: 'sglt2 inhibitors', t: 'heart failure readmission', fact: 'f_c7ef57dd92b91007', doc: 'pubmed/38428527.txt', start: 577, end: 733, evidence: 'Beneficial effects, especially for HF readmission, accrue very early in their treatment trajectory, and this has promoted their use in the hospital setting.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:43:51+00:00'}
 ,{s: 'sglt2 inhibitors', t: 'mortality', fact: 'f_89a0f62450aaef2d', doc: 'pubmed/40449290.txt', start: 193, end: 400, evidence: 'Sodium-glucose cotransporter 2 inhibitors (SGLT2i) have emerged as transformative therapies in the management of chronic heart failure (HF), offering substantial reductions in mortality and hospitalizations.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:46:23+00:00'}
 ,{s: 'sglt2 inhibitors', t: 'hospitalizations', fact: 'f_6f2c25e8162c7d0f', doc: 'pubmed/40449290.txt', start: 193, end: 400, evidence: 'Sodium-glucose cotransporter 2 inhibitors (SGLT2i) have emerged as transformative therapies in the management of chronic heart failure (HF), offering substantial reductions in mortality and hospitalizations.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:46:23+00:00'}
 ,{s: 'sglt2 inhibitors', t: 'hospital readmission within 30 days', fact: 'f_1fc0263fbdb10ab2', doc: 'pubmed/40449290.txt', start: 815, end: 1070, evidence: 'In acute decompensated HF, early initiation of SGLT2i enhances clinical decongestion by increasing diuresis, improving diuretic efficiency, and mitigating diuretic resistance, translating to shorter hospitalizations and reduced readmissions and mortality.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:46:23+00:00'}
 ,{s: 'sglt2 inhibitors', t: 'arrhythmic events', fact: 'f_10e82e9a7720e5b8', doc: 'pubmed/40449290.txt', start: 1071, end: 1324, evidence: 'In acute myocardial infarction, SGLT2i reduce the incidence of first and total HF hospitalizations, arrhythmic events, adverse cardiac remodelling, and contrast-induced acute kidney injury, while mitigating stent failure and atherosclerotic progression.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:46:23+00:00'}
 ,{s: 'sglt2 inhibitors', t: 'acute kidney injury', fact: 'f_74e65c41a03502ab', doc: 'pubmed/40449290.txt', start: 1577, end: 1801, evidence: 'In critically ill patients, SGLT2i use is associated with reduced rates of acute kidney injury and the need for renal replacement therapy, with promising implications for the management of sepsis and multi-organ dysfunction.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:46:23+00:00'}
 ,{s: 'sglt2 inhibitors', t: 'renal replacement therapy', fact: 'f_239198d022a53e77', doc: 'pubmed/40449290.txt', start: 1577, end: 1801, evidence: 'In critically ill patients, SGLT2i use is associated with reduced rates of acute kidney injury and the need for renal replacement therapy, with promising implications for the management of sepsis and multi-organ dysfunction.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:46:23+00:00'}
 ,{s: 'sglt2 inhibitors', t: 'major adverse cardiovascular events', fact: 'f_51f6581107a1ef6c', doc: 'pubmed/40792574.txt', start: 1034, end: 1153, evidence: 'The SGLT2i group exhibited significant reductions in MACEs, MAKEs, and all-cause death compared with the control group.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:47:10+00:00'}
 ,{s: 'sglt2 inhibitors', t: 'major adverse kidney events', fact: 'f_2f7d4077d7095eb6', doc: 'pubmed/40792574.txt', start: 1034, end: 1153, evidence: 'The SGLT2i group exhibited significant reductions in MACEs, MAKEs, and all-cause death compared with the control group.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:47:10+00:00'}
 ,{s: 'sglt2 inhibitors', t: 'mortality', fact: 'f_b55319b13a624e56', doc: 'pubmed/40792574.txt', start: 1034, end: 1153, evidence: 'The SGLT2i group exhibited significant reductions in MACEs, MAKEs, and all-cause death compared with the control group.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:47:10+00:00'}
 ,{s: 'sglt2 inhibitors', t: 'heart failure readmission', fact: 'f_dca41a2ac281e191', doc: 'pubmed/40792574.txt', start: 1154, end: 1367, evidence: 'Based on adjusted Cox regression, those receiving SGLT2is had a 27.4% lower hazard for MACEs, driven primarily by a 12.4% lower hazard for cardiovascular death and 32.7% lower hazard for heart failure readmission.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:47:10+00:00'}
] AS r
MATCH (s:Drug {_key: r.s}), (t:ClinicalOutcome {_key: r.t})
