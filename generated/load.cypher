 ,{s: 'cataracts', t: 'vision loss', fact: 'f_e70f126d33c66b2f', doc: 'medlineplus/eye-diseases.txt', start: 573, end: 639, evidence: 'Cataracts are common as you get older and can lead to vision loss.', confidence: 0.9, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:21:38+00:00'}
 ,{s: 'gestational hypertension', t: 'preterm birth', fact: 'f_3415e71017be4ff8', doc: 'medlineplus/high-blood-pressure-in-pregnancy.txt', start: 1263, end: 1355, evidence: 'If it becomes severe, it can lead to a preterm birth or your baby having a low birth weight.', confidence: 0.9, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:22:15+00:00'}
 ,{s: 'high blood pressure in pregnancy', t: 'placental abruption', fact: 'f_f97e77ee96c1bded', doc: 'medlineplus/high-blood-pressure-in-pregnancy.txt', start: 4132, end: 4371, evidence: 'High blood pressure in pregnancy can lead to complications such as:\n\nPlacental abruption, where the placenta (the organ that brings oxygen and nutrients to the baby) separates from the uterus (the place where a baby grows during pregnancy)', confidence: 0.95, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:22:15+00:00'}
 ,{s: 'high blood pressure in pregnancy', t: 'poor fetal growth', fact: 'f_c807cc17d754be33', doc: 'medlineplus/high-blood-pressure-in-pregnancy.txt', start: 4132, end: 4432, evidence: 'High blood pressure in pregnancy can lead to complications such as:\n\nPlacental abruption, where the placenta (the organ that brings oxygen and nutrients to the baby) separates from the uterus (the place where a baby grows during pregnancy)\n\nPoor fetal growth, caused by a lack of nutrients and oxygen', confidence: 0.95, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:22:15+00:00'}
 ,{s: 'overweight and obesity', t: 'high blood pressure', fact: 'f_fa3d7b8fb4a07f2d', doc: 'medlineplus/how-to-prevent-high-blood-pressure.txt', start: 4556, end: 4635, evidence: 'Being overweight or having obesity increases your risk for high blood pressure.', confidence: 0.95, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:22:50+00:00'}
 ,{s: 'hypoglycemia', t: 'passing out, coma, or death', fact: 'f_095305b348710332', doc: 'medlineplus/hypoglycemia.txt', start: 3080, end: 3180, evidence: 'But severe hypoglycemia can cause serious complications, including passing out, coma, or even death.', confidence: 0.92, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:23:11+00:00'}
 ,{s: 'acute radiation syndrome', t: 'mortality', fact: 'f_8319f372f9c67209', doc: 'medlineplus/radiation-exposure.txt', start: 2273, end: 2336, evidence: 'In some cases, ARS causes death in the following days or weeks.', confidence: 0.9, run: 'patient_education_extraction@6fb3bf908974', runId: 'patient_education_extraction@6fb3bf908974@gemini/gemini-3.5-flash-lite', hash: '6fb3bf908974d1d5f147589cd6258432e2d6cb32a95cd8a052d4c74c03d75f00', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:25:07+00:00'}
