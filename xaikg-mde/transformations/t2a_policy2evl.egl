[*
  T2a, compilation step of T2 (paper, Phase 3): the Validation Policy model is
  compiled into an executable EVL validator. One EVL constraint per ValidationRule: its expression
  becomes the check, its errorMessage the message, ERROR -> constraint (rejects), WARNING/INFO ->
  critique (annotates). Nothing below is written per rule by hand; add a rule to the model and the
  validator changes.

  Variables available to rule expressions (documented in the metamodel, validation::ValidationRule):
    self      the raw entity / relation under check          (Raw!RawEntity | Raw!RawRelation)
    schema    the target KGSchemaDefinition                   (Schema model)
    config    the ValidationConfig                            (Policy model)
    document  the RawExtractionResult containing self
    accepted  (RELATION scope) raw entities of the same document that passed every ERROR entity rule

  Each rule is compiled to an operation `rule_<name>()` on the raw type, and the EVL constraint
  delegates to it, so `acceptedEntities()` can re-use the very same checks.
*]
[%
var config = Policy!ValidationConfig.all.first();
// `ids` is a Java helper injected by the CLI (org.xaikg.mde.Ids): quoting and hashing.
var entityRules = config.rules.select(r | r.scope.name = "ENTITY");
var relationRules = config.rules.select(r | r.scope.name = "RELATION");
var errorEntityRules = entityRules.select(r | r.severity.name = "ERROR");

out.println("// GENERATED by xaikg-mde T2 from validation policy '" + config.name + "' (confidenceThreshold = " + config.confidenceThreshold + ").");
out.println("// DO NOT EDIT: change the Validation Policy model and regenerate.");
out.println("// Rules: " + entityRules.size() + " entity-scoped, " + relationRules.size() + " relation-scoped.");
out.print("\n");
out.println("pre {");
out.println("  var schema = Schema!KGSchemaDefinition.all.first();");
out.println("  var config = Policy!ValidationConfig.all.first();");
out.println("  var acceptedCache : Map = new Map;");
out.println("}");
out.print("\n");
out.println("context Raw!RawEntity {");
for (r in entityRules) {
  var kw = (r.severity.name = "ERROR") ? "constraint" : "critique";
  out.print("\n");
  out.println("  // " + r.ruleType.name + " | " + r.severity.name + (r.description.isDefined() ? " | " + r.description.replace("\n", " ") : ""));
  out.println("  " + kw + " " + r.name + " {");
  out.println("    check : self.rule_" + r.name + "()");
  out.println("    message : " + r.errorMessage.trim().quoted());
  out.println("  }");
}
out.println("}");
out.print("\n");
out.println("context Raw!RawRelation {");
for (r in relationRules) {
  var kw = (r.severity.name = "ERROR") ? "constraint" : "critique";
  out.print("\n");
  out.println("  // " + r.ruleType.name + " | " + r.severity.name + (r.description.isDefined() ? " | " + r.description.replace("\n", " ") : ""));
  out.println("  " + kw + " " + r.name + " {");
  out.println("    check : self.rule_" + r.name + "()");
  out.println("    message : " + r.errorMessage.trim().quoted());
  out.println("  }");
}
out.println("}");
out.print("\n");
out.println("// ---- compiled rule expressions ----");
for (r in entityRules) {
  out.println("operation Raw!RawEntity rule_" + r.name + "() : Boolean {");
  out.println("  var document = self.eContainer();");
  out.println("  return (" + r.oclExpression.trim() + ");");
  out.println("}");
}
for (r in relationRules) {
  out.println("operation Raw!RawRelation rule_" + r.name + "() : Boolean {");
  out.println("  var document = self.eContainer();");
  out.println("  var accepted = document.acceptedEntities();");
  out.println("  return (" + r.oclExpression.trim() + ");");
  out.println("}");
}
out.print("\n");
out.println("// entities of a document that pass every ERROR-level entity rule (used by relation rules)");
out.println("operation Raw!RawExtractionResult acceptedEntities() {");
out.println("  if (not acceptedCache.containsKey(self)) {");
out.println("    acceptedCache.put(self, self.entities.select(e | " + errorEntityRules.collect(r | "e.rule_" + r.name + "()").concat(" and ") + "));");
out.println("  }");
out.println("  return acceptedCache.get(self);");
out.println("}");
%]
[%
operation String quoted() : String { return ids.quote(self); }
%]
