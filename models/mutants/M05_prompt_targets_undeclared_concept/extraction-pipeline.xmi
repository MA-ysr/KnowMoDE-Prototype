<?xml version="1.0" encoding="UTF-8"?>
<!--
  M1 model 2/5: LLM Pipeline of the diabetes readmission use case (conforms to xaikg::llmorchestration).
  Four extraction tasks, one per document collection, each targeting a SUBSET of the KG schema
  (typed references into kg-schema.xmi). T4 derives one schema-aware prompt per task from this file.
  Few-shot examples are model elements; their character offsets were computed with
  xaikg-pipeline/tools/fewshot_offsets.py so that they are exactly consistent with their input text.
-->
<llm:LLMPipelineConfig
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:llm="http://www.xaikg.org/1.0/llm"
    name="DiabetesReadmissionExtraction"
    description="LLM-based construction of the diabetes readmission KG from public sources (FDA labels, MedlinePlus, PubMed).">
  <targetSchema href="kg-schema.xmi#DiabetesReadmissionKG"/>

  <extractionTasks name="drug_label_extraction" llmModel="gemini/gemini-3.5-flash-lite" temperature="0.1" maxTokens="4096"
      sourceCollection="corpus/openfda"
      description="Extract drugs, their classes, indications, adverse effects, contraindications and interactions from FDA Structured Product Labels (openFDA).">
    <promptTemplate name="drug_label_extraction_prompt" outputFormat="JSON"
        targetConcepts="kg-schema.xmi#Drug kg-schema.xmi#DrugClass kg-schema.xmi#Condition kg-schema.xmi#Procedure"
        targetRelations="kg-schema.xmi#TREATS kg-schema.xmi#MAY_CAUSE kg-schema.xmi#CONTRAINDICATED_IN kg-schema.xmi#INTERACTS_WITH kg-schema.xmi#BELONGS_TO_CLASS">
      <systemInstruction>You are a careful clinical knowledge extraction engine working on FDA drug labels. You output only facts that are explicitly stated in the given text, in the exact JSON format requested. Use lowercase generic drug names. You never add knowledge that is not in the text.</systemInstruction>
      <fewShotExamples name="label_metformin">
        <inputText>Metformin hydrochloride tablets are indicated as an adjunct to diet and exercise to improve glycemic control in adults with type 2 diabetes mellitus. Metformin is contraindicated in patients with severe renal impairment (eGFR below 30 mL/min/1.73 m2). Postmarketing cases of metformin-associated lactic acidosis have been reported. Metformin is a biguanide.</inputText>
        <expectedOutput>{"entities": [{"type": "Drug", "id": "metformin", "mention": "Metformin hydrochloride", "span": {"start": 0, "end": 23}, "properties": {"name": "metformin", "drugClass": "biguanide"}, "confidence": 0.98}, {"type": "Condition", "id": "type-2-diabetes-mellitus", "mention": "type 2 diabetes mellitus", "span": {"start": 124, "end": 148}, "properties": {"name": "type 2 diabetes mellitus", "category": "metabolic"}, "confidence": 0.97}, {"type": "Condition", "id": "severe-renal-impairment", "mention": "severe renal impairment", "span": {"start": 196, "end": 219}, "properties": {"name": "severe renal impairment", "category": "renal"}, "confidence": 0.95}, {"type": "Condition", "id": "lactic-acidosis", "mention": "lactic acidosis", "span": {"start": 296, "end": 311}, "properties": {"name": "lactic acidosis", "category": "metabolic"}, "confidence": 0.93}, {"type": "DrugClass", "id": "biguanides", "mention": "biguanide", "span": {"start": 347, "end": 356}, "properties": {"name": "biguanides"}, "confidence": 0.9}], "relations": [{"type": "TREATS", "source": {"type": "Drug", "id": "metformin"}, "target": {"type": "Condition", "id": "type-2-diabetes-mellitus"}, "evidence": "Metformin hydrochloride tablets are indicated as an adjunct to diet and exercise to improve glycemic control in adults with type 2 diabetes mellitus.", "span": {"start": 0, "end": 149}, "confidence": 0.97}, {"type": "CONTRAINDICATED_IN", "source": {"type": "Drug", "id": "metformin"}, "target": {"type": "Condition", "id": "severe-renal-impairment"}, "evidence": "Metformin is contraindicated in patients with severe renal impairment (eGFR below 30 mL/min/1.73 m2).", "span": {"start": 150, "end": 251}, "confidence": 0.96}, {"type": "MAY_CAUSE", "source": {"type": "Drug", "id": "metformin"}, "target": {"type": "Condition", "id": "lactic-acidosis"}, "evidence": "Postmarketing cases of metformin-associated lactic acidosis have been reported.", "span": {"start": 252, "end": 331}, "confidence": 0.9}, {"type": "BELONGS_TO_CLASS", "source": {"type": "Drug", "id": "metformin"}, "target": {"type": "DrugClass", "id": "biguanides"}, "evidence": "Metformin is a biguanide.", "span": {"start": 332, "end": 357}, "confidence": 0.95}]}</expectedOutput>
      </fewShotExamples>
      <fewShotExamples name="label_glipizide">
        <inputText>Glipizide is a sulfonylurea indicated to improve glycemic control in adults with type 2 diabetes mellitus. Hypoglycemia is the most common adverse reaction. The hypoglycemic action of sulfonylureas may be potentiated by certain drugs, including fluconazole.</inputText>
        <expectedOutput>{"entities": [{"type": "Drug", "id": "glipizide", "mention": "Glipizide", "span": {"start": 0, "end": 9}, "properties": {"name": "glipizide", "drugClass": "sulfonylurea"}, "confidence": 0.98}, {"type": "DrugClass", "id": "sulfonylureas", "mention": "sulfonylurea", "span": {"start": 15, "end": 27}, "properties": {"name": "sulfonylureas"}, "confidence": 0.92}, {"type": "Condition", "id": "type-2-diabetes-mellitus", "mention": "type 2 diabetes mellitus", "span": {"start": 81, "end": 105}, "properties": {"name": "type 2 diabetes mellitus", "category": "metabolic"}, "confidence": 0.97}, {"type": "Condition", "id": "hypoglycemia", "mention": "Hypoglycemia", "span": {"start": 107, "end": 119}, "properties": {"name": "hypoglycemia", "category": "metabolic"}, "confidence": 0.96}, {"type": "Drug", "id": "fluconazole", "mention": "fluconazole", "span": {"start": 245, "end": 256}, "properties": {"name": "fluconazole"}, "confidence": 0.9}], "relations": [{"type": "BELONGS_TO_CLASS", "source": {"type": "Drug", "id": "glipizide"}, "target": {"type": "DrugClass", "id": "sulfonylureas"}, "evidence": "Glipizide is a sulfonylurea indicated to improve glycemic control in adults with type 2 diabetes mellitus.", "span": {"start": 0, "end": 106}, "confidence": 0.95}, {"type": "TREATS", "source": {"type": "Drug", "id": "glipizide"}, "target": {"type": "Condition", "id": "type-2-diabetes-mellitus"}, "evidence": "Glipizide is a sulfonylurea indicated to improve glycemic control in adults with type 2 diabetes mellitus.", "span": {"start": 0, "end": 106}, "confidence": 0.96}, {"type": "MAY_CAUSE", "source": {"type": "Drug", "id": "glipizide"}, "target": {"type": "Condition", "id": "hypoglycemia"}, "evidence": "Hypoglycemia is the most common adverse reaction.", "span": {"start": 107, "end": 156}, "confidence": 0.9}, {"type": "INTERACTS_WITH", "source": {"type": "Drug", "id": "glipizide"}, "target": {"type": "Drug", "id": "fluconazole"}, "evidence": "The hypoglycemic action of sulfonylureas may be potentiated by certain drugs, including fluconazole.", "span": {"start": 157, "end": 257}, "confidence": 0.85}]}</expectedOutput>
      </fewShotExamples>
    </promptTemplate>
    <chunkingStrategy chunkSize="4000" overlap="300" splitter="PARAGRAPH"/>
  </extractionTasks>

  <extractionTasks name="patient_education_extraction" llmModel="gemini/gemini-3.5-flash-lite" temperature="0.1" maxTokens="4096"
      sourceCollection="corpus/medlineplus"
      description="Extract conditions, lab-test levels, risk factors, outcomes and recommendations from MedlinePlus health-topic summaries written for patients.">
    <promptTemplate name="patient_education_extraction_prompt" outputFormat="JSON"
        targetConcepts="kg-schema.xmi#Condition kg-schema.xmi#LabTest kg-schema.xmi#RiskFactor kg-schema.xmi#ClinicalOutcome kg-schema.xmi#Recommendation kg-schema.xmi#Drug"
        targetRelations="kg-schema.xmi#INDICATES kg-schema.xmi#INCREASES_RISK_OF_Condition kg-schema.xmi#INCREASES_RISK_OF_RiskFactor kg-schema.xmi#REDUCES_RISK_OF_RiskFactor kg-schema.xmi#APPLIES_TO kg-schema.xmi#RECOMMENDS_LabTest kg-schema.xmi#RECOMMENDS_Drug kg-schema.xmi#MAY_CAUSE">
      <systemInstruction>You are a careful clinical knowledge extraction engine working on patient-education text from MedlinePlus. You output only facts explicitly stated in the given text, in the exact JSON format requested. Normalise condition names to lowercase medical terms (e.g. 'hypoglycemia', 'poor glycemic control'). You never add knowledge that is not in the text.</systemInstruction>
      <fewShotExamples name="education_a1c">
        <inputText>The A1C test measures your average blood sugar level over the past 2 to 3 months. An A1C above 8% means that your diabetes is not well controlled. Poorly controlled diabetes raises your risk of complications such as kidney disease and of being hospitalized again. Your health care provider may recommend an A1C test at least twice a year.</inputText>
        <expectedOutput>{"entities": [{"type": "LabTest", "id": "hba1c-above-8", "mention": "A1C above 8%", "span": {"start": 85, "end": 97}, "properties": {"name": "HbA1c &gt; 8%", "abnormalThreshold": "&gt; 8%"}, "confidence": 0.95}, {"type": "Condition", "id": "poor-glycemic-control", "mention": "Poorly controlled diabetes", "span": {"start": 147, "end": 173}, "properties": {"name": "poor glycemic control", "category": "metabolic"}, "confidence": 0.9}, {"type": "Condition", "id": "kidney-disease", "mention": "kidney disease", "span": {"start": 216, "end": 230}, "properties": {"name": "kidney disease", "category": "renal"}, "confidence": 0.93}, {"type": "ClinicalOutcome", "id": "hospital-readmission", "mention": "being hospitalized again", "span": {"start": 238, "end": 262}, "properties": {"name": "hospital readmission"}, "confidence": 0.88}, {"type": "Condition", "id": "diabetes", "mention": "diabetes", "span": {"start": 114, "end": 122}, "properties": {"name": "diabetes", "category": "metabolic"}, "confidence": 0.9}, {"type": "Recommendation", "id": "a1c-twice-a-year", "mention": "recommend an A1C test at least twice a year", "span": {"start": 294, "end": 337}, "properties": {"statement": "have an A1C test at least twice a year", "source": "MedlinePlus"}, "confidence": 0.9}, {"type": "LabTest", "id": "hba1c-test", "mention": "A1C test", "span": {"start": 4, "end": 12}, "properties": {"name": "HbA1c test"}, "confidence": 0.9}], "relations": [{"type": "INDICATES", "source": {"type": "LabTest", "id": "hba1c-above-8"}, "target": {"type": "Condition", "id": "poor-glycemic-control"}, "evidence": "An A1C above 8% means that your diabetes is not well controlled.", "span": {"start": 82, "end": 146}, "confidence": 0.93}, {"type": "INCREASES_RISK_OF", "source": {"type": "Condition", "id": "poor-glycemic-control"}, "target": {"type": "ClinicalOutcome", "id": "hospital-readmission"}, "evidence": "Poorly controlled diabetes raises your risk of complications such as kidney disease and of being hospitalized again.", "span": {"start": 147, "end": 263}, "confidence": 0.9}, {"type": "APPLIES_TO", "source": {"type": "Recommendation", "id": "a1c-twice-a-year"}, "target": {"type": "Condition", "id": "diabetes"}, "evidence": "Your health care provider may recommend an A1C test at least twice a year.", "span": {"start": 264, "end": 338}, "confidence": 0.88}, {"type": "RECOMMENDS", "source": {"type": "Recommendation", "id": "a1c-twice-a-year"}, "target": {"type": "LabTest", "id": "hba1c-test"}, "evidence": "Your health care provider may recommend an A1C test at least twice a year.", "span": {"start": 264, "end": 338}, "confidence": 0.9}]}</expectedOutput>
      </fewShotExamples>
      <fewShotExamples name="education_hypoglycemia">
        <inputText>Hypoglycemia, or low blood sugar, can lead to falls, emergency visits and hospital admissions. People who have been admitted to the hospital several times in the past year are more likely to be readmitted after discharge.</inputText>
        <expectedOutput>{"entities": [{"type": "Condition", "id": "hypoglycemia", "mention": "Hypoglycemia", "span": {"start": 0, "end": 12}, "properties": {"name": "hypoglycemia", "category": "metabolic"}, "confidence": 0.97}, {"type": "ClinicalOutcome", "id": "hospital-admission", "mention": "hospital admissions", "span": {"start": 74, "end": 93}, "properties": {"name": "hospital admission"}, "confidence": 0.9}, {"type": "RiskFactor", "id": "prior-inpatient-admissions", "mention": "admitted to the hospital several times in the past year", "span": {"start": 116, "end": 171}, "properties": {"name": "prior inpatient admissions", "description": "several hospital admissions in the past year"}, "confidence": 0.9}, {"type": "ClinicalOutcome", "id": "hospital-readmission", "mention": "readmitted after discharge", "span": {"start": 194, "end": 220}, "properties": {"name": "hospital readmission"}, "confidence": 0.9}], "relations": [{"type": "INCREASES_RISK_OF", "source": {"type": "Condition", "id": "hypoglycemia"}, "target": {"type": "ClinicalOutcome", "id": "hospital-admission"}, "evidence": "Hypoglycemia, or low blood sugar, can lead to falls, emergency visits and hospital admissions.", "span": {"start": 0, "end": 94}, "confidence": 0.9}, {"type": "INCREASES_RISK_OF", "source": {"type": "RiskFactor", "id": "prior-inpatient-admissions"}, "target": {"type": "ClinicalOutcome", "id": "hospital-readmission"}, "evidence": "People who have been admitted to the hospital several times in the past year are more likely to be readmitted after discharge.", "span": {"start": 95, "end": 221}, "confidence": 0.92}]}</expectedOutput>
      </fewShotExamples>
    </promptTemplate>
    <chunkingStrategy chunkSize="4000" overlap="300" splitter="PARAGRAPH"/>
  </extractionTasks>

  <extractionTasks name="literature_extraction" llmModel="gemini/gemini-3.5-flash-lite" temperature="0.1" maxTokens="4096"
      sourceCollection="corpus/pubmed corpus/papers"
      description="Extract risk factors, protective factors, conditions, drugs and lab levels associated with hospital readmission from PubMed abstracts and the Strack et al. 2014 study.">
    <promptTemplate name="literature_extraction_prompt" outputFormat="JSON"
        targetConcepts="kg-schema.xmi#RiskFactor kg-schema.xmi#Condition kg-schema.xmi#LabTest kg-schema.xmi#ClinicalOutcome kg-schema.xmi#Drug"
        targetRelations="kg-schema.xmi#INCREASES_RISK_OF_Condition kg-schema.xmi#INCREASES_RISK_OF_RiskFactor kg-schema.xmi#INCREASES_RISK_OF_Drug kg-schema.xmi#REDUCES_RISK_OF_RiskFactor kg-schema.xmi#REDUCES_RISK_OF_Drug kg-schema.xmi#INDICATES kg-schema.xmi#MAY_CAUSE">
      <systemInstruction>You are a careful biomedical knowledge extraction engine working on scientific abstracts about hospital readmission of patients with diabetes. You output only associations the abstract itself reports, in the exact JSON format requested. Report the direction of an association faithfully (INCREASES_RISK_OF vs REDUCES_RISK_OF). You never add knowledge that is not in the text.</systemInstruction>
      <fewShotExamples name="literature_hba1c">
        <inputText>In a retrospective analysis of 69,984 inpatient encounters of patients with diabetes, measurement of HbA1c during the admission was associated with a lower rate of readmission within 30 days, particularly when the primary diagnosis was diabetes. Patients with a higher number of prior inpatient visits had higher readmission rates.</inputText>
        <expectedOutput>{"entities": [{"type": "Condition", "id": "diabetes", "mention": "diabetes", "span": {"start": 76, "end": 84}, "properties": {"name": "diabetes", "category": "metabolic"}, "confidence": 0.95}, {"type": "RiskFactor", "id": "hba1c-measured-during-admission", "mention": "measurement of HbA1c during the admission", "span": {"start": 86, "end": 127}, "properties": {"name": "HbA1c measured during admission", "description": "HbA1c test performed during the hospital stay"}, "confidence": 0.92}, {"type": "ClinicalOutcome", "id": "hospital-readmission-within-30-days", "mention": "readmission within 30 days", "span": {"start": 164, "end": 190}, "properties": {"name": "hospital readmission within 30 days", "timeWindow": "30 days"}, "confidence": 0.96}, {"type": "RiskFactor", "id": "prior-inpatient-visits", "mention": "higher number of prior inpatient visits", "span": {"start": 262, "end": 301}, "properties": {"name": "prior inpatient admissions", "description": "number of inpatient visits in the preceding year"}, "confidence": 0.9}], "relations": [{"type": "REDUCES_RISK_OF", "source": {"type": "RiskFactor", "id": "hba1c-measured-during-admission"}, "target": {"type": "ClinicalOutcome", "id": "hospital-readmission-within-30-days"}, "evidence": "In a retrospective analysis of 69,984 inpatient encounters of patients with diabetes, measurement of HbA1c during the admission was associated with a lower rate of readmission within 30 days, particularly when the primary diagnosis was diabetes.", "span": {"start": 0, "end": 245}, "confidence": 0.9}, {"type": "INCREASES_RISK_OF", "source": {"type": "RiskFactor", "id": "prior-inpatient-visits"}, "target": {"type": "ClinicalOutcome", "id": "hospital-readmission-within-30-days"}, "evidence": "Patients with a higher number of prior inpatient visits had higher readmission rates.", "span": {"start": 246, "end": 331}, "confidence": 0.9}]}</expectedOutput>
      </fewShotExamples>
      <fewShotExamples name="literature_insulin">
        <inputText>Insulin therapy during hospitalization was associated with an increased risk of hypoglycemia, and hypoglycemic events were independently associated with 30-day readmission. Discharge to a skilled nursing facility was also a significant predictor of readmission.</inputText>
        <expectedOutput>{"entities": [{"type": "Drug", "id": "insulin", "mention": "Insulin", "span": {"start": 0, "end": 7}, "properties": {"name": "insulin", "drugClass": "insulin"}, "confidence": 0.97}, {"type": "Condition", "id": "hypoglycemia", "mention": "hypoglycemia", "span": {"start": 80, "end": 92}, "properties": {"name": "hypoglycemia", "category": "metabolic"}, "confidence": 0.96}, {"type": "ClinicalOutcome", "id": "hospital-readmission-within-30-days", "mention": "30-day readmission", "span": {"start": 153, "end": 171}, "properties": {"name": "hospital readmission within 30 days", "timeWindow": "30 days"}, "confidence": 0.95}, {"type": "RiskFactor", "id": "discharge-to-skilled-nursing-facility", "mention": "Discharge to a skilled nursing facility", "span": {"start": 173, "end": 212}, "properties": {"name": "discharge to a skilled nursing facility", "description": "patient discharged to a skilled nursing facility"}, "confidence": 0.9}], "relations": [{"type": "MAY_CAUSE", "source": {"type": "Drug", "id": "insulin"}, "target": {"type": "Condition", "id": "hypoglycemia"}, "evidence": "Insulin therapy during hospitalization was associated with an increased risk of hypoglycemia, and hypoglycemic events were independently associated with 30-day readmission.", "span": {"start": 0, "end": 172}, "confidence": 0.88}, {"type": "INCREASES_RISK_OF", "source": {"type": "Condition", "id": "hypoglycemia"}, "target": {"type": "ClinicalOutcome", "id": "hospital-readmission-within-30-days"}, "evidence": "Insulin therapy during hospitalization was associated with an increased risk of hypoglycemia, and hypoglycemic events were independently associated with 30-day readmission.", "span": {"start": 0, "end": 172}, "confidence": 0.9}, {"type": "INCREASES_RISK_OF", "source": {"type": "RiskFactor", "id": "discharge-to-skilled-nursing-facility"}, "target": {"type": "ClinicalOutcome", "id": "hospital-readmission-within-30-days"}, "evidence": "Discharge to a skilled nursing facility was also a significant predictor of readmission.", "span": {"start": 173, "end": 261}, "confidence": 0.9}]}</expectedOutput>
      </fewShotExamples>
    </promptTemplate>
    <chunkingStrategy chunkSize="3000" overlap="200" splitter="SENTENCE"/>
  </extractionTasks>

  <extractionTasks name="guideline_extraction" llmModel="gemini/gemini-3.5-flash-lite" temperature="0.1" maxTokens="4096"
      sourceCollection="corpus/pubmed/guidelines"
      description="Extract guideline recommendations for inpatient diabetes management and hospital discharge (practice guidelines, consensus statements, standards of care): the recommendation, the conditions it applies to, and the medicines, tests or care processes it recommends.">
    <promptTemplate name="guideline_extraction_prompt" outputFormat="JSON"
        targetConcepts="kg-schema.xmi#Recommendation kg-schema.xmi#Condition kg-schema.xmi#Drug kg-schema.xmi#LabTest kg-schema.xmi#RiskFactor"
        targetRelations="kg-schema.xmi#APPLIES_TO kg-schema.xmi#RECOMMENDS_Drug kg-schema.xmi#RECOMMENDS_LabTest kg-schema.xmi#RECOMMENDS_RiskFactor">
      <systemInstruction>You are a careful clinical knowledge extraction engine working on abstracts of practice guidelines, consensus statements and reviews of recommendations for the care of hospitalized patients with diabetes and their discharge. Extract each recommendation the text states, as one Recommendation with a one-sentence statement close to the source wording, link it to the conditions it applies to, and to the medicines, laboratory tests or care processes it recommends. Use lowercase generic drug names and lowercase condition names. You output only recommendations explicitly stated in the given text, in the exact JSON format requested, and never add knowledge that is not in the text.</systemInstruction>
      <fewShotExamples name="guideline_inpatient">
        <inputText>For hospitalized patients with diabetes, we recommend measuring HbA1c on admission if no result from the previous 3 months is available. Scheduled basal insulin is recommended for most patients with persistent hyperglycemia, and sliding-scale insulin alone should be avoided. Patients with heart failure and diabetes should continue or start an SGLT2 inhibitor when clinically stable.</inputText>
        <expectedOutput>{"entities": [{"type": "Recommendation", "id": "measure-hba1c-on-admission", "mention": "we recommend measuring HbA1c on admission if no result from the previous 3 months is available", "span": {"start": 41, "end": 135}, "properties": {"statement": "measure HbA1c on admission in hospitalized patients with diabetes if no result from the previous 3 months is available", "source": "inpatient diabetes guideline", "strength": "recommended"}, "confidence": 0.93}, {"type": "Condition", "id": "diabetes", "mention": "diabetes", "span": {"start": 31, "end": 39}, "properties": {"name": "diabetes", "category": "metabolic"}, "confidence": 0.96}, {"type": "RiskFactor", "id": "hba1c-measured-during-admission", "mention": "measuring HbA1c on admission", "span": {"start": 54, "end": 82}, "properties": {"name": "HbA1c measured during admission", "description": "HbA1c test performed at hospital admission"}, "confidence": 0.9}, {"type": "Recommendation", "id": "scheduled-basal-insulin", "mention": "Scheduled basal insulin is recommended for most patients with persistent hyperglycemia", "span": {"start": 137, "end": 223}, "properties": {"statement": "use scheduled basal insulin rather than sliding-scale insulin alone for persistent inpatient hyperglycemia", "source": "inpatient diabetes guideline", "strength": "recommended"}, "confidence": 0.92}, {"type": "Condition", "id": "hyperglycemia", "mention": "hyperglycemia", "span": {"start": 210, "end": 223}, "properties": {"name": "hyperglycemia", "category": "metabolic"}, "confidence": 0.95}, {"type": "Drug", "id": "insulin", "mention": "basal insulin", "span": {"start": 147, "end": 160}, "properties": {"name": "insulin", "drugClass": "insulin"}, "confidence": 0.92}, {"type": "Recommendation", "id": "sglt2i-in-heart-failure", "mention": "Patients with heart failure and diabetes should continue or start an SGLT2 inhibitor when clinically stable", "span": {"start": 276, "end": 383}, "properties": {"statement": "continue or start an SGLT2 inhibitor in clinically stable patients with heart failure and diabetes", "source": "inpatient diabetes guideline"}, "confidence": 0.9}, {"type": "Condition", "id": "heart-failure", "mention": "heart failure", "span": {"start": 290, "end": 303}, "properties": {"name": "heart failure", "category": "circulatory"}, "confidence": 0.96}, {"type": "Drug", "id": "sglt2-inhibitor", "mention": "SGLT2 inhibitor", "span": {"start": 345, "end": 360}, "properties": {"name": "sglt2 inhibitors", "drugClass": "sodium-glucose cotransporter-2 inhibitors"}, "confidence": 0.9}], "relations": [{"type": "APPLIES_TO", "source": {"type": "Recommendation", "id": "measure-hba1c-on-admission"}, "target": {"type": "Condition", "id": "diabetes"}, "evidence": "For hospitalized patients with diabetes, we recommend measuring HbA1c on admission if no result from the previous 3 months is available.", "span": {"start": 0, "end": 136}, "confidence": 0.92}, {"type": "RECOMMENDS", "source": {"type": "Recommendation", "id": "measure-hba1c-on-admission"}, "target": {"type": "RiskFactor", "id": "hba1c-measured-during-admission"}, "evidence": "For hospitalized patients with diabetes, we recommend measuring HbA1c on admission if no result from the previous 3 months is available.", "span": {"start": 0, "end": 136}, "confidence": 0.9}, {"type": "APPLIES_TO", "source": {"type": "Recommendation", "id": "scheduled-basal-insulin"}, "target": {"type": "Condition", "id": "hyperglycemia"}, "evidence": "Scheduled basal insulin is recommended for most patients with persistent hyperglycemia, and sliding-scale insulin alone should be avoided.", "span": {"start": 137, "end": 275}, "confidence": 0.9}, {"type": "RECOMMENDS", "source": {"type": "Recommendation", "id": "scheduled-basal-insulin"}, "target": {"type": "Drug", "id": "insulin"}, "evidence": "Scheduled basal insulin is recommended for most patients with persistent hyperglycemia, and sliding-scale insulin alone should be avoided.", "span": {"start": 137, "end": 275}, "confidence": 0.9}, {"type": "APPLIES_TO", "source": {"type": "Recommendation", "id": "sglt2i-in-heart-failure"}, "target": {"type": "Condition", "id": "heart-failure"}, "evidence": "Patients with heart failure and diabetes should continue or start an SGLT2 inhibitor when clinically stable.", "span": {"start": 276, "end": 384}, "confidence": 0.9}, {"type": "APPLIES_TO", "source": {"type": "Recommendation", "id": "sglt2i-in-heart-failure"}, "target": {"type": "Condition", "id": "diabetes"}, "evidence": "Patients with heart failure and diabetes should continue or start an SGLT2 inhibitor when clinically stable.", "span": {"start": 276, "end": 384}, "confidence": 0.88}, {"type": "RECOMMENDS", "source": {"type": "Recommendation", "id": "sglt2i-in-heart-failure"}, "target": {"type": "Drug", "id": "sglt2-inhibitor"}, "evidence": "Patients with heart failure and diabetes should continue or start an SGLT2 inhibitor when clinically stable.", "span": {"start": 276, "end": 384}, "confidence": 0.9}]}</expectedOutput>
      </fewShotExamples>
      <fewShotExamples name="guideline_discharge">
        <inputText>Discharge planning should begin at admission. Before discharge, medication reconciliation should be performed and patients with diabetes should receive diabetes self-management education. A follow-up visit within 1 to 2 weeks after discharge is recommended for patients with diabetes whose glucose-lowering treatment was changed.</inputText>
