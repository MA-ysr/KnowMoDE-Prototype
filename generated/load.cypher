 ,{s: 'insulin', t: 'alcohol', fact: 'f_39fcc9297bc53c42', doc: 'openfda/insulin.txt', start: 24716, end: 25065, evidence: 'Alcohol, Beta-blockers, Clonidine, and Lithium Salts Prevention or Management Monitor blood glucose more frequently and modify AFREZZA dosage, as clinically indicated, when used concomitantly with these drugs. Mechanism and Clinical Effect(s) Concomitant use with AFREZZA may either increase or decrease the blood glucose lowering effect of AFREZZA.', confidence: 0.9, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:11:57+00:00'}
 ,{s: 'insulin', t: 'clonidine', fact: 'f_63b270164f4d3cea', doc: 'openfda/insulin.txt', start: 24716, end: 25065, evidence: 'Alcohol, Beta-blockers, Clonidine, and Lithium Salts Prevention or Management Monitor blood glucose more frequently and modify AFREZZA dosage, as clinically indicated, when used concomitantly with these drugs. Mechanism and Clinical Effect(s) Concomitant use with AFREZZA may either increase or decrease the blood glucose lowering effect of AFREZZA.', confidence: 0.9, run: 'drug_label_extraction@fc3d922aa277', runId: 'drug_label_extraction@fc3d922aa277@gemini/gemini-3.5-flash-lite', hash: 'fc3d922aa27751cd23bc5136339e3e9669ebbfd16084612234d8ae7245fceda4', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:11:57+00:00'}
