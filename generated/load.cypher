 ,{s: 'anticoagulation therapy', t: 'readmission within 30 and 90 days', fact: 'f_d92acbfc38dc2993', doc: 'pubmed/40935344.txt', start: 945, end: 1340, evidence: 'Significant predictors included hypertension (odds ratio (OR) 1.3, P < 0.001), diabetes (OR 1.5, P < 0.001), heart disease (OR 2.0, P < 0.001), obesity (OR 1.2, P = 0.006), morbid obesity (OR 1.4, P = 0.007), chronic obstructive pulmonary disease (COPD) (OR 1.9, P < 0.001), anemia (OR 1.5, P = 0.003), chronic kidney disease (OR 1.3, P = 0.047), and anticoagulation therapy (OR 1.8, P < 0.001).', confidence: 1.0, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:47:35+00:00'}
 ,{s: 'higher baseline concentrations of gdf-15', t: 'mace or all-cause mortality', fact: 'f_60b8b954bb5ab179', doc: 'pubmed/41495100.txt', start: 1606, end: 2045, evidence: 'Among the 299 hospitalized AECOPD patients included in this sub-study of the randomized controlled trial CORTICOsteroid reduction in COPD (CORTICO-COP), higher baseline concentrations of GDF-15 were associated with an increased risk of the combined outcome of MACE or all-cause mortality (hazard ratio [HR] 1.68, 95% confidence interval [CI] 1.16-2.44, p = 0.007), as well as all-cause mortality alone (HR 1.5, 95% CI 1.07-2.19, p = 0.02).', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:48:11+00:00'}
 ,{s: 'higher baseline concentrations of gdf-15', t: 'mortality', fact: 'f_fff3b59383ce43d9', doc: 'pubmed/41495100.txt', start: 1606, end: 2045, evidence: 'Among the 299 hospitalized AECOPD patients included in this sub-study of the randomized controlled trial CORTICOsteroid reduction in COPD (CORTICO-COP), higher baseline concentrations of GDF-15 were associated with an increased risk of the combined outcome of MACE or all-cause mortality (hazard ratio [HR] 1.68, 95% confidence interval [CI] 1.16-2.44, p = 0.007), as well as all-cause mortality alone (HR 1.5, 95% CI 1.07-2.19, p = 0.02).', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:48:11+00:00'}
