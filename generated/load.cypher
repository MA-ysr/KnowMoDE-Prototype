 ,{s: 'recurrent diabetic ketoacidosis', t: 'mortality within one year', fact: 'f_7bac2ffebc6f26e6', doc: 'pubmed/34509792.txt', start: 1065, end: 1197, evidence: 'Recurrent DKA was a significant predictor of one-year mortality in cox regression analysis (HR 0.172; 95% CI 0.04-0.742; p = 0.018).', confidence: 0.8, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:42:47+00:00'}
 ,{s: 'enrollment as an inpatient', t: 'first heart failure hospitalization or all-cause death', fact: 'f_2566532d5cf65c9e', doc: 'pubmed/34666509.txt', start: 1403, end: 1613, evidence: 'In HF with preserved EF, consistent independent predictors of these clinical end points included enrollment as an inpatient, Southeast Asian location, and comorbid chronic kidney disease or atrial fibrillation.', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:43:20+00:00'}
 ,{s: 'southeast asian location', t: 'first heart failure hospitalization or all-cause death', fact: 'f_8a2bab28fb226b7d', doc: 'pubmed/34666509.txt', start: 1403, end: 1613, evidence: 'In HF with preserved EF, consistent independent predictors of these clinical end points included enrollment as an inpatient, Southeast Asian location, and comorbid chronic kidney disease or atrial fibrillation.', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:43:20+00:00'}
 ,{s: 'smoking', t: 'first heart failure hospitalization or all-cause death', fact: 'f_bc1b3ff1c159c04f', doc: 'pubmed/34666509.txt', start: 1614, end: 1872, evidence: 'The same variables were predictive of outcomes in HF with reduced EF except atrial fibrillation, and also included Northeast Asian location, older age, elevated heart rate, decreased systolic blood pressure, diabetes, smoking, and non-usage of beta blockers.', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:43:20+00:00'}
 ,{s: 'black race', t: 'hospital readmission within 30 days', fact: 'f_24aebf9168915318', doc: 'pubmed/34789421.txt', start: 1743, end: 2014, evidence: 'Independent predictors of readmissions included Roux-en-Y gastric bypass (RYGB) (odds ratio [OR] = 1.97, p < .001), Black (OR = 1.46, P < .001) and Hispanic race (OR = 1.14, P < .001), GERD (OR = 1.27, P < .001), HTN (OR = 1.08, P = .003), and IDDM (OR = 1.39, P < .001).', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:43:50+00:00'}
 ,{s: 'hispanic race', t: 'hospital readmission within 30 days', fact: 'f_7425d4b3477aecb2', doc: 'pubmed/34789421.txt', start: 1743, end: 2014, evidence: 'Independent predictors of readmissions included Roux-en-Y gastric bypass (RYGB) (odds ratio [OR] = 1.97, p < .001), Black (OR = 1.46, P < .001) and Hispanic race (OR = 1.14, P < .001), GERD (OR = 1.27, P < .001), HTN (OR = 1.08, P = .003), and IDDM (OR = 1.39, P < .001).', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:43:50+00:00'}
 ,{s: 'roux-en-y gastric bypass', t: 'hospital readmission within 30 days', fact: 'f_df732d256637bc97', doc: 'pubmed/34789421.txt', start: 1743, end: 2014, evidence: 'Independent predictors of readmissions included Roux-en-Y gastric bypass (RYGB) (odds ratio [OR] = 1.97, p < .001), Black (OR = 1.46, P < .001) and Hispanic race (OR = 1.14, P < .001), GERD (OR = 1.27, P < .001), HTN (OR = 1.08, P = .003), and IDDM (OR = 1.39, P < .001).', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:43:50+00:00'}
 ,{s: 'medicaid coverage', t: 'hospital readmission within 30 days', fact: 'f_1d1f85b417871dd4', doc: 'pubmed/34920181.txt', start: 2723, end: 3025, evidence: 'Medicaid coverage at the time of delivery was a significant predictor of being readmitted (adjusted odds ratio, 1.86; 95% confidence interval, 1.75-1.97) and uninsured at the time of readmission (adjusted odds ratio, 3.99; 95% confidence interval, 2.88-5.52) when compared with being privately insured.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:44:07+00:00'}
 ,{s: 'elevated preoperative hba1c', t: 'hospital readmission within 30 days', fact: 'f_0dae5e36bb90b48e', doc: 'pubmed/34942340.txt', start: 1537, end: 1828, evidence: 'Multivariable logistic regression (adjusting for patient, hospital, comorbidity and procedural characteristics) revealed that elevated HbA1c was significantly associated with 30-day readmission (OR = 1.06, 95% confidence interval = 1.00-1.12), but was not associated with the other outcomes.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:44:30+00:00'}
 ,{s: 'homa-ir >= 2.5', t: 'combined event of death and readmission', fact: 'f_46cad9b9efe8421f', doc: 'pubmed/35007641.txt', start: 706, end: 799, evidence: 'HOMA IR ≥2.5 was associated with combined event (OR 2.4; 95% CI 1.9-5.1; P: 0.02) at 90 days.', confidence: 0.92, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:44:40+00:00'}
 ,{s: 'obstructive sleep apnea', t: 'hospital readmission within 30 days', fact: 'f_74d3df04b37e9e46', doc: 'pubmed/35115319.txt', start: 1599, end: 1677, evidence: 'Obstructive sleep apnea was the only factor that influenced early readmission.', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:44:52+00:00'}
 ,{s: 'complications', t: 'hospital readmission within 30 days', fact: 'f_1b1b51f3eb6c5183', doc: 'pubmed/35879569.txt', start: 1511, end: 1666, evidence: 'Outcomes associated with regret after ventral hernia repair included complications (OR 2.33, 95% CI 1.26-4.29) and readmission (OR 2.67, 95% CI 1.51-4.71).', confidence: 0.8, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:46:25+00:00'}
 ,{s: 'higher admission glucose levels', t: 'mortality', fact: 'f_c575c802bf54e904', doc: 'pubmed/35882487.txt', start: 794, end: 979, evidence: 'Mortality at 90 days and 1 year increased with higher admission glucose levels (p=0.03 and p=0.005, respectively), severe hyperglycaemia (>20 mmol/L) having a 1-year mortality of 34.3%.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:46:37+00:00'}
 ,{s: 'more comorbidities', t: 'hospital readmission within 30 days', fact: 'f_54f404b56279f3f2', doc: 'pubmed/35947866.txt', start: 711, end: 852, evidence: 'Patients with more comorbidities, who were Hispanics, and those who received an endocrinology consultation were more likely to be readmitted.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:46:51+00:00'}
