 ,{key: 'avoid sliding-scale insulin regimens as they are not effective and lack a basal insulin component', idValue: 'avoid sliding-scale insulin regimens as they are not effective and lack a basal insulin component', props: {statement: 'avoid sliding-scale insulin regimens as they are not effective and lack a basal insulin component', source: 'Current medical research and opinion'}, doc: 'pubmed/20078323.txt', run: 'guideline_extraction@9a20634981a4@gemini/gemini-3.5-flash-lite', prompt: 'guideline_extraction@9a20634981a4', mention: 'Sliding-scale insulin (SSI) regimens are not effective and should not be used, especially as this excludes a basal insulin component from the therapy', start: 2555, end: 2704, confidence: 0.92, task: 'guideline_extraction', normalizedFrom: null, modifiable: false, plainLabel: null}
