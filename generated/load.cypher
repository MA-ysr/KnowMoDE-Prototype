 ,{s: 'american society of anesthesiologists >2', t: 'nonhome discharge', fact: 'f_2485bcc7fcb5e649', doc: 'pubmed/30763752.txt', start: 1214, end: 1540, evidence: 'Patients with PCDF had an increased likelihood of nonhome discharge if they had a dependent functional status (odds ratio [OR], 2.99; 95% confidence interval [CI], 2.33-3.82; P < 0.001), diabetes (OR, 1.32; 95% CI, 1.13-1.55; P = 0.0007), and an American Society of Anesthesiologists >2 (OR, 1.75; 95% CI, 1.5-2.05; P < 0.001)', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:34:38+00:00'}
 ,{s: 'older age', t: 'nonhome discharge', fact: 'f_11c8c7280c0f80eb', doc: 'pubmed/30763752.txt', start: 1214, end: 1612, evidence: 'Patients with PCDF had an increased likelihood of nonhome discharge if they had a dependent functional status (odds ratio [OR], 2.99; 95% confidence interval [CI], 2.33-3.82; P < 0.001), diabetes (OR, 1.32; 95% CI, 1.13-1.55; P = 0.0007), and an American Society of Anesthesiologists >2 (OR, 1.75; 95% CI, 1.5-2.05; P < 0.001), as well as if they were older (OR, 1.06; 95% CI, 1.05-1.06; P < 0.001)', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:34:38+00:00'}
 ,{s: 'female sex', t: 'nonhome discharge', fact: 'f_6a719f6b48a10a8c', doc: 'pubmed/30763752.txt', start: 1214, end: 1665, evidence: 'Patients with PCDF had an increased likelihood of nonhome discharge if they had a dependent functional status (odds ratio [OR], 2.99; 95% confidence interval [CI], 2.33-3.82; P < 0.001), diabetes (OR, 1.32; 95% CI, 1.13-1.55; P = 0.0007), and an American Society of Anesthesiologists >2 (OR, 1.75; 95% CI, 1.5-2.05; P < 0.001), as well as if they were older (OR, 1.06; 95% CI, 1.05-1.06; P < 0.001) and female (OR, 1.31; 95% CI, 1.14-1.5; P = 0.0002).', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:34:38+00:00'}
 ,{s: 'discharge to a skilled nursing facility', t: 'hospital readmission within 30 days', fact: 'f_9affcafa9d4a4417', doc: 'pubmed/30846065.txt', start: 1253, end: 1664, evidence: 'Significant predictors associated with increased 30-day readmission included diabetes (OR, 1.07; 95% CI, 1.06-1.08; P < .001), chronic kidney disease (1.12;1.10-1.14, P < .001), congestive heart failure (OR, 1.16; 95% CI, 1.14-1.18; P < .001), discharge to short-/long-term facility (OR, 1.13; 95% CI, 1.11-1.14; P < .001), Charlson comorbidity index ≥ 2, and length of stay ≥ 3 days during the index admission.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:34:53+00:00'}
 ,{s: 'postoperative complications', t: 'hospital readmission within 30 days', fact: 'f_96f025ea427eea63', doc: 'pubmed/31023550.txt', start: 903, end: 1150, evidence: 'Patients with postoperative complications were readmitted significantly more often within 30 days (p = 0.01) and 90 days posttransplant (p < 0.0003) and had a significantly longer hospital stay (p = 0.004) and intensive care unit stay (p = 0.001).', confidence: 0.92, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:35:10+00:00'}
 ,{s: 'postoperative complications', t: 'hospital readmission within 90 days', fact: 'f_7897c736c709a6c3', doc: 'pubmed/31023550.txt', start: 903, end: 1150, evidence: 'Patients with postoperative complications were readmitted significantly more often within 30 days (p = 0.01) and 90 days posttransplant (p < 0.0003) and had a significantly longer hospital stay (p = 0.004) and intensive care unit stay (p = 0.001).', confidence: 0.92, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:35:10+00:00'}
