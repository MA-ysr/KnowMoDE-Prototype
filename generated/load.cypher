 ,{s: 'pregestational diabetes', t: 'hospital readmission within 60 days', fact: 'f_3219f33290c75157', doc: 'pubmed/31809421.txt', start: 2153, end: 2286, evidence: 'Although overall risk for readmission is low, pregnancies complicated by pregestational diabetes in particular are at increased risk.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:37:07+00:00'}
