 ,{s: 'initiation of glucose-lowering medication', t: 'hospital readmission within 30 days', fact: 'f_bd869d7ef4ba3907', doc: 'pubmed/36807850.txt', start: 1265, end: 1366, evidence: 'The IPW-HRs for readmission were 0.95 [95% CI (0.93-0.96)] for 1 NHA, 0.89 [95% CI (0.86-0.91)] for 2', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.5-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.5-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T12:50:35+00:00'}
 ,{s: 'remote patient monitoring', t: 'hospital readmission within 30 days', fact: 'f_94b4d7fb32b146a5', doc: 'pubmed/37682280.txt', start: 1346, end: 1494, evidence: 'There was a decline in hospital admissions of 65%, 85% for observations and related inpatient services for enrolled CVD patients in the RPM program.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:41:44+00:00'}
 ,{s: 'longer enrollment duration', t: 'hospital readmission within 30 days', fact: 'f_1d00ccceae676e50', doc: 'pubmed/37682280.txt', start: 1495, end: 1581, evidence: 'In addition, the longer the patient was enrolled the less likely they were to readmit.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:41:44+00:00'}
 ,{s: 'continuous glucose monitoring', t: 'hospital readmission within 30 days', fact: 'f_9ac92bcff53e2a3d', doc: 'pubmed/37784246.txt', start: 389, end: 606, evidence: 'Given their capacity to aid individuals in avoiding hypo- and hyperglycemia, they may also be useful when transitioning from hospital to home by reducing rates of hospital readmissions and emergency department visits.', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:42:13+00:00'}
 ,{s: 'continuous glucose monitoring', t: 'emergency department visits', fact: 'f_8565b6d28be00d3a', doc: 'pubmed/37784246.txt', start: 389, end: 606, evidence: 'Given their capacity to aid individuals in avoiding hypo- and hyperglycemia, they may also be useful when transitioning from hospital to home by reducing rates of hospital readmissions and emergency department visits.', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:42:13+00:00'}
 ,{s: 'insulin pump therapy', t: 'hospital readmission within 30 days', fact: 'f_dafb7fef4aea35b7', doc: 'pubmed/38365207.txt', start: 1585, end: 1892, evidence: 'Temporary use of insulin pump therapy for perioperative patients with diabetes results in a reduction in blood glucose and blood glucose fluctuation during hospitalization, HbA1c, and the risk of postoperative complication and readmission, thus significantly decreasing costs in this complex patient cohort.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:43:37+00:00'}
 ,{s: 'community paramedicine program', t: 'stroke mortality', fact: 'f_31894e4db752ee19', doc: 'pubmed/38870358.txt', start: 1593, end: 1711, evidence: 'Multivariable analysis suggested a reduction in stroke mortality rates among the intervention groups in both counties.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:44:13+00:00'}
 ,{s: 'transitional care program', t: 'hospital readmission within 30 days', fact: 'f_41c3e1f387aed471', doc: 'pubmed/38872270.txt', start: 1705, end: 1858, evidence: 'The model of the health care transfer applied in this research thus significantly reduced hospital readmissions in the 1-year period in elderly patients.', confidence: 0.98, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:44:21+00:00'}
 ,{s: 'at-risk medicare advantage payment arrangement', t: 'hospital readmission within 30 days', fact: 'f_7741921755d746d2', doc: 'pubmed/39847351.txt', start: 1546, end: 1714, evidence: 'For at-risk MA compared with FFS MA, inpatient admissions and 30-day readmissions per 1000 were 10.03 (95% CI, -10.61 to -9.44) and 1.95 (95% CI, -2.18 to -1.73) lower.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:45:42+00:00'}
 ,{s: 'at-risk medicare advantage payment arrangement', t: 'inpatient admissions', fact: 'f_bccbf3c206a1de52', doc: 'pubmed/39847351.txt', start: 1546, end: 1714, evidence: 'For at-risk MA compared with FFS MA, inpatient admissions and 30-day readmissions per 1000 were 10.03 (95% CI, -10.61 to -9.44) and 1.95 (95% CI, -2.18 to -1.73) lower.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:45:42+00:00'}
 ,{s: 'at-risk medicare advantage payment arrangement', t: 'avoidable emergency department visits', fact: 'f_ce05309ab2b085d9', doc: 'pubmed/39847351.txt', start: 1715, end: 1876, evidence: 'ED use measures per 1000 ranged from 2.95 (95% CI, -3.28 to -2.63) lower for avoidable ED visits to 26.02 (95% CI, -26.92 to -25.12) lower for overall ED visits.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:45:42+00:00'}
 ,{s: 'at-risk medicare advantage payment arrangement', t: 'overall emergency department visits', fact: 'f_0a03a122b55092b2', doc: 'pubmed/39847351.txt', start: 1715, end: 1876, evidence: 'ED use measures per 1000 ranged from 2.95 (95% CI, -3.28 to -2.63) lower for avoidable ED visits to 26.02 (95% CI, -26.92 to -25.12) lower for overall ED visits.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:45:42+00:00'}
 ,{s: 'at-risk medicare advantage payment arrangement', t: 'composite diabetes-related admissions', fact: 'f_80eab031ec4ef90d', doc: 'pubmed/39847351.txt', start: 1877, end: 2112, evidence: 'Avoidance of disease-specific admissions per 1000 ranged from 0.24 (95% CI, -0.35 to -0.13) lower for composite diabetes-related admissions to 2.18 (95% CI, -2.43 to -1.94) lower for the composite of chronic disease-related admissions.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:45:42+00:00'}
 ,{s: 'diabetes education', t: 'hospital readmission within 30 days', fact: 'f_b3b2b0d1f99c45cd', doc: 'pubmed/40403266.txt', start: 1431, end: 1640, evidence: 'The odds of 30-day readmission were significantly lower for patients who received diabetes self-management education, had higher glomerular filtration rates, or were admitted with a diagnosis of bone fracture.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:46:08+00:00'}
 ,{s: 'higher glomerular filtration rates', t: 'hospital readmission within 30 days', fact: 'f_5954973f6e2110c5', doc: 'pubmed/40403266.txt', start: 1431, end: 1640, evidence: 'The odds of 30-day readmission were significantly lower for patients who received diabetes self-management education, had higher glomerular filtration rates, or were admitted with a diagnosis of bone fracture.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:46:08+00:00'}
 ,{s: 'diagnosis of bone fracture', t: 'hospital readmission within 30 days', fact: 'f_191be0720936d94d', doc: 'pubmed/40403266.txt', start: 1431, end: 1640, evidence: 'The odds of 30-day readmission were significantly lower for patients who received diabetes self-management education, had higher glomerular filtration rates, or were admitted with a diagnosis of bone fracture.', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:46:08+00:00'}
 ,{s: 'transitional care program', t: 'unplanned hospital admission rates within 365 days', fact: 'f_3f54c573799fdbb5', doc: 'pubmed/40470624.txt', start: 3910, end: 4163, evidence: 'However, community care navigation likely results in a reduction in unplanned hospital admission rates within 12 months (365 days) compared to usual care (RR 0.87, 95% CI 0.77 to 0.97; P = 0.01; 3 studies, 795 participants; moderate-certainty evidence).', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:46:40+00:00'}
 ,{s: 'transitional care program', t: 'hospital admission rates', fact: 'f_88429e52ee0a6ba0', doc: 'pubmed/40470624.txt', start: 5561, end: 5847, evidence: 'Community care navigation for people at risk of unplanned hospital presentations is likely to reduce hospital admission rates within 12 months (365 days) and increase outpatient appointments within one month (30 days) compared to usual care, with moderate to high certainty of evidence.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:46:40+00:00'}
 ,{s: 'hba1c measured during admission', t: 'hospital readmission within 30 days', fact: 'f_aa6e59f11147da00', doc: 'papers/strack2014.txt', start: 797, end: 1030, evidence: 'Multivariable logistic regression was used to fit the relationship between the measurement of HbA1c and early readmission while controlling for covariates such as demographics, severity and type of the disease, and type of admission.', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:49:51+00:00'}
 ,{s: 'hba1c measured during admission', t: 'hospital readmission within 30 days', fact: 'f_dc9ccf244ac8f09e', doc: 'papers/strack2014.txt', start: 2895, end: 3028, evidence: 'We hypothesize that measurement of HbA1c is associated with a reduction in readmission rates in individuals admitted to the hospital.', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:49:51+00:00'}
 ,{s: 'hba1c measured during admission', t: 'hospital readmission within 30 days', fact: 'f_e1a807a80031afb1', doc: 'papers/strack2014.txt', start: 14301, end: 14498, evidence: 'With respect to readmission and taken as a whole without adjusting for covariates, measurement of HbA1c was associated with a significantly reduced rate of readmission (9.4 versus 8.7%, P = 0.007).', confidence: 0.95, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:49:51+00:00'}
 ,{s: 'hba1c measured during admission', t: 'hospital readmission within 30 days', fact: 'f_8b69ae62ecff4999', doc: 'papers/strack2014.txt', start: 19223, end: 19546, evidence: 'With respect to readmission rate, our data suggest that, regardless of the result, simply measuring HbA1c is associated with a lower rate of readmission in individuals with a primary diagnosis of diabetes mellitus, whereas those with the frequently observed primary diagnoses of circulatory or respiratory diseases are not.', confidence: 0.9, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:49:51+00:00'}
 ,{s: 'hba1c measured during admission', t: 'hospital readmission within 30 days', fact: 'f_4afe61f9123d4cbb', doc: 'papers/strack2014.txt', start: 21101, end: 21388, evidence: 'In conclusion, the decision to obtain a measurement of HbA1c for patients with diabetes mellitus is a useful predictor of readmission rates which may prove valuable in the development of strategies to reduce readmission rates and costs for the care of individuals with diabetes mellitus.', confidence: 0.85, run: 'literature_extraction@9b00038fb5d2', runId: 'literature_extraction@9b00038fb5d2@gemini/gemini-3.1-flash-lite', hash: '9b00038fb5d29957f1a4c7b2ee263124e8e3f36ea91607373a2d87988fc5b5cb', llm: 'gemini/gemini-3.1-flash-lite', policy: 'f20cdba4b6a0133d1db0677e5c18d6c31c2c50e396d718c04900094dffbe3b6a', ts: '2026-10-15T14:49:51+00:00'}
] AS r
